+bool NativeAdrenoVm::prefillPhysical(uint64_t *physical) const
+{
+    if(!physical || !attached_ || poisoned_)return false;
+    for(size_t i=0;i<NativeAdrenoVmMaxObjects;++i) {
+        const Mapping &m=mappings_[i];
+        if(!m.memory || !(m.permissions&ArmSmmu4KWrite) || m.memory->bytes()<(1u<<20) || !m.memory->spanCount())continue;
+        uint32_t v=0;
+        const uint64_t pa=m.memory->spans()[0].physical;
+        if(NativeAdrenoReadPhysicalWord(pa,&v) && v==0xa5a5a5a5u) {*physical=pa;return true;}
+    }
+    return false;
+}
