+void NativeAdrenoVm::probeIova(uint64_t iova,uint32_t rem) const
+{
+    if(!attached_)return;
+    const Mapping *below=nullptr,*above=nullptr;
+    for(size_t i=0;i<NativeAdrenoVmMaxObjects;++i) {
+        const Mapping &m=mappings_[i];
+        if(!m.memory)continue;
+        const uint64_t bytes=m.memory->bytes();
+        if(iova>=m.iova && iova-m.iova<bytes) {
+            const uint64_t offset=iova-m.iova;
+            uint32_t w[8]={};unsigned have=0;
+            if(const volatile uint32_t *cpu=static_cast<const volatile uint32_t *>(m.memory->mapping()))
+                for(;have<8 && (offset+4*(have+1))<=bytes;++have)w[have]=cpu[offset/4+have];
+            IOLog("NativeAdrenoVm: IB probe iova 0x%llx rem 0x%x: slot %lu BO iova 0x%llx bytes 0x%llx perms %u imported %d offset 0x%llx; first %u dwords %08x %08x %08x %08x %08x %08x %08x %08x\n",
+                (unsigned long long)iova,rem,(unsigned long)i,(unsigned long long)m.iova,(unsigned long long)bytes,m.permissions,(int)m.memory->imported(),
+                (unsigned long long)offset,have,w[0],w[1],w[2],w[3],w[4],w[5],w[6],w[7]);
+            return;
+        }
+        if(m.iova<=iova && (!below || m.iova>below->iova))below=&m;
+        if(m.iova>iova && (!above || m.iova<above->iova))above=&m;
+    }
+    IOLog("NativeAdrenoVm: IB probe iova 0x%llx rem 0x%x: NOT MAPPED in this context; nearest below 0x%llx+0x%llx, nearest above 0x%llx\n",
+        (unsigned long long)iova,rem,(unsigned long long)(below?below->iova:0),(unsigned long long)(below?below->memory->bytes():0),
+        (unsigned long long)(above?above->iova:0));
+}
