+bool NativeAdrenoRing::readIb1(uint64_t *base,uint32_t *rem)
+{
+    uint32_t lo=0,hi=0,left=0;
+    if(!attached_ || io_.read32(io_.cookie,0x0928,&lo) || io_.read32(io_.cookie,0x0929,&hi) || io_.read32(io_.cookie,0x092a,&left))return false;
+    if(base)*base=((uint64_t)hi<<32)|lo;
+    if(rem)*rem=left;
+    return true;
+}
