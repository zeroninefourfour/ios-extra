+extern "C" IOReturn NativeAdrenoGpuScratchRead(uint32_t offset,uint32_t *value)
+{
+    if(!live_scratch || !value)return kIOReturnNotReady;
+    for(size_t j=0;j<live_scratch->spanCount();++j) {
+        const NativeAdrenoPhysicalSpan &span=live_scratch->spans()[j];
+        if(offset<span.offset || (size_t)offset-span.offset+4>span.bytes)continue;
+        return NativeAdrenoReadPhysicalWord(span.physical+((size_t)offset-span.offset),value)?kIOReturnSuccess:kIOReturnIOError;
+    }
+    return kIOReturnBadArgument;
 }
