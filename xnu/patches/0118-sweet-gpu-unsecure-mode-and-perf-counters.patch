+bool NativeAdrenoRing::readPerfCounters(uint32_t *rb2d,uint32_t *rb3d,uint32_t *ccu2d,uint32_t *ccuColor)
+{
+    uint32_t r2=0,r3=0,c2=0,cc=0;
+    if(!attached_ || io_.read32(io_.cookie,0x04d6,&r2) || io_.read32(io_.cookie,0x04d8,&r3) ||
+        io_.read32(io_.cookie,0x045c,&c2) || io_.read32(io_.cookie,0x045e,&cc))return false;
+    if(rb2d)*rb2d=r2;
+    if(rb3d)*rb3d=r3;
+    if(ccu2d)*ccu2d=c2;
+    if(ccuColor)*ccuColor=cc;
+    return true;
+}
