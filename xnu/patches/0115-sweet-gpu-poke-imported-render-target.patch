+/* NEXT AGENT (0115, diagnostic, remove once the black screen is explained). pull14 showed that no GPU render/blit output reaches the imported
+ * surfaces' DRAM (a CPU prefill survives every clear), while the kernel's own CP_MEM_WRITE smoke test works on the kernel's scratch BO. This
+ * separates the two failure classes: after a job completes, the CP itself writes a pattern into page n (1..3) of the first imported, writable
+ * BO >= 1 MiB of this VM through the same iova/SMMU mapping the render target is written through; the page is cleaned first and cleaned+
+ * invalidated afterwards (publishForDevice / acquireDeviceWrites), then read through the physical alias. Log line "poke #n".
+ *   pattern read back => iova, SMMU mapping, pa and cache handling are right: the loss is in the RB/2D/CCU/UCHE write-out of the 3D pipe.
+ *   old value read back => the CP's write through this mapping goes elsewhere or is lost (mapping / cache attributes / permission).
+ * Three pokes per boot; they overwrite 4 bytes at offset n*0x1000 of the surface (a few pixels in the first rows). */
+void NativeAdrenoSubmit::pokeImported(const NativeAdrenoRingClock *clock)
+{
+    static unsigned done;
+    if(done>=3 || !clock)return;
+    uint64_t base=0;
+    NativeAdrenoMemory *memory=vm_->firstLargeWritableImport(&base);
+    if(!memory)return;
+    const unsigned n=++done;
+    const size_t offset=(size_t)0x1000*n;
+    const uint32_t pattern=0xc0de0000u+n;
+    const uint64_t target=base+offset;
+    uint64_t physical=0;
+    for(size_t j=0;j<memory->spanCount();++j) {
+        const auto &span=memory->spans()[j];
+        if(offset>=span.offset && offset-span.offset<span.bytes) {physical=span.physical+(offset-span.offset);break;}
+    }
+    const IOReturn published=memory->publishForDevice(offset,4096,true);
+    uint32_t before=~0u,after=~0u;
+    const bool haveBefore=NativeAdrenoReadPhysicalWord(physical,&before);
+    uint32_t pm4[4];
+    AdrenoPM4Type7(0x3d,3,&pm4[0]);
+    pm4[1]=(uint32_t)target;pm4[2]=(uint32_t)(target>>32);pm4[3]=pattern;
+    uint32_t fence=0;
+    const IOReturn submitted=ring_->submit(pm4,4,&fence);
+    const NativeAdrenoRingFence waited=submitted==kIOReturnSuccess?ring_->wait(fence,clock,200000,nullptr):NativeAdrenoRingFenceArgument;
+    const IOReturn acquired=memory->acquireDeviceWrites(offset,4096);
+    const bool haveAfter=NativeAdrenoReadPhysicalWord(physical,&after);
+    IOLog("NativeAdrenoSubmit: poke #%u iova 0x%llx pa 0x%llx: before %08x%s, wrote %08x, after %08x%s -> %s (publish 0x%x submit 0x%x fence %u wait %d acquire 0x%x)\n",
+        n,(unsigned long long)target,(unsigned long long)physical,(unsigned)before,haveBefore?"":"?",(unsigned)pattern,(unsigned)after,haveAfter?"":"?",
+        after==pattern?"PATTERN LANDED":"PATTERN NOT SEEN",(unsigned)published,(unsigned)submitted,fence,(int)waited,(unsigned)acquired);
+}
