+NativeAdrenoMemory *NativeAdrenoVm::firstLargeWritableImport(uint64_t *iova) const
+{
+    if(!attached_ || poisoned_ || !iova)return nullptr;
+    for(size_t i=0;i<NativeAdrenoVmMaxObjects;++i) {
+        const Mapping &m=mappings_[i];
+        if(m.memory && m.memory->imported() && (m.permissions&ArmSmmu4KWrite) && m.memory->bytes()>=(1u<<20)) {*iova=m.iova;return m.memory;}
+    }
+    return nullptr;
+}
