+/*
+ * The native GPU driver names, by the property NativeSandboxGrantProcess on its accelerator service, the processes
+ * to which it grants its own user client in place of the sandbox's verdict: the original profiles name no class of that driver.
+ * Supports comma-separated process names, wildcard '*', and the boolean property NativeSandboxGrant.
+ */
+extern "C" void proc_selfname(char * buf, int size);
+static bool
+native_sandbox_grant(IOService * service)
+{
+	if (!service) {
+		return false;
+	}
+	if (service->getProperty("NativeSandboxGrant") == kOSBooleanTrue) {
+		return true;
+	}
+	OSString * process = OSDynamicCast(OSString, service->getProperty("NativeSandboxGrantProcess"));
+	if (!process) {
+		return false;
+	}
+	const char *list = process->getCStringNoCopy();
+	if (!list || !list[0]) {
+		return false;
+	}
+	if (strcmp(list, "*") == 0) {
+		return true;
+	}
+	char name[32] = {};
+	proc_selfname(name, sizeof(name));
+	if (!name[0]) {
+		return false;
+	}
+	size_t namelen = strlen(name);
+	const char *p = list;
+	while (*p) {
+		while (*p == ',' || *p == ' ') p++;
+		if (!*p) break;
+		const char *end = strchr(p, ',');
+		size_t tokenlen = end ? (size_t)(end - p) : strlen(p);
+		while (tokenlen > 0 && p[tokenlen - 1] == ' ') tokenlen--;
+		if ((tokenlen == 1 && *p == '*') ||
+		    (tokenlen == namelen && strncmp(p, name, namelen) == 0)) {
+			return true;
+		}
+		if (!end) break;
+		p = end + 1;
+	}
+	return false;
+}
