+struct native_z_mem {
+	uint32_t alloc_size;
+	uint8_t  data[0];
+};
+
+static void *
+native_z_alloc(void *notused __unused, u_int num_items, u_int size)
+{
+	uint64_t total = (uint64_t)num_items * (uint64_t)size;
+	uint32_t allocSize = (uint32_t)(total + sizeof(struct native_z_mem));
+	struct native_z_mem *zmem = (struct native_z_mem *)kalloc_data(allocSize, Z_WAITOK | Z_ZERO);
+	if (!zmem) {
+		return NULL;
+	}
+	zmem->alloc_size = allocSize;
+	return zmem->data;
+}
+
+static void
+native_z_free(void *notused __unused, void *ptr)
+{
+	if (!ptr) {
+		return;
+	}
+	struct native_z_mem *zmem = (struct native_z_mem *)((uintptr_t)ptr - sizeof(struct native_z_mem));
+	kfree_data(zmem, zmem->alloc_size);
+}
+
+struct ustar_hdr {
+	char name[100];
+	char mode[8];
+	char uid[8];
+	char gid[8];
+	char size[12];
+	char mtime[12];
+	char chksum[8];
+	char typeflag;
+	char linkname[100];
+	char magic[6];
+	char version[2];
+	char uname[32];
+	char gname[32];
+	char devmajor[8];
+	char devminor[8];
+	char prefix[155];
+};
+
+static uint64_t
+native_parse_octal(const char *p, size_t len)
+{
+	uint64_t val = 0;
+	while (len > 0 && (*p == ' ' || *p == '\0')) {
+		p++;
+		len--;
+	}
+	while (len > 0 && *p >= '0' && *p <= '7') {
+		val = (val << 3) | (*p - '0');
+		p++;
+		len--;
+	}
+	return val;
+}
+
+static int
+native_mkdir_one(proc_t p, user_addr_t scratch, const char *path, int mode)
+{
+	int error;
+	int32_t retval = 0;
+	size_t len = strlen(path) + 1;
+	if (len > 512) {
+		return ENAMETOOLONG;
+	}
+	if ((error = copyout(path, scratch, len))) {
+		return error;
+	}
+	struct mkdir_args uap = {
+		.path = scratch,
+		.mode = mode
+	};
+	extern int mkdir(proc_t p, struct mkdir_args *uap, int32_t *retval);
+	error = mkdir(p, &uap, &retval);
+	if (error == EEXIST) {
+		error = 0;
+	}
+	return error;
+}
+
+static int
+native_mkdir_p(proc_t p, user_addr_t scratch, const char *path, int mode)
+{
+	char tmp[512];
+	size_t len = strlen(path);
+	if (len >= sizeof(tmp)) {
+		return ENAMETOOLONG;
+	}
+	strlcpy(tmp, path, sizeof(tmp));
+
+	for (char *slash = tmp + 1; *slash; slash++) {
+		if (*slash == '/') {
+			*slash = '\0';
+			native_mkdir_one(p, scratch, tmp, mode);
+			*slash = '/';
+		}
+	}
+	return native_mkdir_one(p, scratch, tmp, mode);
+}
+
+static int
+native_write_file(proc_t p, const char *path, const void *data, size_t size, int mode, int uid, int gid)
+{
+	vnode_t vp = NULLVP;
+	vfs_context_t ctx = vfs_context_kernel();
+	int error = vnode_open(path, (O_CREAT | O_TRUNC | FWRITE), mode, 0, &vp, ctx);
+	if (error) {
+		printf("SWEET: native_write_file: vnode_open failed for %s: %d\n", path, error);
+		return error;
+	}
+	if (size > 0 && data != NULL) {
+		int resid = 0;
+		error = vn_rdwr(UIO_WRITE, vp, (caddr_t)data, (int)size, 0, UIO_SYSSPACE, IO_SYNC, kauth_cred_get(), &resid, p);
+		if (error) {
+			printf("SWEET: native_write_file: vn_rdwr failed for %s: %d\n", path, error);
+		}
+	}
+	if (uid != 0 || gid != 0) {
+		struct vnode_attr va;
+		VATTR_INIT(&va);
+		VATTR_SET(&va, va_uid, uid);
+		VATTR_SET(&va, va_gid, gid);
+		(void)vnode_setattr(vp, &va, ctx);
+	}
+	vnode_close(vp, FWRITE, ctx);
+	return error;
+}
+
+static void
+native_gpu_addon_extract_if_needed(proc_t p, user_addr_t scratch)
+{
+	vnode_t probe = NULLVP;
+	int error = vnode_lookup("/private/var/ngpu/addons/NativeAdrenoMetal.bundle/NativeAdrenoMetal", 0, &probe, vfs_context_current());
+	const bool present = (error == 0);
+	if (present) {
+		vnode_put(probe);
+	}
+
+	/* The RAMDisk tar is the source of truth: a copy left on disk by an earlier boot used to make this function return here, so every
+	 * rebuilt addon (new NativeAdrenoMetal, new CDHash in the trust cache) was ignored and the old binary kept running (observed:
+	 * 2026-10-29, log "unexpected _MTLDevice ABI" without the new "(instance size" suffix). With a payload the files are rewritten
+	 * every boot; without one the copy on disk is used as before. */
+	printf("SWEET: native_gpu_addon: %s on disk, checking memory RAMDisk for payload...\n", present ? "present" : "/private/var/ngpu not found");
+	extern int mdevgetrange(int devid, uint64_t *base, uint64_t *size);
+	uint64_t ram_base = 0, ram_size = 0;
+	if (mdevgetrange(0, &ram_base, &ram_size) != 0 || ram_base == 0 || ram_size < 512) {
+		printf("SWEET: native_gpu_addon: RAMDisk not available (base=0x%llx, size=%llu)%s\n", ram_base, ram_size,
+		    present ? ", keeping the copy on disk" : "");
+		return;
+	}
+
+	const uint8_t *tar_ptr = (const uint8_t *)ram_base;
+	vm_offset_t decomp_buf = 0;
+	vm_size_t decomp_max = 64 * 1024 * 1024;
+
+	if (ram_size >= 2 && tar_ptr[0] == 0x1f && tar_ptr[1] == 0x8b) {
+		printf("SWEET: native_gpu_addon: detected gzip payload (%llu bytes), decompressing...\n", ram_size);
+		if (kmem_alloc(kernel_map, &decomp_buf, decomp_max, KMA_DATA, VM_KERN_MEMORY_FILE) == KERN_SUCCESS) {
+			z_stream zs;
+			bzero(&zs, sizeof(zs));
+			zs.next_in = (Bytef *)tar_ptr;
+			zs.avail_in = (uInt)ram_size;
+			zs.next_out = (Bytef *)decomp_buf;
+			zs.avail_out = (uInt)decomp_max;
+			zs.zalloc = native_z_alloc;
+			zs.zfree = native_z_free;
+
+			if (inflateInit2(&zs, 16 + MAX_WBITS) == Z_OK) {
+				int zerr = inflate(&zs, Z_FINISH);
+				inflateEnd(&zs);
+				if (zerr == Z_STREAM_END || zerr == Z_OK) {
+					printf("SWEET: native_gpu_addon: decompressed %u gzip bytes -> %lu tar bytes\n",
+					    (uInt)zs.total_in, (uLong)zs.total_out);
+					tar_ptr = (const uint8_t *)decomp_buf;
+					ram_size = zs.total_out;
+				} else {
+					printf("SWEET: native_gpu_addon: inflate failed: %d\n", zerr);
+				}
+			} else {
+				printf("SWEET: native_gpu_addon: inflateInit2 failed\n");
+			}
+		} else {
+			printf("SWEET: native_gpu_addon: kmem_alloc failed for %lu bytes\n", (uLong)decomp_max);
+		}
+	}
+
+	uint64_t offset = 0;
+	int file_count = 0;
+	uint64_t total_bytes = 0;
+
+	printf("SWEET: native_gpu_addon: unpacking tar from RAM at 0x%llx (%llu bytes)...\n", ram_base, ram_size);
+
+	while (offset + 512 <= ram_size) {
+		const struct ustar_hdr *hdr = (const struct ustar_hdr *)(tar_ptr + offset);
+		if (hdr->name[0] == '\0') {
+			break;
+		}
+
+		char target_path[512] = {};
+		if (hdr->prefix[0] != '\0') {
+			snprintf(target_path, sizeof(target_path), "/private/var/%.155s/%.100s", hdr->prefix, hdr->name);
+		} else if (strncmp(hdr->name, "./", 2) == 0) {
+			snprintf(target_path, sizeof(target_path), "/private/var/%s", hdr->name + 2);
+		} else if (hdr->name[0] == '/') {
+			snprintf(target_path, sizeof(target_path), "%s", hdr->name);
+		} else {
+			snprintf(target_path, sizeof(target_path), "/private/var/%s", hdr->name);
+		}
+
+		size_t plen = strlen(target_path);
+		if (plen > 1 && target_path[plen - 1] == '/') {
+			target_path[plen - 1] = '\0';
+		}
+
+		uint64_t file_size = native_parse_octal(hdr->size, sizeof(hdr->size));
+		int mode = (int)native_parse_octal(hdr->mode, sizeof(hdr->mode));
+		int uid = (int)native_parse_octal(hdr->uid, sizeof(hdr->uid));
+		int gid = (int)native_parse_octal(hdr->gid, sizeof(hdr->gid));
+		char type = hdr->typeflag;
+
+		offset += 512;
+
+		if (type == '5' || (type == '\0' && hdr->name[strlen(hdr->name) - 1] == '/')) {
+			native_mkdir_p(p, scratch, target_path, mode ? mode : 0755);
+		} else if (type == '0' || type == '\0') {
+			char parent_buf[512];
+			strlcpy(parent_buf, target_path, sizeof(parent_buf));
+			char *last_slash = strrchr(parent_buf, '/');
+			if (last_slash && last_slash != parent_buf) {
+				*last_slash = '\0';
+				native_mkdir_p(p, scratch, parent_buf, 0755);
+			}
+
+			if (offset + file_size <= ram_size) {
+				const void *file_data = (const void *)(tar_ptr + offset);
+				native_write_file(p, target_path, file_data, (size_t)file_size, mode ? mode : 0644, uid, gid);
+				file_count++;
+				total_bytes += file_size;
+			}
+			offset += (file_size + 511) & ~511ULL;
+		} else {
+			offset += (file_size + 511) & ~511ULL;
+		}
+	}
+
+	if (decomp_buf) {
+		kmem_free(kernel_map, decomp_buf, decomp_max);
+	}
+
+	printf("SWEET: native_gpu_addon: successfully auto-extracted %d files (%llu bytes) to /private/var!\n",
+	    file_count, total_bytes);
+}
+
+static void
+native_gpu_addon_mount(proc_t p, user_addr_t scratch, user_addr_t offset, const char *source, size_t source_size,
+    const char *point, size_t point_size, const char *visible, const char *own, volatile int *stage, volatile int *status)
+{
+	vnode_t probe = NULLVP;
+	int error;
+	*stage = 1;
+	error = vnode_lookup(source, 0, &probe, vfs_context_current());
+	if (error) {
+		*status = error;
+		return;
+	}
+	vnode_put(probe);
+	probe = NULLVP;
+	*stage = 2;
+	struct mount_args request = {.type = scratch + offset, .path = scratch + offset + 0x20,
+	    .flags = MNT_RDONLY | MNT_UNION, .data = scratch + offset + 0x100};
+	int32_t result = 0;
+	if ((error = copyout("bindfs", request.type, 7)) || (error = copyout(point, request.path, point_size)) ||
+	    (error = copyout(source, request.data, source_size))) {
+		*status = error;
+		return;
+	}
+	native_bindfs_boot_mount = 1;
+	extern int mount(proc_t p, struct mount_args *uap, int32_t *retval);
+	error = mount(p, &request, &result);
+	native_bindfs_boot_mount = 0;
+	if (error) {
+		*status = error;
+		return;
+	}
+	*stage = 3;
+	/* The union must still show a lower entry next to the owner's. */
+	error = vnode_lookup(visible, 0, &probe, vfs_context_current());
+	if (!error) {
+		vnode_put(probe);
+		probe = NULLVP;
+		*stage = 4;
+		/* ... and the owner's own entry must be visible through it (stage 5). */
+		error = vnode_lookup(own, 0, &probe, vfs_context_current());
+		if (!error) {
+			vnode_put(probe);
+			probe = NULLVP;
+			*stage = 5;
+		}
+	}
+	*status = error;
+}
+
+static void
+native_gpu_addon_prepare(proc_t p, user_addr_t scratch)
+{
+	uint32_t enabled = 0;
+	if ((!PE_parse_boot_argn("sheng-gpu-addon", &enabled, sizeof(enabled)) || enabled != 1) &&
+	    (!PE_parse_boot_argn("sweet-gpu-addon", &enabled, sizeof(enabled)) || enabled != 1)) {
+		return;
+	}
+	printf("SWEET: native_gpu_addon_prepare: starting GPU addon auto-provision and union mount...\n");
+
+	native_gpu_addon_extract_if_needed(p, scratch);
+
+	static const char extensions_source[] = "/private/var/ngpu/addons", extensions_point[] = "/System/Library/Extensions";
+	static const char daemons_source[] = "/private/var/ngpu/daemons", daemons_point[] = "/System/Library/LaunchDaemons";
+	native_gpu_addon_mount(p, scratch, 0x400, extensions_source, sizeof(extensions_source), extensions_point,
+	    sizeof(extensions_point), "/System/Library/Extensions",
+	    "/System/Library/Extensions/NativeAdrenoMetal.bundle/Info.plist", &native_gpu_addon_stage,
+	    &native_gpu_addon_status);
+	native_gpu_addon_mount(p, scratch, 0x600, daemons_source, sizeof(daemons_source), daemons_point, sizeof(daemons_point),
+	    "/System/Library/LaunchDaemons/com.apple.backboardd.plist",
+	    "/System/Library/LaunchDaemons/org.blu-sharky.adrenoprobed.plist", &native_gpu_addon2_stage, &native_gpu_addon2_status);
+	printf("SWEET: native_gpu_addon_prepare: extensions stage=%d status=%d, daemons stage=%d status=%d\n",
+	    native_gpu_addon_stage, native_gpu_addon_status, native_gpu_addon2_stage, native_gpu_addon2_status);
+}
