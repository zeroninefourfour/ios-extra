+unsigned NativeAdrenoVm::nopCcuFlush(uint64_t iova,size_t bytes)
+{
+    if(!attached_ || poisoned_ || !bytes || (bytes&3) || (iova&3))return 0;
+    for(size_t i=0;i<NativeAdrenoVmMaxObjects;++i) {
+        const Mapping &m=mappings_[i];
+        if(!m.memory || !m.memory->mapping() || iova<m.iova || iova-m.iova>=m.memory->bytes())continue;
+        const size_t offset=(size_t)(iova-m.iova);
+        if(offset+bytes>m.memory->bytes())return 0;
+        volatile uint32_t *w=static_cast<volatile uint32_t *>(m.memory->mapping())+offset/4;
+        const size_t n=bytes/4;
+        unsigned hits=0;
+        for(size_t k=0;k+4<n;++k) {
+            if(w[k]!=0x70460004u || (w[k+1]!=0x1du && w[k+1]!=0x1cu))continue;
+            uint32_t header=0;
+            if(AdrenoPM4Type7(0x10,4,&header)!=AdrenoPM4Success)break;
+            w[k]=header;w[k+1]=w[k+2]=w[k+3]=w[k+4]=0;
+            ++hits;k+=4;
+        }
+        return hits;
+    }
+    return 0;
+}
