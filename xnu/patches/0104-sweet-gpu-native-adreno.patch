+IOService *NativeAdrenoGpuService::probe(IOService *provider,SInt32 *score)
+{
+    native_adreno_vm_now_us = vm_clock_us;
+    if (!advertisesAdreno(provider)) return nullptr;
+    if (score) *score = 1000;
+    return this;
+}
+
+bool NativeAdrenoGpuService::start(IOService *provider)
+{
+    if (!IOService::start(provider)) return false;
+
+    OSData *reg = OSDynamicCast(OSData,provider->getProperty("reg"));
+    OSData *address = OSDynamicCast(OSData,provider->getProperty("#address-cells"));
+    OSData *size = OSDynamicCast(OSData,provider->getProperty("#size-cells"));
+    NativeAdrenoWindow windows[NativeAdrenoMaxWindows]{};
+    size_t count = 0;
+    uint32_t address_cells = 2, size_cells = 2;
+    if (address && address->getLength() >= 4)
+        address_cells = *static_cast<const uint32_t *>(address->getBytesNoCopy());
+    if (size && size->getLength() >= 4)
+        size_cells = *static_cast<const uint32_t *>(size->getBytesNoCopy());
+    if (!reg || NativeAdrenoBoard::parseReg(
+        static_cast<const uint8_t *>(reg->getBytesNoCopy()), reg->getLength(),
+        address_cells, size_cells, windows, NativeAdrenoMaxWindows, &count) != kIOReturnSuccess) {
+        IOLog("NativeAdreno: provider reg windows are not usable\n");
+        IOService::stop(provider);
+        return false;
+    }
+    if (count < 2) {
+        IOLog("NativeAdreno: GPU node needs the register and CX windows\n");
+        IOService::stop(provider);
+        return false;
+    }
+
+    for (unsigned index = 0; index < 2; ++index) {
+        IODeviceMemory *memory = provider ? provider->getDeviceMemoryWithIndex(index) : nullptr;
+        if (!memory) memory = getDeviceMemoryWithIndex(index);
+        if (!memory) {
+            IOPhysicalAddress fallback_base = (index == 0) ? 0x05000000 : 0x05090000;
+            IOPhysicalLength fallback_size = (index == 0) ? 0x40000 : 0x9000;
+            memory = IODeviceMemory::withRange(fallback_base, fallback_size);
+        }
+        if (!memory) {
+            IOLog("NativeAdreno: provider window %u has no device memory\n", index);
+            stop(provider);
+            return false;
+        }
+        maps_[index] = OSSharedPtr<IOMemoryMap>(memory->map(kIOMapAnywhere | kIOMapInhibitCache), OSNoRetain);
+        if (!maps_[index]) {
+            IOLog("NativeAdreno: GPU window %u did not map\n", index);
+            stop(provider);
+            return false;
+        }
+    }
+    win0_bytes_ = static_cast<size_t>(windows[0].bytes);
+    IOLog("NativeAdreno: %lu windows, GPU window at 0x%llx/0x%llx, CX at 0x%llx/0x%llx mapped\n",
+        static_cast<unsigned long>(count),
+        static_cast<unsigned long long>(windows[0].base), static_cast<unsigned long long>(windows[0].bytes),
+        static_cast<unsigned long long>(windows[1].base), static_cast<unsigned long long>(windows[1].bytes));
+
+    /* Map GCC window (0x00100000, size 0x90000) for clock tree gating */
+    IODeviceMemory *gcc_mem = IODeviceMemory::withRange(0x00100000, 0x90000);
+    if (!gcc_mem) {
+        IOLog("NativeAdreno: GCC reservation failed\n");
+        stop(provider);
+        return false;
+    }
+    gcc_map_ = OSSharedPtr<IOMemoryMap>(gcc_mem->map(kIOMapAnywhere | kIOMapInhibitCache), OSNoRetain);
+    gcc_mem->release();
+    if (!gcc_map_) {
+        IOLog("NativeAdreno: GCC mapping failed\n");
+        stop(provider);
+        return false;
+    }
+
+    /* GMU and SMMU nubs are matched after this one (DT order), so the rest of the
+     * bring-up runs on its own thread once both services exist. */
+    thread_t thread = nullptr;
+    retain();
+    if (kernel_thread_start(NativeAdrenoGpuService::bringUpThread, this, &thread) != KERN_SUCCESS) {
+        release();
+        IOLog("NativeAdreno: could not start bring-up thread\n");
+        stop(provider);
+        return false;
+    }
+    thread_deallocate(thread);
+    return true;
+}
+
+void NativeAdrenoGpuService::bringUpThread(void *arg, wait_result_t)
+{
+    NativeAdrenoGpuService *self = static_cast<NativeAdrenoGpuService *>(arg);
+    bool found = false;
+    for (unsigned tries = 0; tries < 600 && !found; ++tries) {
+        OSDictionary *gm = IOService::serviceMatching("NativeAdrenoGmuService");
+        OSDictionary *sm = IOService::serviceMatching("NativeAdrenoSmmuService");
+        IOService *g = gm ? IOService::copyMatchingService(gm) : nullptr;
+        IOService *m = sm ? IOService::copyMatchingService(sm) : nullptr;
+        if (gm) gm->release();
+        if (sm) sm->release();
+        found = g && m;
+        if (g) g->release();
+        if (m) m->release();
+        if (!found) IOSleep(100);
+    }
+    if (!found) {
+        IOLog("NativeAdreno: GMU/SMMU services never appeared\n");
+    } else {
+        /* The persistent log thread starts after UFS comes up; bring-up must not run before it, or a reset leaves no trace. */
+        if (sweet_log_ready) {
+            for (unsigned tries = 0; tries < 600 && !sweet_log_ready(); ++tries) IOSleep(100);
+            IOSleep(500);
+        }
+        IOLog("NativeAdreno: GMU and SMMU services present, starting bring-up\n");
+        if (!self->bringUp()) IOLog("NativeAdreno: bring-up failed, AGXAccelerator not published\n");
+    }
+    self->release();
+    thread_terminate(current_thread());
+}
+
+void NativeAdrenoGpuService::teardown()
+{
+    if (accelerator_) {
+        accelerator_->terminate();
+        accelerator_->release();
+        accelerator_ = nullptr;
+    }
+    if (core_) { delete core_; core_ = nullptr; }
+    if (execbuf_) { delete execbuf_; execbuf_ = nullptr; }
+    if (gpu_ctx_) { delete gpu_ctx_; gpu_ctx_ = nullptr; }
+    /* A failed bring-up must not keep the BO pool: it is half of this machine's RAM. */
+    NativeAdrenoMemory::releasePool();
+    ready_ = false;
+    core_ready_ = false;
+}
+
+bool NativeAdrenoGpuService::bringUp()
+{
+    /* Locate NativeAdrenoGmuService */
+    OSDictionary *matching = IOService::serviceMatching("NativeAdrenoGmuService");
+    IOService *gmu_svc = matching ? IOService::copyMatchingService(matching) : nullptr;
+    if (matching) matching->release();
+    if (!gmu_svc) {
+        IOLog("NativeAdreno: NativeAdrenoGmuService not found\n");
+        teardown();
+        return false;
+    }
+    NativeAdrenoGmuService *gmu_node = OSDynamicCast(NativeAdrenoGmuService, gmu_svc);
+
+    /* Locate NativeAdrenoSmmuService */
+    OSDictionary *smmu_match = IOService::serviceMatching("NativeAdrenoSmmuService");
+    IOService *smmu_svc = smmu_match ? IOService::copyMatchingService(smmu_match) : nullptr;
+    if (smmu_match) smmu_match->release();
+    if (!smmu_svc) {
+        IOLog("NativeAdreno: NativeAdrenoSmmuService not found\n");
+        gmu_svc->release();
+        teardown();
+        return false;
+    }
+    NativeAdrenoSmmuService *smmu_node = OSDynamicCast(NativeAdrenoSmmuService, smmu_svc);
+    volatile uint8_t *smmu_base = smmu_node ? smmu_node->windowAddress(0) : nullptr;
+    size_t smmu_bytes = smmu_node ? static_cast<size_t>(smmu_node->windowBytes(0)) : 0;
+    if (!smmu_base || !smmu_bytes) {
+        IOLog("NativeAdreno: SMMU window not available\n");
+        smmu_svc->release();
+        gmu_svc->release();
+        teardown();
+        return false;
+    }
+
+    /* Pool size boot argument */
+    {
+        uint32_t mib = 64;   /* the kernel owns 1 GiB on this board; 512 MiB starved userland */
+        PE_parse_boot_argn("sheng-gpu-pool", &mib, sizeof(mib));
+        native_adreno_pool_mib = mib;
+    }
+
+    /* GMU buffer allocation (56 KiB = 14 contiguous pages) */
+    IOReturn gmu_alloc_ret = gmu_mem_.allocate(0xe000, 36, true, 0xe000);
+    if (gmu_alloc_ret != kIOReturnSuccess || !gmu_mem_.spanCount()) {
+        IOLog("NativeAdreno: failed to allocate GMU buffers (0x%x)\n", gmu_alloc_ret);
+        smmu_svc->release();
+        gmu_svc->release();
+        teardown();
+        return false;
+    }
+    uint64_t gmu_buf_pa = gmu_mem_.spans()[0].physical;
+    void *gmu_buf_kva = gmu_mem_.mapping();
+
+    volatile uint8_t *gcc_base = reinterpret_cast<volatile uint8_t *>(gcc_map_->getVirtualAddress());
+    volatile uint8_t *cx_base = reinterpret_cast<volatile uint8_t *>(maps_[1]->getVirtualAddress());
+
+    svc_step("gmu-cold-start");
+    /* Execute A618 Cold Start on GMU */
+    IOReturn gmu_start_ret = gmu_node->coldStartA618(gcc_base, cx_base, smmu_base, gmu_buf_pa, gmu_buf_kva);
+    if (gmu_start_ret != kIOReturnSuccess) {
+        IOLog("NativeAdreno: GMU cold start failed (0x%x)\n", gmu_start_ret);
+        smmu_svc->release();
+        gmu_svc->release();
+        teardown();
+        return false;
+    }
+
+    svc_step("gpu-smmu-context");
+    /* Bring up GPU Context Bank 0 for Stream 0 (gfx3d_user) via ArmSmmu4K */
+    svc_step("gpu-ctx-new");
+    gpu_ctx_ = new NativeAdrenoGpuContext();
+    svc_step("gpu-ctx-allocated");
+    if (!gpu_ctx_) {
+        IOLog("NativeAdreno: failed to allocate GPU context\n");
+        smmu_svc->release();
+        gmu_svc->release();
+        teardown();
+        return false;
+    }
+    NativeAdrenoSmmuWindow smmu_win{ smmu_base, smmu_bytes };
+    ArmSmmu4KIo smmu_io{ &smmu_win, smmu_bytes, smmu_read32, smmu_read64, smmu_write32, smmu_write64, smmu_barrier };
+    const unsigned gpu_slots[2] = { 0, 0 };
+    const uint16_t gpu_sids[2] = { 0, 0 };
+    NativeAdrenoGmuContextReport ctx_report{};
+    svc_step("gpu-ctx-bringup");
+    IOReturn ctx_ret = gpu_ctx_->bringUp(&smmu_io, 0, 1, gpu_slots, gpu_sids, nullptr, &ctx_report);
+    if (ctx_ret != kIOReturnSuccess || !gpu_ctx_->ready()) {
+        IOLog("NativeAdreno: GPU SMMU context bringUp failed (0x%x, step %u)\n", ctx_ret, ctx_report.step);
+        IOLog("NativeAdreno: DIAG ctx prog_status %u prog_phase %u prog_writes %u readback_valid %u enabled %u id1 0x%x route_status %u route_phase %u route_writes %u verified %u\n",
+            (unsigned)ctx_report.program_status, (unsigned)ctx_report.program_phase, (unsigned)ctx_report.program_writes,
+            (unsigned)ctx_report.program_readback_valid, (unsigned)ctx_report.program_enabled, (unsigned)ctx_report.id1,
+            (unsigned)ctx_report.route_status, (unsigned)ctx_report.route_phase, (unsigned)ctx_report.route_writes,
+            (unsigned)ctx_report.routes_verified);
+        auto rd = [&](size_t at) { uint32_t v = 0xdeadbeef; (void)smmu_read32(&smmu_win, at, &v); return (unsigned)v; };
+        IOLog("NativeAdreno: DIAG smmu sCR0 0x%x sGFSR 0x%x idr0 0x%x smr0 0x%x s2cr0 0x%x smr3 0x%x s2cr3 0x%x\n",
+            rd(0x00), rd(0x48), rd(0x20), rd(0x800), rd(0xc00), rd(0x80c), rd(0xc0c));
+        if (sweet_log_sync) sweet_log_sync();
+        smmu_svc->release();
+        gmu_svc->release();
+        teardown();
+        return false;
+    }
+    IOLog("NativeAdreno: GPU SMMU context ready (Bank 0, SID 0, TTBR0=0x%llx)\n",
+        static_cast<unsigned long long>(ctx_report.ttbr0));
+
+    svc_step("load-sqe");
+    /* Load SQE microcode */
+    if (reinterpret_cast<uintptr_t>(native_adreno_sqe_firmware_image) && native_adreno_sqe_firmware_image_size) {
+        const size_t copy_bytes = static_cast<size_t>(native_adreno_sqe_firmware_image_size);
+        memcpy(const_cast<NativeAdrenoMemory &>(gpu_ctx_->buffer(0)).mapping(),
+               native_adreno_sqe_firmware_image, copy_bytes);
+        const_cast<NativeAdrenoMemory &>(gpu_ctx_->buffer(0)).publishForDevice(0, GpuSqeBytes, false);
+        IOLog("NativeAdreno: SQE microcode published (%lu bytes at IOVA 0x%llx)\n",
+            static_cast<unsigned long>(copy_bytes), static_cast<unsigned long long>(GpuSqeIova));
+    }
+
+    svc_step("cp-register-init");
+    /* Initialize Adreno 618 CP hardware */
+    NativeAdrenoGpuWindow gpu_window = {
+        reinterpret_cast<volatile uint8_t *>(maps_[0]->getVirtualAddress()),
+        static_cast<size_t>(win0_bytes_)
+    };
+
+    /* 1. Clear GBIF halt */
+    gpu_write32(&gpu_window, A618_GBIF_HALT, 0);
+    gpu_write32(&gpu_window, A618_RBBM_GBIF_HALT, 0);
+    gpu_write32(&gpu_window, A618_RBBM_SECVID_TSB_CNTL, 0);
+    gpu_write32(&gpu_window, A618_RBBM_SECVID_TSB_TRUSTED_BASE, 0);
+    gpu_write32(&gpu_window, A618_RBBM_SECVID_TSB_TRUSTED_BASE + 1, 0);
+    gpu_write32(&gpu_window, A618_RBBM_SECVID_TSB_TRUSTED_SIZE, 0);
+
+    /* 2. Turn on 64-bit addressing on all blocks */
+    static const uint32_t addr_mode_regs[] = {
+        A618_CP_ADDR_MODE_CNTL, A618_VSC_ADDR_MODE_CNTL, A618_GRAS_ADDR_MODE_CNTL,
+        A618_RB_ADDR_MODE_CNTL, A618_PC_ADDR_MODE_CNTL, A618_HLSQ_ADDR_MODE_CNTL,
+        A618_VFD_ADDR_MODE_CNTL, A618_VPC_ADDR_MODE_CNTL, A618_UCHE_ADDR_MODE_CNTL,
+        A618_SP_ADDR_MODE_CNTL, A618_TPL1_ADDR_MODE_CNTL, A618_RBBM_SECVID_TSB_ADDR_MODE_CNTL
+    };
+    for (uint32_t reg_off : addr_mode_regs) {
+        gpu_write32(&gpu_window, reg_off, 1);
+    }
+
+    /* 3. Program HWCG clockgating table */
+    for (unsigned i = 0; i < NATIVE_ADRENO_A618_HWCG_COUNT; i++) {
+        gpu_write32(&gpu_window, NativeAdrenoA618Hwcg[i][0], NativeAdrenoA618Hwcg[i][1]);
+    }
+    gpu_write32(&gpu_window, A618_RBBM_CLOCK_CNTL, 0);
+
+    /* 4. Configure UCHE */
+    gpu_write32(&gpu_window, A618_UCHE_WRITE_RANGE_MAX, static_cast<uint32_t>(0x100000 + 0xfc0));
+    gpu_write32(&gpu_window, A618_UCHE_WRITE_RANGE_MAX + 1, 0);
+    gpu_write32(&gpu_window, A618_UCHE_TRAP_BASE, 0x100000);
+    gpu_write32(&gpu_window, A618_UCHE_TRAP_BASE + 1, 0);
+    gpu_write32(&gpu_window, A618_UCHE_WRITE_THRU_BASE, 0x100000);
+    gpu_write32(&gpu_window, A618_UCHE_WRITE_THRU_BASE + 1, 0);
+    gpu_write32(&gpu_window, A618_UCHE_GMEM_RANGE_MIN, 0x100000);
+    gpu_write32(&gpu_window, A618_UCHE_GMEM_RANGE_MIN + 1, 0);
+    gpu_write32(&gpu_window, A618_UCHE_GMEM_RANGE_MAX, static_cast<uint32_t>(0x100000 + A618_GMEM_SIZE - 1));
+    gpu_write32(&gpu_window, A618_UCHE_GMEM_RANGE_MAX + 1, 0);
+    gpu_write32(&gpu_window, A618_UCHE_FILTER_CNTL, 0x804);
+    gpu_write32(&gpu_window, A618_UCHE_CACHE_WAYS, 0x4);
+    gpu_write32(&gpu_window, A618_UCHE_CLIENT_PF, (1u << 7) | 1u);
+
+    /* 5. Configure CP thresholds, pool size, APRIV */
+    gpu_write32(&gpu_window, A618_CP_ROQ_THRESHOLDS_2, 0x010000c0);
+    gpu_write32(&gpu_window, A618_CP_ROQ_THRESHOLDS_1, 0x8040362c);
+    gpu_write32(&gpu_window, A618_CP_MEM_POOL_SIZE, 128);
+    gpu_write32(&gpu_window, A618_PC_DBG_ECO_CNTL, A618_PRIM_FIFO_THRESHOLD);
+    gpu_write32(&gpu_window, A618_CP_AHB_CNTL, 1);
+    gpu_write32(&gpu_window, A618_RBBM_PERFCTR_CNTL, 1);
+    gpu_write32(&gpu_window, A618_RBBM_PERFCTR_GPU_BUSY_MASKED, 0xffffffff);
+    gpu_write32(&gpu_window, A618_RBBM_INTERFACE_HANG_INT_CNTL, (1u << 30) | 0x1fffff);
+    gpu_write32(&gpu_window, A618_CP_APRIV_CNTL, (1u << 6) | (1u << 5) | (1u << 3) | (1u << 2) | (1u << 1));
+    gpu_write32(&gpu_window, A618_RBBM_INT_0_MASK, 0x00000020);
+
+    /* 6. Program CP Protect registers */
+    for (unsigned i = 0; i < NATIVE_ADRENO_A618_PROTECT_COUNT; i++) {
+        gpu_write32(&gpu_window, A618_CP_PROTECT + i, NativeAdrenoA618Protect[i][1]);
+    }
+    gpu_write32(&gpu_window, A618_CP_PROTECT_CNTL, 1);
+
+    /* 7. Configure CP Ring registers */
+    gpu_write32(&gpu_window, A618_CP_SQE_INSTR_BASE, static_cast<uint32_t>(GpuSqeIova));
+    gpu_write32(&gpu_window, A618_CP_SQE_INSTR_BASE + 1, static_cast<uint32_t>(GpuSqeIova >> 32));
+    gpu_write32(&gpu_window, A618_CP_RB_BASE, static_cast<uint32_t>(GpuRingIova));
+    gpu_write32(&gpu_window, A618_CP_RB_BASE + 1, static_cast<uint32_t>(GpuRingIova >> 32));
+    gpu_write32(&gpu_window, A618_CP_RB_CNTL, (1u << 11) | 13u); /* 32 KiB ring, BLKSZ 8 */
+    gpu_write32(&gpu_window, A618_CP_RB_RPTR_ADDR, static_cast<uint32_t>(GpuMemptrsIova));
+    gpu_write32(&gpu_window, A618_CP_RB_RPTR_ADDR + 1, static_cast<uint32_t>(GpuMemptrsIova >> 32));
+    gpu_write32(&gpu_window, A618_CP_RB_RPTR, 0);
+    gpu_write32(&gpu_window, A618_CP_RB_WPTR, 0);
+
+    svc_step("start-sqe");
+    /* 8. Start SQE microcode */
+    gpu_write32(&gpu_window, A618_CP_SQE_CNTL, 1);
+
+    /* Attach NativeAdrenoRing */
+    NativeAdrenoRingIo ring_io{ &gpu_window, gpu_write32, gpu_read32, gpu_barrier };
+    ring_cache_ = {
+        const_cast<NativeAdrenoMemory *>(&gpu_ctx_->buffer(1)),
+        const_cast<NativeAdrenoMemory *>(&gpu_ctx_->buffer(2))
+    };
+    NativeAdrenoRingCache ring_cache{ &ring_cache_, ring_publish, fence_acquire };
+    IOReturn ring_ret = ring_.attach(&ring_io, &ring_cache,
+        const_cast<NativeAdrenoMemory &>(gpu_ctx_->buffer(1)).mapping(), GpuRingBytes, GpuRingIova,
+        const_cast<NativeAdrenoMemory &>(gpu_ctx_->buffer(2)).mapping(), GpuPageBytes, GpuMemptrsIova);
+    if (ring_ret != kIOReturnSuccess) {
+        IOLog("NativeAdreno: ring attach failed (0x%x)\n", ring_ret);
+        smmu_svc->release();
+        gmu_svc->release();
+        teardown();
+        return false;
+    }
+
+    if (gpu_ctx_->buffer(2).spanCount()) {
+        native_adreno_fence_phys = gpu_ctx_->buffer(2).spans()[0].physical;
+    }
+
+    svc_step("cp-me-init");
+    /* 9. Run A6xx CP_ME_INIT */
+    NativeAdrenoCpInit cp;
+    uint32_t init_fence = 0;
+    IOReturn cp_ret = cp.runA6xx(&ring_io, &ring_, GpuSqeIova, &init_fence);
+    if (cp_ret != kIOReturnSuccess) {
+        IOLog("NativeAdreno: A6xx CP_ME_INIT submission failed (0x%x)\n", cp_ret);
+        smmu_svc->release();
+        gmu_svc->release();
+        teardown();
+        return false;
+    }
+    NativeAdrenoRingClock clock{ nullptr, ring_now, nullptr };
+    if (ring_.wait(init_fence, &clock, 2000, nullptr) != NativeAdrenoRingFenceComplete) {
+        IOLog("NativeAdreno: A6xx CP_ME_INIT fence %u timed out\n", init_fence);
+        smmu_svc->release();
+        gmu_svc->release();
+        teardown();
+        return false;
+    }
+    IOLog("NativeAdreno: A6xx CP_ME_INIT completed successfully (fence %u)\n", init_fence);
+
+    /* Switch out of secure mode */
+    gpu_write32(&gpu_window, A618_RBBM_SECVID_TRUST_CNTL, 0);
+
+    svc_step("smoke-test");
+    /* 10. Smoke Test: CP memory writeback */
+    volatile uint32_t *scratch = reinterpret_cast<volatile uint32_t *>(
+        const_cast<NativeAdrenoMemory &>(gpu_ctx_->buffer(4)).mapping());
+    scratch[0] = 0x00000000;
+    const_cast<NativeAdrenoMemory &>(gpu_ctx_->buffer(4)).publishForDevice(0, 4, false);
+
+    /* Submit PM4 CP_MEM_WRITE (opcode 0x3d, count 3) */
+    uint32_t smoke_pm4[4];
+    AdrenoPM4Type7(0x3d, 3, &smoke_pm4[0]);
+    smoke_pm4[1] = static_cast<uint32_t>(GpuScratchIova);
+    smoke_pm4[2] = static_cast<uint32_t>(GpuScratchIova >> 32);
+    smoke_pm4[3] = 0xad618001u;
+
+    uint32_t smoke_fence = 0;
+    IOReturn smoke_sub_ret = ring_.submit(smoke_pm4, 4, &smoke_fence);
+    if (smoke_sub_ret == kIOReturnSuccess &&
+        ring_.wait(smoke_fence, &clock, 2000, nullptr) == NativeAdrenoRingFenceComplete) {
+        const_cast<NativeAdrenoMemory &>(gpu_ctx_->buffer(4)).acquireDeviceWrites(0, 4);
+        uint32_t val = scratch[0];
+        if (val == 0xad618001u) {
+            IOLog("NativeAdreno: Adreno 618 CP MEMORY WRITEBACK SMOKE TEST PASSED! Pattern 0x%08x verified\n", val);
+        } else {
+            IOLog("NativeAdreno: smoke test scratch readback mismatch: 0x%08x (expected 0xad618001)\n", val);
+        }
+    } else {
+        IOLog("NativeAdreno: smoke test submission / fence wait failed\n");
+    }
+
+    /* Setup submit and core user clients */
+    execbuf_ = new NativeAdrenoSubmit;
+    core_ = new NativeAdrenoUserClient;
+    if (execbuf_ && core_ &&
+        execbuf_->attach(gpu_ctx_->vm(), &ring_) == kIOReturnSuccess &&
+        core_->open(NativeAdrenoAbiVersion, gpu_ctx_->vm(), execbuf_, &ring_, 32, 40) == kIOReturnSuccess) {
+        core_ready_ = true;
+    }
+
+    svc_step("publish-agx");
+    /* 11. Register AGXAccelerator into IORegistry with sandbox grant properties */
+    if (native_adreno_accelerator_allocate) {
+        accelerator_ = native_adreno_accelerator_allocate();
+        if (accelerator_) {
+            if (accelerator_->init()) {
+                accelerator_->setProperty("MetalPluginName", "NativeAdrenoMetal");
+                accelerator_->setProperty("MetalPluginClassName", "NativeAdrenoMetalDevice");
+                accelerator_->setProperty("NativeSandboxGrantProcess", "backboardd,adrenoprobed,SpringBoard,*");
+                accelerator_->setProperty("NativeSandboxGrant", kOSBooleanTrue);
+                if (accelerator_->attach(IOService::getPlatform())) {
+                    accelerator_->registerService();
+                    IOLog("NativeAdreno: AGXAccelerator published in IORegistry (MetalPluginName=NativeAdrenoMetal)\n");
+                }
+            }
+        }
+    }
+
+    /* 12. Publish NativeAdrenoGpu service */
+    NativeAdrenoAbiDeviceInfo dev_info{};
+    dev_info.chip_id = A618_CHIP_ID;
+    dev_info.gmem_bytes = A618_GMEM_SIZE;
+    dev_info.gmem_base = 0x100000;
+    dev_info.uche_trap_base = 0x100000;
+    dev_info.va_start = 0x20000000;
+    dev_info.va_size = 0x60000000;
+    dev_info.highest_bank_bit = 14;
+    dev_info.ubwc_swizzle = 6;
+    dev_info.macrotile_mode = 0;
+    dev_info.ubwc_version = 2;
+
+    native_adreno_publish(gpu_ctx_->vm(), execbuf_, &ring_, &clock, nullptr, &dev_info, 32, 40);
+
+    ready_ = true;
+    IOLog("NativeAdreno: GPU driver fully ready, publishing service\n");
+    registerService();
+
+    smmu_svc->release();
+    gmu_svc->release();
+    return true;
+}
+
+void NativeAdrenoGpuService::stop(IOService *provider)
+{
+    if (accelerator_) {
+        accelerator_->terminate();
+        accelerator_->release();
+        accelerator_ = nullptr;
+    }
+    if (core_) {
+        delete core_;
+        core_ = nullptr;
+    }
+    if (execbuf_) {
+        delete execbuf_;
+        execbuf_ = nullptr;
+    }
+    if (gpu_ctx_) {
+        delete gpu_ctx_;
+        gpu_ctx_ = nullptr;
+    }
+    gcc_map_.reset();
+    for (auto &map : maps_) map.reset();
+    ready_ = false;
+    core_ready_ = false;
+    IOService::stop(provider);
+}
+
+IOReturn NativeAdrenoGpuService::newUserClient(task_t owningTask, void *securityID,
+    UInt32 type, OSDictionary *properties, IOUserClient **handler)
+{
+    if (native_adreno_new_user_client) {
+        return native_adreno_new_user_client(this, owningTask, securityID, type, properties, handler, 40);
+    }
+    return kIOReturnUnsupported;
+}
diff --git a/iokit/Kernel/arm/adreno/NativeAdrenoSha256.cpp b/iokit/Kernel/arm/adreno/NativeAdrenoSha256.cpp
new file mode 100644
index 0000000..ecef8ad
--- /dev/null
+++ b/iokit/Kernel/arm/adreno/NativeAdrenoSha256.cpp
@@ -0,0 +1,63 @@
+/* SPDX-License-Identifier: MIT */
+#include "NativeAdrenoSha256.h"
+#include <string.h>
+
+static const uint32_t K[64]={
+    0x428a2f98u,0x71374491u,0xb5c0fbcfu,0xe9b5dba5u,0x3956c25bu,0x59f111f1u,
+    0x923f82a4u,0xab1c5ed5u,0xd807aa98u,0x12835b01u,0x243185beu,0x550c7dc3u,
+    0x72be5d74u,0x80deb1feu,0x9bdc06a7u,0xc19bf174u,0xe49b69c1u,0xefbe4786u,
+    0x0fc19dc6u,0x240ca1ccu,0x2de92c6fu,0x4a7484aau,0x5cb0a9dcu,0x76f988dau,
+    0x983e5152u,0xa831c66du,0xb00327c8u,0xbf597fc7u,0xc6e00bf3u,0xd5a79147u,
+    0x06ca6351u,0x14292967u,0x27b70a85u,0x2e1b2138u,0x4d2c6dfcu,0x53380d13u,
+    0x650a7354u,0x766a0abbu,0x81c2c92eu,0x92722c85u,0xa2bfe8a1u,0xa81a664bu,
+    0xc24b8b70u,0xc76c51a3u,0xd192e819u,0xd6990624u,0xf40e3585u,0x106aa070u,
+    0x19a4c116u,0x1e376c08u,0x2748774cu,0x34b0bcb5u,0x391c0cb3u,0x4ed8aa4au,
+    0x5b9cca4fu,0x682e6ff3u,0x748f82eeu,0x78a5636fu,0x84c87814u,0x8cc70208u,
+    0x90befffau,0xa4506cebu,0xbef9a3f7u,0xc67178f2u};
+static inline uint32_t rotr(uint32_t value,unsigned count)
+{return (value>>count)|(value<<(32-count));}
+static void compress(uint32_t state[8],const uint8_t block[64])
+{
+    uint32_t w[64];
+    for(unsigned i=0;i<16;++i)
+        w[i]=(uint32_t(block[i*4])<<24)|(uint32_t(block[i*4+1])<<16)|
+            (uint32_t(block[i*4+2])<<8)|uint32_t(block[i*4+3]);
+    for(unsigned i=16;i<64;++i) {
+        const uint32_t s0=rotr(w[i-15],7)^rotr(w[i-15],18)^(w[i-15]>>3);
+        const uint32_t s1=rotr(w[i-2],17)^rotr(w[i-2],19)^(w[i-2]>>10);
+        w[i]=w[i-16]+s0+w[i-7]+s1;
+    }
+    uint32_t a=state[0],b=state[1],c=state[2],d=state[3];
+    uint32_t e=state[4],f=state[5],g=state[6],h=state[7];
+    for(unsigned i=0;i<64;++i) {
+        const uint32_t s1=rotr(e,6)^rotr(e,11)^rotr(e,25);
+        const uint32_t ch=(e&f)^(~e&g);
+        const uint32_t t1=h+s1+ch+K[i]+w[i];
+        const uint32_t s0=rotr(a,2)^rotr(a,13)^rotr(a,22);
+        const uint32_t maj=(a&b)^(a&c)^(b&c);
+        const uint32_t t2=s0+maj;
+        h=g;g=f;f=e;e=d+t1;d=c;c=b;b=a;a=t1+t2;
+    }
+    state[0]+=a;state[1]+=b;state[2]+=c;state[3]+=d;
+    state[4]+=e;state[5]+=f;state[6]+=g;state[7]+=h;
+}
+void NativeAdrenoSha256::hash(const uint8_t *bytes,size_t length,uint8_t digest[32])
+{
+    uint32_t state[8]={0x6a09e667u,0xbb67ae85u,0x3c6ef372u,0xa54ff53au,
+        0x510e527fu,0x9b05688cu,0x1f83d9abu,0x5be0cd19u};
+    size_t at=0;
+    while(length-at>=64) {compress(state,bytes+at);at+=64;}
+    uint8_t tail[64];
+    const size_t rest=length-at;
+    memset(tail,0,sizeof(tail));
+    if(rest)memcpy(tail,bytes+at,rest);
+    tail[rest]=0x80;
+    if(rest>=56) {compress(state,tail);memset(tail,0,sizeof(tail));}
+    const uint64_t bits=uint64_t(length)*8;
+    for(unsigned i=0;i<8;++i)tail[63-i]=uint8_t(bits>>(8*i));
+    compress(state,tail);
+    for(unsigned i=0;i<8;++i) {
+        digest[i*4]=uint8_t(state[i]>>24);digest[i*4+1]=uint8_t(state[i]>>16);
+        digest[i*4+2]=uint8_t(state[i]>>8);digest[i*4+3]=uint8_t(state[i]);
+    }
+}
diff --git a/iokit/Kernel/arm/adreno/NativeAdrenoSha256.h b/iokit/Kernel/arm/adreno/NativeAdrenoSha256.h
new file mode 100644
index 0000000..fab08e8
--- /dev/null
+++ b/iokit/Kernel/arm/adreno/NativeAdrenoSha256.h
@@ -0,0 +1,14 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_SHA256_H
+#define NATIVE_ADRENO_SHA256_H
+#include <stddef.h>
+#include <stdint.h>
+/* FIPS 180-4 SHA-256 for firmware and manifest validation inside the kernel.
+ * One-shot only, no allocation, no I/O. Inputs may be empty; a null pointer is
+ * accepted only for zero bytes. The digest is big-endian as specified. */
+class NativeAdrenoSha256 final {
+    NativeAdrenoSha256()=delete;
+public:
+    static void hash(const uint8_t *bytes,size_t length,uint8_t digest[32]);
+};
+#endif
diff --git a/iokit/Kernel/arm/adreno/NativeAdrenoSmmuContext.cpp b/iokit/Kernel/arm/adreno/NativeAdrenoSmmuContext.cpp
new file mode 100644
index 0000000..c9ae161
--- /dev/null
+++ b/iokit/Kernel/arm/adreno/NativeAdrenoSmmuContext.cpp
@@ -0,0 +1,59 @@
+/* SPDX-License-Identifier: MIT */
+#include "NativeAdrenoSmmuContext.h"
+#include <IOKit/IOLib.h>
+IOReturn NativeAdrenoSmmuContext::prepare(NativeAdrenoMemory *tables,unsigned upper,uint64_t iova,
+    size_t bytes,size_t leaf_budget,unsigned bank,unsigned asid,unsigned poll_budget,unsigned output_bits)
+{
+    if(prepared_ || poisoned_)return kIOReturnBusy;
+    if(!tables || upper>1 || !bytes || (iova&4095) || !leaf_budget || leaf_budget>MaxLeaves ||
+        bank>63 || asid>0xffff || !poll_budget || poll_budget>4096)
+        return kIOReturnBadArgument;
+    const IOReturn prepared=NativeAdrenoPrepareSmmuMemory(tables,32,output_bits,iova,bytes,upper,leaf_budget,
+        &arena_,&state_,&visibility_);
+    if(prepared!=kIOReturnSuccess)return prepared==kIOReturnNoResources?prepared:kIOReturnBadArgument;
+    /* The adreno SMMU node is dma-coherent at the pinned tree, so table walks are inner write-back. */
+    config_=(ArmSmmu4KContextConfig){.lower=upper?nullptr:&arena_.config,.upper=upper?&arena_.config:nullptr,
+        .lower_tables=upper?nullptr:&state_.tables,.upper_tables=upper?&state_.tables:nullptr,.id0=0,.id2=0,
+        .asid=asid,.coherent_walk=1,.stall_on_fault=0,.continue_after_fault=1};
+    tables_=tables;bank_=bank;poll_budget_=poll_budget;prepared_=true;
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoSmmuContext::program(const ArmSmmu4KIo *io)
+{
+    if(!prepared_ || programmed_ || poisoned_ || !io)return kIOReturnBadArgument;
+    const ArmSmmu4KStatus status=ArmSmmu4KProgramDisabledContext(io,bank_,&config_,
+        poll_budget_,&program_);
+    program_status_=status;
+    if(status!=ArmSmmu4KSuccess) {poisoned_=true;return kIOReturnIOError;}
+    io_=*io;programmed_=true;
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoSmmuContext::attach(const ArmSmmu4KStream *routes,size_t count)
+{
+    if(!programmed_ || attached_ || poisoned_ || !routes || !count || count>8)
+        return kIOReturnBadArgument;
+    const ArmSmmu4KStatus status=ArmSmmu4KAttachStreams(&io_,&streams_,routes,count,
+        bank_,&config_,&routes_);
+    attach_status_=status;
+    if(status!=ArmSmmu4KSuccess) {poisoned_=true;return kIOReturnIOError;}
+    attached_=true;
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoSmmuContext::observe() const
+{
+    if(!programmed_ || poisoned_)return kIOReturnBadArgument;
+    ArmSmmu4KProgramResult result{};
+    return ArmSmmu4KObserveOwnedContext(&io_,bank_,&config_,&result)==ArmSmmu4KSuccess?
+        kIOReturnSuccess:kIOReturnIOError;
+}
+IOReturn NativeAdrenoSmmuContext::disable()
+{
+    if(!attached_ || poisoned_)return kIOReturnBadArgument;
+    ArmSmmu4KProgramResult result{};
+    if(ArmSmmu4KDisableOwnedContext(&io_,bank_,&config_,poll_budget_,&result)!=ArmSmmu4KSuccess) {
+        poisoned_=true;
+        return kIOReturnIOError;
+    }
+    attached_=false;programmed_=false;
+    return kIOReturnSuccess;
+}
diff --git a/iokit/Kernel/arm/adreno/NativeAdrenoSmmuContext.h b/iokit/Kernel/arm/adreno/NativeAdrenoSmmuContext.h
new file mode 100644
index 0000000..4ed1bcc
--- /dev/null
+++ b/iokit/Kernel/arm/adreno/NativeAdrenoSmmuContext.h
@@ -0,0 +1,68 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_SMMU_CONTEXT_H
+#define NATIVE_ADRENO_SMMU_CONTEXT_H
+#include "NativeAdrenoSmmuMemory.h"
+#include "ArmSmmu4KStreams.h"
+
+/* One single-region GPU SMMU context (lower/TTBR0, as the GMU's own 0..2 GiB
+ * space, or upper/TTBR1), composed from the qualified kits:
+ * prepare an inactive native4K table pool, program the context bank through the
+ * real register sequence, then attach the caller's streams. Every step is
+ * separate and can only run in order; a failure leaves the earlier state
+ * retained and marks this object unusable for further programming. The bank
+ * number, ASID and stream slots are required inputs and are never guessed.
+ * No power, clock, reset, fault-interrupt or global SMMU setup is performed. */
+class NativeAdrenoSmmuContext final {
+    NativeAdrenoMemory *tables_=nullptr;
+    ArmSmmu4KLiveArena arena_{};
+    ArmSmmu4KLiveState state_{};
+    ArmSmmu4KLiveVisibility visibility_{};
+    ArmSmmu4KContextConfig config_{};
+    ArmSmmu4KProgramResult program_{};
+    ArmSmmu4KStreamState streams_{};
+    ArmSmmu4KStreamResult routes_{};
+    ArmSmmu4KIo io_{};
+    unsigned bank_=0,poll_budget_=0;
+    ArmSmmu4KStatus program_status_=ArmSmmu4KSuccess,attach_status_=ArmSmmu4KSuccess;
+    bool prepared_=false,programmed_=false,attached_=false,poisoned_=false;
+public:
+    NativeAdrenoSmmuContext()=default;
+    ~NativeAdrenoSmmuContext()=default;
+    NativeAdrenoSmmuContext(const NativeAdrenoSmmuContext &)=delete;
+    NativeAdrenoSmmuContext &operator=(const NativeAdrenoSmmuContext &)=delete;
+    /* A 2 GiB lower aperture, the GMU's, is 524288 leaves. */
+    enum : size_t {MaxLeaves=size_t(1)<<19};
+    /* iova/bytes describe the aperture in the chosen region; the pool must be contiguous. */
+    /* output_bits: the context's output size, at most the SMMU's ID2.OAS (Linux uses OAS for stage 1). */
+    IOReturn prepare(NativeAdrenoMemory *tables,unsigned upper,uint64_t iova,size_t bytes,
+        size_t leaf_budget,unsigned bank,unsigned asid,unsigned poll_budget,unsigned output_bits=40);
+    /* Reads actual IDs, programs and enables exactly this bank. */
+    IOReturn program(const ArmSmmu4KIo *);
+    /* Attach the caller's exact stream routes to the programmed bank. */
+    IOReturn attach(const ArmSmmu4KStream *,size_t count);
+    /* Read-only observation of the owned enabled context. */
+    IOReturn observe() const;
+    /* Only after attach; leaves streams faulted by the caller's own recovery. */
+    IOReturn disable();
+    bool prepared() const {return prepared_;}
+    bool programmed() const {return programmed_;}
+    bool attached() const {return attached_;}
+    bool poisoned() const {return poisoned_;}
+    const ArmSmmu4KContextConfig *configuration() const {return &config_;}
+    const ArmSmmu4KLiveArena *arena() const {return &arena_;}
+    /* Handles for a NativeAdrenoVm that will map buffers through this bank. */
+    ArmSmmu4KLiveArena *arenaHandle() {return &arena_;}
+    /* Scratch the kit's physical-alias checks sort in (ArmSmmu4KLiveArena::alias_scratch), owned by the caller for this context's
+     * lifetime; without it those checks compare pairwise. Only after prepare. */
+    void setAliasScratch(uint32_t *entries,size_t count) {arena_.alias_scratch=entries;arena_.alias_scratch_entries=entries?count:0;}
+    ArmSmmu4KLiveState *stateHandle() {return &state_;}
+    ArmSmmu4KContextConfig *configHandle() {return &config_;}
+    ArmSmmu4KStreamState *streamsHandle() {return &streams_;}
+    const ArmSmmu4KIo *ioHandle() const {return &io_;}
+    const ArmSmmu4KProgramResult *programResult() const {return &program_; }
+    const ArmSmmu4KStreamResult *streamResult() const {return &routes_;}
+    /* The kit's own status of the last program/attach, which IOReturn folds into one error. */
+    ArmSmmu4KStatus programStatus() const {return program_status_;}
+    ArmSmmu4KStatus attachStatus() const {return attach_status_;}
+};
+#endif
diff --git a/iokit/Kernel/arm/adreno/NativeAdrenoSmmuMemory.cpp b/iokit/Kernel/arm/adreno/NativeAdrenoSmmuMemory.cpp
new file mode 100644
index 0000000..9aa7d0b
--- /dev/null
+++ b/iokit/Kernel/arm/adreno/NativeAdrenoSmmuMemory.cpp
@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier: MIT */
+#include "NativeAdrenoSmmuMemory.h"
+static int publishTable(void *cookie,volatile uint64_t *page,size_t bytes)
+{
+    auto *memory=static_cast<NativeAdrenoMemory *>(cookie);
+    if(!memory || !page || bytes!=4096 || ((uintptr_t)page&4095) ||
+        (uintptr_t)page<(uintptr_t)memory->mapping())return 1;
+    uintptr_t offset=(uintptr_t)page-(uintptr_t)memory->mapping();
+    if(offset>memory->bytes() || bytes>memory->bytes()-offset)return 1;
+    return memory->publishForDevice(offset,bytes,false)==kIOReturnSuccess?0:1;
+}
+IOReturn NativeAdrenoBindSmmuVisibility(NativeAdrenoMemory *memory,ArmSmmu4KLiveVisibility *visibility)
+{
+    if(!visibility)return kIOReturnBadArgument;*visibility={};
+    if(!memory || memory->quarantined() || !memory->deviceReferences() || !memory->mapping() ||
+        memory->spanCount()!=1 || memory->spans()[0].offset ||
+        memory->spans()[0].bytes!=memory->bytes())return kIOReturnBadArgument;
+    *visibility={memory,publishTable};return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoPrepareSmmuMemory(NativeAdrenoMemory *memory,unsigned input_bits,
+    unsigned output_bits,uint64_t iova,uint64_t bytes,unsigned upper,size_t budget,
+    ArmSmmu4KLiveArena *arena,ArmSmmu4KLiveState *state,ArmSmmu4KLiveVisibility *visibility)
+{
+    if(!memory || !arena || !state || !visibility)return kIOReturnBadArgument;
+    *visibility={};
+    if(state->prepared || state->poisoned || memory->quarantined() || memory->deviceReferences())
+        return kIOReturnBusy;
+    if(!memory->mapping() || memory->spanCount()!=1 ||
+        memory->spans()[0].offset || memory->spans()[0].bytes!=memory->bytes() ||
+        !memory->bytes() || (memory->bytes()&4095))return kIOReturnUnsupported;
+    *arena={{input_bits,output_bits,memory->spans()[0].physical,budget},iova,bytes,upper,
+        static_cast<volatile uint64_t *>(memory->mapping()),memory->bytes()/4096,nullptr,0};
+    ArmSmmu4KStatus status=ArmSmmu4KLivePrepare(arena,state);
+    if(status!=ArmSmmu4KSuccess)return status==ArmSmmu4KCapacity?kIOReturnNoResources:kIOReturnBadArgument;
+    ArmSmmu4KLiveResult audit;
+    status=ArmSmmu4KLiveAudit(arena,state,nullptr,0,&audit);
+    if(status!=ArmSmmu4KSuccess) {state->poisoned=1;return kIOReturnIOError;}
+    IOReturn result=memory->publishForDevice(0,state->tables.table_pages*4096,false);
+    if(result==kIOReturnSuccess)result=memory->holdForDevice();
+    if(result!=kIOReturnSuccess) {state->poisoned=1;return result;}
+    return NativeAdrenoBindSmmuVisibility(memory,visibility);
+}
diff --git a/iokit/Kernel/arm/adreno/NativeAdrenoSmmuMemory.h b/iokit/Kernel/arm/adreno/NativeAdrenoSmmuMemory.h
new file mode 100644
index 0000000..6fb40d3
--- /dev/null
+++ b/iokit/Kernel/arm/adreno/NativeAdrenoSmmuMemory.h
@@ -0,0 +1,22 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_SMMU_MEMORY_H
+#define NATIVE_ADRENO_SMMU_MEMORY_H
+#include "NativeAdrenoMemory.h"
+#include "ArmSmmu4KLive.h"
+/* Bind the actual contiguous raw-PA backing allocation to an INACTIVE native
+ * arena, publish its used table pages and take a device-lifetime reference.
+ * Caller retains memory/arena/state/visibility under an exclusive resource
+ * gate; all outputs and the backing pool are disjoint. State starts zeroed.
+ * Never invoke on an active or foreign table pool. This does not program a
+ * context, route streams, allocate MMIO/IRQs or establish power/security.
+ * On success the memory reference remains held until real masters are stopped,
+ * streams faulted, context disabled and native TLB synchronization completes.
+ * On prepare/publication failure no context has been exposed; caller retains
+ * allocation and poisoned state and handles cleanup. No automatic replay. */
+IOReturn NativeAdrenoPrepareSmmuMemory(NativeAdrenoMemory *,unsigned input_bits,
+    unsigned output_bits,uint64_t iova,uint64_t bytes,unsigned upper_region,
+    size_t leaf_budget,ArmSmmu4KLiveArena *,ArmSmmu4KLiveState *,ArmSmmu4KLiveVisibility *);
+/* Bind only the native PoC publisher to an already retained contiguous table
+ * allocation. No caller-supplied success callback or page-table copy. */
+IOReturn NativeAdrenoBindSmmuVisibility(NativeAdrenoMemory *,ArmSmmu4KLiveVisibility *);
+#endif
diff --git a/iokit/Kernel/arm/adreno/NativeAdrenoSmmuService.cpp b/iokit/Kernel/arm/adreno/NativeAdrenoSmmuService.cpp
new file mode 100644
index 0000000..9bd1886
--- /dev/null
+++ b/iokit/Kernel/arm/adreno/NativeAdrenoSmmuService.cpp
@@ -0,0 +1,102 @@
+/* SPDX-License-Identifier: MIT */
+/* GPU SMMU platform node: maps the SMMU register window and publishes its base
+ * so the GPU service does not resolve the DT phandle itself. No register is
+ * read or written, no context is allocated and no stream is attached; those
+ * steps remain with the GPU bring-up and its stream table. */
+#include <IOKit/IODeviceMemory.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <IOKit/IOService.h>
+#include "NativeAdrenoSmmuService.h"
+
+OSDefineMetaClassAndStructors(NativeAdrenoSmmuService,IOService)
+
+
+
+static bool advertisesSmmu(IOService *provider)
+{
+    OSObject *property = provider ? provider->getProperty("compatible") : nullptr;
+    OSData *data = OSDynamicCast(OSData, property);
+    if (!data || !data->getBytesNoCopy() || !data->getLength()) return false;
+    const char *text = static_cast<const char *>(data->getBytesNoCopy());
+    const size_t length = data->getLength();
+    static const char *needles[] = { "qcom,smmu-kgsl", "qcom,adreno-smmu", "arm,smmu-v2" };
+    for (const char *needle : needles) {
+        const size_t needle_len = strlen(needle);
+        for (size_t at = 0; at + needle_len <= length; ++at) {
+            if (strncmp(text + at, needle, needle_len) == 0) return true;
+        }
+    }
+    return false;
+}
+IOService *NativeAdrenoSmmuService::probe(IOService *provider,SInt32 *score)
+{
+    if(!advertisesSmmu(provider))return nullptr;
+    if(score)*score=1000;
+    return this;
+}
+bool NativeAdrenoSmmuService::start(IOService *provider)
+{
+    if(!IOService::start(provider))return false;
+    OSData *reg=OSDynamicCast(OSData,provider->getProperty("reg"));
+    OSData *address=OSDynamicCast(OSData,provider->getProperty("#address-cells"));
+    OSData *size=OSDynamicCast(OSData,provider->getProperty("#size-cells"));
+    uint32_t address_cells=2,size_cells=2;
+    if(address && address->getLength()>=4)
+        address_cells=*static_cast<const uint32_t *>(address->getBytesNoCopy());
+    if(size && size->getLength()>=4)
+        size_cells=*static_cast<const uint32_t *>(size->getBytesNoCopy());
+    if(!reg || NativeAdrenoBoard::parseReg(
+        static_cast<const uint8_t *>(reg->getBytesNoCopy()),reg->getLength(),
+        address_cells,size_cells,windows_,NativeAdrenoMaxWindows,&count_)!=kIOReturnSuccess) {
+        IOLog("NativeAdrenoSmmu: reg windows are not usable\n");
+        count_=0;IOService::stop(provider);
+        return false;
+    }
+    for(size_t index=0;index<count_;++index) {
+        IODeviceMemory *memory = provider ? provider->getDeviceMemoryWithIndex(static_cast<unsigned>(index)) : nullptr;
+        if (!memory) memory = getDeviceMemoryWithIndex(static_cast<unsigned>(index));
+        if (!memory) {
+            IOPhysicalAddress fallback_base = (index == 0) ? 0x05040000 : 0;
+            IOPhysicalLength fallback_size = (index == 0) ? 0x10000 : 0;
+            if (fallback_base) memory = IODeviceMemory::withRange(fallback_base, fallback_size);
+        }
+        if(!memory) {
+            IOLog("NativeAdrenoSmmu: window %lu has no device memory\n",
+                static_cast<unsigned long>(index));
+            stop(provider);
+            return false;
+        }
+        maps_[index]=OSSharedPtr<IOMemoryMap>(memory->map(kIOMapAnywhere|kIOMapInhibitCache),
+            OSNoRetain);
+        if(!maps_[index]) {
+            IOLog("NativeAdrenoSmmu: window %lu did not map\n",
+                static_cast<unsigned long>(index));
+            stop(provider);
+            return false;
+        }
+    }
+    OSData *bases=OSData::withCapacity(static_cast<UInt32>(count_*sizeof(uint64_t)));
+    if(!bases) {stop(provider);return false;}
+    for(size_t index=0;index<count_;++index) {
+        const uint64_t base=windows_[index].base;
+        bases->appendBytes(&base,sizeof(base));
+    }
+    setProperty("smmu-window-bases",bases);
+    bases->release();
+    OSData *cells=OSDynamicCast(OSData,provider->getProperty("#iommu-cells"));
+    if(cells && cells->getLength()>=4) {
+        const uint32_t value=*static_cast<const uint32_t *>(cells->getBytesNoCopy());
+        setProperty("iommu-cells",value,32);
+    }
+    IOLog("NativeAdrenoSmmu: %lu window mapped, no register access\n",
+        static_cast<unsigned long>(count_));
+    registerService();
+    return true;
+}
+void NativeAdrenoSmmuService::stop(IOService *provider)
+{
+    for(auto &map:maps_)map.reset();
+    count_=0;
+    IOService::stop(provider);
+}
diff --git a/iokit/Kernel/arm/adreno/NativeAdrenoSmmuService.h b/iokit/Kernel/arm/adreno/NativeAdrenoSmmuService.h
new file mode 100644
index 0000000..bd0555b
--- /dev/null
+++ b/iokit/Kernel/arm/adreno/NativeAdrenoSmmuService.h
@@ -0,0 +1,27 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_SMMU_SERVICE_H
+#define NATIVE_ADRENO_SMMU_SERVICE_H
+#include <IOKit/IOMemoryDescriptor.h>
+#include <IOKit/IOService.h>
+#include "NativeAdrenoBoard.h"
+
+class NativeAdrenoSmmuService : public IOService {
+    OSDeclareDefaultStructors(NativeAdrenoSmmuService)
+    OSSharedPtr<IOMemoryMap> maps_[NativeAdrenoMaxWindows];
+    NativeAdrenoWindow windows_[NativeAdrenoMaxWindows]{};
+    size_t count_=0;
+public:
+    IOService *probe(IOService *provider,SInt32 *score) APPLE_KEXT_OVERRIDE;
+    bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+    void stop(IOService *provider) APPLE_KEXT_OVERRIDE;
+    uint64_t windowBase(size_t index) const
+    {return index<count_?windows_[index].base:0;}
+    uint64_t windowBytes(size_t index) const
+    {return index<count_?windows_[index].bytes:0;}
+    size_t windowCount() const {return count_;}
+    volatile uint8_t *windowAddress(size_t index) const
+    {return index<count_ && maps_[index] ?
+        reinterpret_cast<volatile uint8_t *>(maps_[index]->getVirtualAddress()):nullptr;}
+};
+
+#endif
diff --git a/iokit/Kernel/arm/adreno/NativeAdrenoStatus.h b/iokit/Kernel/arm/adreno/NativeAdrenoStatus.h
new file mode 100644
index 0000000..fa69ac8
--- /dev/null
+++ b/iokit/Kernel/arm/adreno/NativeAdrenoStatus.h
@@ -0,0 +1,26 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_STATUS_H
+#define NATIVE_ADRENO_STATUS_H
+#include <IOKit/IOTypes.h>
+#include <stdint.h>
+/* Monotonic fault and suspend counters for Turnip's device_check_status and
+ * device_get_suspend_count. Turnip compares the fault count against the value
+ * it saw last; a change means the context is lost. This object only counts
+ * what the driver tells it: the IRQ path records a fatal decode, the reset or
+ * power path records a suspend, and submission poisoning must be recorded by
+ * the caller that observed it. It performs no detection, reset or recovery and
+ * never clears a count, so a client cannot hide a fault by re-reading. */
+struct NativeAdrenoStatusCounts {
+    uint64_t faults;
+    uint64_t suspends;
+};
+class NativeAdrenoStatus final {
+    uint64_t faults_=0,suspends_=0;
+public:
+    void noteFault() {if(faults_!=UINT64_MAX)++faults_;}
+    void noteSuspend() {if(suspends_!=UINT64_MAX)++suspends_;}
+    uint64_t faults() const {return faults_;}
+    uint64_t suspends() const {return suspends_;}
+    NativeAdrenoStatusCounts counts() const {return {faults_,suspends_};}
+};
+#endif
diff --git a/iokit/Kernel/arm/adreno/NativeAdrenoSubmit.cpp b/iokit/Kernel/arm/adreno/NativeAdrenoSubmit.cpp
new file mode 100644
index 0000000..238ebb6
--- /dev/null
+++ b/iokit/Kernel/arm/adreno/NativeAdrenoSubmit.cpp
@@ -0,0 +1,280 @@
+/* SPDX-License-Identifier: MIT */
+#include "NativeAdrenoSubmit.h"
+#include "AdrenoPM4.h"
+#include <IOKit/IOLib.h>
+
+/* CP_INDIRECT_BUFFER is opcode 0x3f with a 3-word payload: 64-bit GPU address
+ * and IB_SIZE in dwords (bits 0..19), exactly as the pinned adreno_pm4.xml
+ * domain states and Linux msm_gem_submit.c converts the userspace byte size. */
+enum : uint32_t {SubmitIndirectBuffer=0x3f,SubmitIbWords=3,SubmitMaxJobs=8,
+    SubmitMaxBuffers=16,SubmitMaxIbBytes=0xfffffu*4u,
+    SubmitAuditBytes=256u*1024u};   /* IB bytes the write-combine audit compares per submission */
+extern "C" {volatile uint32_t native_adreno_coherence[8];}
+/* The submission (1-based count) at which the write-combine audit found a dirty IB line or failed; 0 = never. */
+extern "C" {volatile uint32_t native_adreno_wc_distrusted;}
+/* The write-combine audit before each submission while trusted: [0] submissions audited, [1] IB lines compared, [2] dirty lines,
+ * [3] stale clean lines, [4] the last audit failure (any failure also ends the trust), [5] pages found back at the default attribute
+ * and write-combined again. */
+extern "C" {volatile uint32_t native_adreno_wc_audit[6];}
+/* Fence waits: [0] calls, [1] timeouts, [2] the fence of the last timed-out wait, [3] the fence value the GPU had written then, [4] the newest fence handed out,
+ * [5] the newest completed, [6] waits for a fence no job holds (observeFence path), [7] the last fence refused as never submitted. */
+extern "C" {volatile uint32_t native_adreno_fence_wait[8];}
+/* The IBs of the last submissions: [slot] fence, iova low/high, bytes, then the first 28 dwords of the first IB (read as the kernel maps it). */
+extern "C" {volatile uint32_t native_adreno_ib_log[4][4+28];volatile uint32_t native_adreno_ib_log_count;}
+IOReturn NativeAdrenoSubmit::poison()
+{
+    poisoned_=true;return kIOReturnIOError;
+}
+NativeAdrenoSubmit::Job *NativeAdrenoSubmit::find(uint32_t fence)
+{
+    if(fence)for(auto &job:jobs_)if(job.active && job.fence==fence)return &job;
+    return nullptr;
+}
+NativeAdrenoSubmit::Job *NativeAdrenoSubmit::free()
+{
+    for(auto &job:jobs_)if(!job.active)return &job;
+    return nullptr;
+}
+IOReturn NativeAdrenoSubmit::attach(NativeAdrenoVm *vm,NativeAdrenoRing *ring)
+{
+    if(attached_ || poisoned_ || vm_ || ring_)return kIOReturnBusy;
+    if(!vm || !ring || vm->poisoned() || ring->poisoned())return kIOReturnBadArgument;
+    vm_=vm;ring_=ring;attached_=true;stats_={};
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoSubmit::release(Job &job)
+{
+    IOReturn status=kIOReturnSuccess;
+    for(size_t i=0;i<job.count;++i) {
+        IOReturn retired=vm_->retireJobAfterCompletion(job.handles[i]);
+        if(retired)status=retired;else ++stats_.references_retired;
+    }
+    if(status)return poison();
+    if(vm_->acquireImported())return poison();
+    job={};return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoSubmit::detach()
+{
+    if(poisoned_ || outstanding())return kIOReturnBusy;
+    if(!attached_)return kIOReturnNotReady;
+    attached_=false;vm_=nullptr;ring_=nullptr;return kIOReturnSuccess;
+}
+bool NativeAdrenoSubmit::queueOutstanding(uint32_t queue) const
+{
+    return rangeOutstanding(queue,1);
+}
+bool NativeAdrenoSubmit::rangeOutstanding(uint32_t first,uint32_t count) const
+{
+    for(const auto &job:jobs_)if(job.active && job.queue-first<count)return true;
+    return false;
+}
+size_t NativeAdrenoSubmit::outstanding() const
+{
+    size_t count=0;for(const auto &job:jobs_)if(job.active)++count;return count;
+}
+IOReturn NativeAdrenoSubmit::submit(const NativeAdrenoSubmitBuffer *buffers,size_t count,
+    uint32_t queue,uint32_t *fence)
+{
+    if(!fence)return kIOReturnBadArgument;*fence=0;
+    if(!attached_ || poisoned_)return kIOReturnNotReady;
+    if(!buffers || !count || count>SubmitMaxBuffers)return kIOReturnBadArgument;
+    /* Every buffer is validated against the live VM before any reference. */
+    uint64_t handles[SubmitMaxBuffers];size_t handle_count=0;
+    uint32_t words[SubmitMaxBuffers*(1+SubmitIbWords)];size_t word_count=0;
+    for(size_t i=0;i<count;++i) {
+        const NativeAdrenoSubmitBuffer &buffer=buffers[i];
+        if(!buffer.handle || !buffer.bytes || (buffer.bytes&3) || buffer.bytes>SubmitMaxIbBytes)
+            return kIOReturnBadArgument;
+        uint64_t iova=0;size_t bytes=0;unsigned permissions=0;
+        IOReturn status=vm_->describe(buffer.handle,&iova,&bytes,&permissions);
+        if(status)return status;
+        if(!(permissions&ArmSmmu4KRead) || buffer.iova<iova ||
+            buffer.iova-iova>bytes || buffer.bytes>bytes-(buffer.iova-iova))return kIOReturnBadArgument;
+        uint32_t header=0;
+        if(AdrenoPM4Type7(SubmitIndirectBuffer,SubmitIbWords,&header)!=AdrenoPM4Success)
+            return poison();
+        words[word_count++]=header;
+        words[word_count++]=(uint32_t)buffer.iova;
+        words[word_count++]=(uint32_t)(buffer.iova>>32);
+        words[word_count++]=(uint32_t)(buffer.bytes/4);
+        bool known=false;
+        for(size_t j=0;j<handle_count;++j)if(handles[j]==buffer.handle) {known=true;break;}
+        if(!known)handles[handle_count++]=buffer.handle;
+    }
+    IOReturn swept=retireCompleted();
+    if(swept)return swept;
+    Job *job=free();
+    if(!job)return kIOReturnBusy;
+    for(size_t i=0;i<handle_count;++i) {
+        IOReturn status=vm_->holdJob(handles[i]);
+        if(status) {
+            while(i) {vm_->retireJobAfterCompletion(handles[--i]);++stats_.references_retired;}
+            return status;
+        }
+        ++stats_.references_held;
+    }
+    uint32_t value=0;
+    /* int-070: the first IB word as the kernel's cacheable alias and DRAM see it before any maintenance, then DRAM after the CPU
+     * caches over every mapped BO are cleaned and invalidated. The board shows the last submission's record on a stall. */
+    uint32_t cached=~0u,before=~0u,ignored=0,after=~0u;
+    /* Write-combined stores this CPU made before the call (the client's command words) complete before anything below. */
+    __asm__ volatile("dsb sy":::"memory");
+    /* int-098/099: with write-combined user BOs and no maintenance the CP stopped at the end of the first IB, as in int-065..069 when an
+     * IB sat in a CPU cache. While write-combined BOs are trusted, every line of this submission's IBs is compared as a CPU cache and
+     * DRAM hold it (bounded). A dirty line means a client view still caches its BOs: maintain every BO from now on, this submission
+     * included (the audit already wrote the IB lines back; the rest of the BOs may hold more). */
+    if(vm_->writeCombinedTrusted()) {
+        /* int-100: the dirty IB page was back at XNU's default (cacheable) attribute. Write-combine every such page again first; the
+         * pmap writes its lines back on the way, so the audit below should then find none. */
+        uint32_t reset=0;
+        IOReturn audited=vm_->reassertWriteCombined(&reset);
+        native_adreno_wc_audit[5]=native_adreno_wc_audit[5]+reset;
+        uint32_t lines=0,dirty=0,stale=0;size_t budget=SubmitAuditBytes;
+        /* The re-assertion above is the correction and runs every time; the audit only detects, and found no dirty line in int-141's
+         * 133798, so after the first 16 submissions it compares every eighth one's IBs (it cost about 2 ms each). */
+        ++audit_tick_;
+        const bool audit_now=audit_tick_<=16 || (audit_tick_&7)==1;
+        if(!audit_now)budget=0;
+        for(size_t i=0;i<count && budget && !audited;++i) {   /* a failed re-assertion skips the audit and ends the trust */
+            const size_t bytes=buffers[i].bytes<budget?(size_t)buffers[i].bytes:budget;
+            audited=vm_->auditRange(buffers[i].iova,bytes,&lines,&dirty,&stale);budget-=bytes;
+        }
+        if(audit_now && audited!=kIOReturnUnsupported) {   /* no board hook (host): nothing to compare */
+            native_adreno_wc_audit[0]=native_adreno_wc_audit[0]+1;
+            native_adreno_wc_audit[1]=native_adreno_wc_audit[1]+lines;
+            native_adreno_wc_audit[2]=native_adreno_wc_audit[2]+dirty;
+            native_adreno_wc_audit[3]=native_adreno_wc_audit[3]+stale;
+            if(audited)native_adreno_wc_audit[4]=audited;
+        }
+        if(dirty || (audited && audited!=kIOReturnUnsupported)) {
+            vm_->distrustWriteCombined();
+            native_adreno_wc_distrusted=native_adreno_coherence[0]+1;
+        }
+    }
+    (void)vm_->sampleWord(buffers[0].iova,&cached,&before);
+    IOReturn status=vm_->publishMapped();
+    if(!status) {
+        (void)vm_->sampleWord(buffers[0].iova,&ignored,&after);
+        native_adreno_coherence[0]=native_adreno_coherence[0]+1;
+        native_adreno_coherence[1]=cached;native_adreno_coherence[2]=before;native_adreno_coherence[3]=after;
+        if(cached!=before || before!=after) {
+            if(!native_adreno_coherence[4]) {
+                native_adreno_coherence[5]=cached;native_adreno_coherence[6]=before;native_adreno_coherence[7]=after;
+            }
+            native_adreno_coherence[4]=native_adreno_coherence[4]+1;
+        }
+        status=vm_->invalidateTlb();
+    }
+    if(status) {
+        for(size_t i=0;i<handle_count;++i) {vm_->retireJobAfterCompletion(handles[i]);++stats_.references_retired;}
+        return status;
+    }
+    {
+        const uint32_t slot=native_adreno_ib_log_count&3;uint32_t head[28];
+        (void)vm_->peekWords(buffers[0].iova,head,28);
+        native_adreno_ib_log[slot][0]=ring_->lastSubmitted()+1;native_adreno_ib_log[slot][1]=(uint32_t)buffers[0].iova;
+        native_adreno_ib_log[slot][2]=(uint32_t)(buffers[0].iova>>32);native_adreno_ib_log[slot][3]=(uint32_t)buffers[0].bytes;
+        for(unsigned i=0;i<28;++i)native_adreno_ib_log[slot][4+i]=head[i];
+        native_adreno_ib_log_count=native_adreno_ib_log_count+1;
+    }
+    status=ring_->submitFramed(words,word_count,&value);
+    if(status) {
+        /* A poisoned ring may already have consumed the WPTR write, so the
+         * referenced buffers cannot be retired here. */
+        if(ring_->poisoned()) {
+            *job=Job{};++stats_.poisoned_jobs;
+            for(size_t i=0;i<handle_count;++i)job->handles[i]=handles[i];
+            job->count=handle_count;job->queue=queue;job->active=true;
+            return poison();
+        }
+        while(handle_count) {vm_->retireJobAfterCompletion(handles[--handle_count]);++stats_.references_retired;}
+        return status;
+    }
+    for(size_t i=0;i<handle_count;++i)job->handles[i]=handles[i];
+    job->count=handle_count;job->fence=value;job->queue=queue;job->active=true;
+    ++stats_.submissions;
+    if(outstanding()>stats_.peak_jobs)stats_.peak_jobs=outstanding();
+    *fence=value;
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoSubmit::observeFence(uint32_t fence,const NativeAdrenoRingClock *clock,
+    uint32_t timeout_us)
+{
+    if(!attached_ || poisoned_)return kIOReturnNotReady;
+    if(!fence)return kIOReturnBadArgument;
+    const NativeAdrenoRingFence result=ring_->observeFence(fence,clock,timeout_us,nullptr);
+    if(result==NativeAdrenoRingFencePoisoned)return poison();
+    if(result==NativeAdrenoRingFenceArgument)return kIOReturnBadArgument;
+    if(result==NativeAdrenoRingFenceTimeout)return kIOReturnTimeout;
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoSubmit::wait(uint32_t fence,const NativeAdrenoRingClock *clock,
+    uint32_t timeout_us)
+{
+    if(!attached_ || poisoned_)return kIOReturnNotReady;
+    Job *job=find(fence);
+    uint32_t observed=0;
+    native_adreno_fence_wait[0]=native_adreno_fence_wait[0]+1;
+    if(!job) {
+        native_adreno_fence_wait[6]=native_adreno_fence_wait[6]+1;
+        const NativeAdrenoRingFence passed=ring_->observeFence(fence,clock,timeout_us,&observed);
+        if(passed==NativeAdrenoRingFencePoisoned)return poison();
+        if(passed==NativeAdrenoRingFenceArgument) {native_adreno_fence_wait[7]=fence;return kIOReturnBadArgument;}
+        if(passed==NativeAdrenoRingFenceTimeout) {
+            ++stats_.timeouts;
+            native_adreno_fence_wait[1]=native_adreno_fence_wait[1]+1;native_adreno_fence_wait[2]=fence;native_adreno_fence_wait[3]=observed;
+            native_adreno_fence_wait[4]=ring_->lastSubmitted();native_adreno_fence_wait[5]=ring_->completedFence();
+            return kIOReturnTimeout;
+        }
+        return kIOReturnSuccess;
+    }
+    const NativeAdrenoRingFence result=ring_->wait(fence,clock,timeout_us,&observed);
+    if(result==NativeAdrenoRingFencePoisoned)return poison();
+    if(result==NativeAdrenoRingFenceArgument) {native_adreno_fence_wait[7]=fence;return kIOReturnBadArgument;}
+    if(result==NativeAdrenoRingFenceTimeout) {
+        ++stats_.timeouts;
+        native_adreno_fence_wait[1]=native_adreno_fence_wait[1]+1;native_adreno_fence_wait[2]=fence;native_adreno_fence_wait[3]=observed;
+        native_adreno_fence_wait[4]=ring_->lastSubmitted();native_adreno_fence_wait[5]=ring_->completedFence();
+        return kIOReturnTimeout;
+    }
+    IOReturn status=release(*job);
+    if(status)return status;
+    ++stats_.completed;
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoSubmit::waitAll(const NativeAdrenoRingClock *clock,uint32_t timeout_us)
+{
+    if(!attached_ || poisoned_)return kIOReturnNotReady;
+    while(outstanding()) {
+        Job *oldest=nullptr;
+        for(auto &job:jobs_)if(job.active && (!oldest || job.fence-oldest->fence>0x80000000u))oldest=&job;
+        const IOReturn status=wait(oldest->fence,clock,timeout_us);
+        if(status)return status;
+    }
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoSubmit::waitRange(uint32_t first,uint32_t count,const NativeAdrenoRingClock *clock,uint32_t timeout_us)
+{
+    if(!attached_ || poisoned_)return kIOReturnNotReady;
+    while(rangeOutstanding(first,count)) {
+        Job *oldest=nullptr;
+        for(auto &job:jobs_)if(job.active && job.queue-first<count && (!oldest || job.fence-oldest->fence>0x80000000u))oldest=&job;
+        const IOReturn status=wait(oldest->fence,clock,timeout_us);
+        if(status)return status;
+    }
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoSubmit::retireCompleted()
+{
+    if(!attached_ || poisoned_)return kIOReturnNotReady;
+    for(auto &job:jobs_) {
+        if(!job.active)continue;
+        const NativeAdrenoRingFence state=ring_->observeFence(job.fence,nullptr,0,nullptr);
+        if(state==NativeAdrenoRingFencePoisoned)return poison();
+        if(state!=NativeAdrenoRingFenceComplete)continue;
+        const IOReturn status=release(job);
+        if(status)return status;
+        ++stats_.completed;
+    }
+    return kIOReturnSuccess;
+}
diff --git a/iokit/Kernel/arm/adreno/NativeAdrenoSubmit.h b/iokit/Kernel/arm/adreno/NativeAdrenoSubmit.h
new file mode 100644
index 0000000..6e99aff
--- /dev/null
+++ b/iokit/Kernel/arm/adreno/NativeAdrenoSubmit.h
@@ -0,0 +1,82 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_SUBMIT_H
+#define NATIVE_ADRENO_SUBMIT_H
+#include "NativeAdrenoRing.h"
+#include "NativeAdrenoVm.h"
+
+struct NativeAdrenoSubmitBuffer {
+    uint64_t handle;
+    uint64_t iova;
+    size_t bytes;      /* Complete indirect-buffer range in bytes. */
+};
+/* Coherence samples (int-070): [0] submissions sampled; [1..3] the last one's first IB word through the kernel's cacheable alias,
+ * through DRAM before and through DRAM after the CPU cache maintenance of every mapped BO (~0 when unreadable); [4] samples whose
+ * three values differ and [5..7] the first such sample. */
+extern "C" volatile uint32_t native_adreno_coherence[8];
+/* The write-combine audit (int-100), see NativeAdrenoSubmit.cpp, and the submission (1-based) that ended the trust; 0 = never. */
+extern "C" volatile uint32_t native_adreno_wc_audit[6];
+extern "C" volatile uint32_t native_adreno_wc_distrusted;
+struct NativeAdrenoSubmitStats {
+    uint32_t submissions,completed,timeouts,poisoned_jobs;
+    size_t references_held,references_retired,peak_jobs;
+};
+/* Kernel-side execbuf: turns validated indirect buffers into one ring
+ * submission and owns a device reference per distinct buffer until the
+ * timestamp fence is actually observed. This is not a userspace ABI and not a
+ * scheduler: at most eight jobs are outstanding, callers serialize every
+ * method, and the ring/VM must already be attached to the same live context.
+ * Buffers may be sub-ranges of a live VM mapping but never a different IOVA,
+ * unmapped handle, table pool or a range that includes unreadable bytes.
+ * A failed ring commit that poisons the ring keeps every reference and the
+ * submit object unusable; only an independent reset may reclaim them. */
+class NativeAdrenoSubmit final {
+    struct Job {
+        uint32_t fence=0;
+        size_t count=0;
+        uint64_t handles[16]{};
+        uint32_t queue=0;
+        bool active=false;
+    } jobs_[8];
+    NativeAdrenoVm *vm_=nullptr;
+    NativeAdrenoRing *ring_=nullptr;
+    NativeAdrenoSubmitStats stats_{};
+    bool attached_=false,poisoned_=false;
+    uint32_t audit_tick_=0;   /* submissions since attach; every eighth one audits its IB lines */
+    Job *find(uint32_t fence);
+    Job *free();
+    IOReturn release(Job &);
+    IOReturn poison();
+public:
+    NativeAdrenoSubmit()=default;
+    ~NativeAdrenoSubmit()=default;
+    NativeAdrenoSubmit(const NativeAdrenoSubmit &)=delete;
+    NativeAdrenoSubmit &operator=(const NativeAdrenoSubmit &)=delete;
+    IOReturn attach(NativeAdrenoVm *,NativeAdrenoRing *);
+    /* Refuses while jobs are outstanding or poisoned; the caller must have
+     * stopped the GPU and observed every fence before calling this. */
+    IOReturn detach();
+    /* queue is bookkeeping for one shared ring; it never reorders or isolates
+     * submissions and is validated by the caller's open queue set. */
+    IOReturn submit(const NativeAdrenoSubmitBuffer *,size_t,uint32_t queue,
+        uint32_t *fence);
+    bool queueOutstanding(uint32_t queue) const;
+    /* Queues [first, first+count): whether any of their jobs is outstanding, and a wait for every one of them (oldest first) that
+     * leaves other queues' jobs alone. Each client of the shared ring owns one such range. */
+    bool rangeOutstanding(uint32_t first,uint32_t count) const;
+    IOReturn waitRange(uint32_t first,uint32_t count,const NativeAdrenoRingClock *,uint32_t timeout_us);
+    /* Retires (without waiting) every job whose fence the CP has already passed, so completed work never pins buffers or
+     * job slots just because nobody called wait(). */
+    IOReturn retireCompleted();
+    /* Waits for every outstanding job in submission order and retires its references. */
+    IOReturn waitAll(const NativeAdrenoRingClock *,uint32_t timeout_us);
+    /* Polls the CP timestamp; on completion retires every buffer reference. A fence whose job was already retired (by
+     * wait or retireCompleted) is checked against the ring and succeeds once the CP has passed it. */
+    IOReturn wait(uint32_t fence,const NativeAdrenoRingClock *,uint32_t timeout_us);
+    /* Wait for an earlier fence without touching job references; a timeout
+     * leaves every job and reference exactly as they were. */
+    IOReturn observeFence(uint32_t fence,const NativeAdrenoRingClock *,uint32_t timeout_us);
+    bool poisoned() const {return poisoned_;}
+    size_t outstanding() const;
+    NativeAdrenoSubmitStats stats() const {return stats_;}
+};
+#endif
diff --git a/iokit/Kernel/arm/adreno/NativeAdrenoTimer.cpp b/iokit/Kernel/arm/adreno/NativeAdrenoTimer.cpp
new file mode 100644
index 0000000..0222415
--- /dev/null
+++ b/iokit/Kernel/arm/adreno/NativeAdrenoTimer.cpp
@@ -0,0 +1,55 @@
+/* SPDX-License-Identifier: MIT */
+#include "NativeAdrenoTimer.h"
+#include <IOKit/IOLib.h>
+
+/* Derivation, not a guess:
+ *   pinned a6xx_gmu.xml  GMU_ALWAYS_ON_COUNTER_L 0x1f888, _H 0x1f889
+ *                        (dword offsets, variants A6XX-A7XX)
+ *   pinned sm8550.dtsi   gpu@3d00000, gmu@3d6a000
+ *   byte offset = (offset << 2) - (gmu_base - gpu_base)
+ *               = (0x1f888 << 2) - 0x6a000 = 0x14220
+ *   pinned a6xx.xml      CP_ALWAYS_ON_COUNTER 0x0980 (64-bit, A6XX-A7XX)
+ *     read as low at 0x0980 and high at 0x0981, as Linux gpu_read64 does. */
+enum : uint32_t {
+    TimerGmuLow = 0x14220,
+    TimerGmuHigh = 0x14224,
+    TimerCpLow = 0x0980,
+    TimerCpHigh = 0x0981,
+    TimerRetries = 8
+};
+uint32_t NativeAdrenoTimer::gmuLowOffset(){return TimerGmuLow;}
+uint32_t NativeAdrenoTimer::gmuHighOffset(){return TimerGmuHigh;}
+uint32_t NativeAdrenoTimer::cpLowRegister(){return TimerCpLow;}
+uint32_t NativeAdrenoTimer::cpHighRegister(){return TimerCpHigh;}
+IOReturn NativeAdrenoTimer::attach(const NativeAdrenoTimeIo *io,uint32_t source)
+{
+    if(attached_)return kIOReturnBusy;
+    if(!io || !io->read32)return kIOReturnBadArgument;
+    if(source!=NativeAdrenoTimeGmu && source!=NativeAdrenoTimeCp)return kIOReturnBadArgument;
+    io_=*io;source_=source;attached_=true;
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoTimer::detach()
+{
+    if(!attached_)return kIOReturnNotReady;
+    attached_=false;io_={};
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoTimer::read(uint64_t *ticks) const
+{
+    if(!ticks)return kIOReturnBadArgument;*ticks=0;
+    if(!attached_)return kIOReturnNotReady;
+    const uint32_t low=source_==NativeAdrenoTimeGmu?TimerGmuLow:TimerCpLow;
+    const uint32_t high=source_==NativeAdrenoTimeGmu?TimerGmuHigh:TimerCpHigh;
+    for(unsigned attempt=0;attempt<TimerRetries;++attempt) {
+        uint32_t first=0,low_word=0,second=0;
+        if(io_.read32(io_.cookie,high,&first) ||
+            io_.read32(io_.cookie,low,&low_word) ||
+            io_.read32(io_.cookie,high,&second))return kIOReturnIOError;
+        if(first==second) {
+            *ticks=(uint64_t(first)<<32)|low_word;
+            return kIOReturnSuccess;
+        }
+    }
+    return kIOReturnTimeout;
+}
diff --git a/iokit/Kernel/arm/adreno/NativeAdrenoTimer.h b/iokit/Kernel/arm/adreno/NativeAdrenoTimer.h
new file mode 100644
index 0000000..4366105
--- /dev/null
+++ b/iokit/Kernel/arm/adreno/NativeAdrenoTimer.h
@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_TIMER_H
+#define NATIVE_ADRENO_TIMER_H
+#include <IOKit/IOTypes.h>
+#include <stdint.h>
+
+/* GPU always-on counter reader for the user-visible timestamp. Two sources are
+ * distinguished because their address spaces differ:
+ *  - GMU window: byte offsets inside the already bound GMU window. The A740
+ *    offset is derived from the pinned a6xx_gmu.xml dword offset 0x1f888 and
+ *    the SM8550 DT layout: (0x1f888 << 2) - (gmu 0x03d6a000 - gpu 0x03d00000)
+ *    = 0x14220 for the low word and 0x14224 for the high word.
+ *  - CP window: dword register indices in the GPU register window, from
+ *    a6xx.xml CP_ALWAYS_ON_COUNTER at 0x0980 for A6XX..A7XX.
+ * The caller binds exactly one already powered window; this object performs no
+ * power, reset or window discovery. Reads retry while the high word changes,
+ * so a counter rollover cannot return a torn value; exceeding the retry bound
+ * is an error. A failed read reports an I/O error and never fabricates ticks. */
+enum NativeAdrenoTimeSource { NativeAdrenoTimeGmu = 0, NativeAdrenoTimeCp = 1 };
+struct NativeAdrenoTimeIo {
+    void *cookie;
+    int (*read32)(void *,uint32_t address,uint32_t *value);
+};
+class NativeAdrenoTimer final {
+    NativeAdrenoTimeIo io_{};
+    uint32_t source_=NativeAdrenoTimeGmu;
+    bool attached_=false;
+public:
+    NativeAdrenoTimer()=default;
+    ~NativeAdrenoTimer()=default;
+    NativeAdrenoTimer(const NativeAdrenoTimer &)=delete;
+    NativeAdrenoTimer &operator=(const NativeAdrenoTimer &)=delete;
+    /* Source is a numeric ABI boundary value and is range-checked. */
+    IOReturn attach(const NativeAdrenoTimeIo *,uint32_t source);
+    IOReturn detach();
+    IOReturn read(uint64_t *ticks) const;
+    static uint32_t gmuLowOffset();
+    static uint32_t gmuHighOffset();
+    static uint32_t cpLowRegister();
+    static uint32_t cpHighRegister();
+};
+#endif
diff --git a/iokit/Kernel/arm/adreno/NativeAdrenoUserClient.cpp b/iokit/Kernel/arm/adreno/NativeAdrenoUserClient.cpp
