+/* Sweet: the console crash log carries no backtrace, so an illegal-PA panic puts its caller chain in the panic string. */
+static void __attribute__((noinline))
+sweet_frames(uintptr_t out[8])
+{
+	uintptr_t *fp = (uintptr_t *)__builtin_frame_address(0);
+
+	for (int i = 0; i < 8; i++) {
+		out[i] = 0;
+	}
+	for (int i = 0; i < 8; i++) {
+		if (((uintptr_t)fp & 15) || (uintptr_t)fp < VM_MIN_KERNEL_ADDRESS) {
+			break;
+		}
+		out[i] = fp[1];
+		fp = (uintptr_t *)fp[0];
+	}
+}
+
