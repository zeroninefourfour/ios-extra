+    0x00000e09,
+    0x00000e0a,
+    0x00000e07,
+    0x00000e08,
+    0x00000e0b,
+    0x00000e0c,
+    0x00000e0d,
+    0x00000e0e,
+    0x00000e17,
+    0x00000e01,
+    0x00008e08,
+    0x00008e28,
+    0x00008e50,
+    0x00000e3a,
+    0x00000e19,
+    0x0000b602,
+};
+#define NATIVE_ADRENO_A740_PWRUP_COUNT \
