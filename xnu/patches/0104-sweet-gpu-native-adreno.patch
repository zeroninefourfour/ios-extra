diff --git a/iokit/Kernel/arm/adreno/NativeAdrenoABI.h b/iokit/Kernel/arm/adreno/NativeAdrenoABI.h
new file mode 100644
index 0000000..3ca23cd
--- /dev/null
+++ b/iokit/Kernel/arm/adreno/NativeAdrenoABI.h
@@ -0,0 +1,165 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_ABI_H
+#define NATIVE_ADRENO_ABI_H
+#include <stdint.h>
+
+/* Versioned kernel/user-client wire ABI for the native Adreno driver. This is
+ * NOT the Metal, IOKit or Turnip ABI and it does not describe an ioctl. The
+ * IOKit service will copy exactly these fixed-size records across its external
+ * methods. All fields are little endian; both participants are ARM64. Every
+ * array is inside one fixed record so a caller cannot pass a length that
+ * disagrees with the storage. Unknown versions, methods and flags are refused
+ * rather than ignored. */
+enum {
+    NativeAdrenoAbiVersion = 1,
+    NativeAdrenoAbiMaxBuffers = 16,
+    NativeAdrenoAbiMaxBoBytesShift = 28, /* 256MiB per object */
+    NativeAdrenoMethodQuery = 1,
+    NativeAdrenoMethodBoAlloc = 2,
+    NativeAdrenoMethodBoMap = 3,
+    NativeAdrenoMethodBoFree = 4,
+    NativeAdrenoMethodSubmit = 5,
+    NativeAdrenoMethodWaitFence = 6,
+    NativeAdrenoMethodGetTimestamp = 7,
+    NativeAdrenoMethodGetStatus = 8,
+    NativeAdrenoMethodSetMetadata = 9,
+    NativeAdrenoMethodGetMetadata = 10,
+    NativeAdrenoMethodCreateQueue = 11,
+    NativeAdrenoMethodCloseQueue = 12,
+    NativeAdrenoMethodBoCpuMap = 13,
+    NativeAdrenoMethodBoCpuUnmap = 14,
+    NativeAdrenoMethodGetDeviceInfo = 15,
+    NativeAdrenoMethodBoImport = 16,
+    NativeAdrenoAbiMetadataBytes = 64,
+    NativeAdrenoAbiMaxQueues = 8
+};
+struct NativeAdrenoAbiParams {
+    uint32_t abi_version;
+    uint32_t input_bits;          /* GPU VA bits below 2^input_bits */
+    uint32_t output_bits;         /* physical address bits */
+    uint32_t flags;               /* NativeAdrenoParamsHostImport or zero */
+    uint64_t max_bo_bytes;
+};
+enum {
+    NativeAdrenoParamsHostImport = 1  /* BoImport pins the caller's own pages (an IOSurface's) as a BO */
+};
+struct NativeAdrenoAbiBoAlloc {
+    uint64_t bytes;               /* 4KiB multiple, <= max_bo_bytes */
+    uint32_t align_log2;          /* 12..24 */
+    uint32_t contiguous;          /* 1 requires one raw physical span */
+};
+struct NativeAdrenoAbiBoAllocReply {
+    uint64_t handle;              /* opaque to userspace, nonzero */
+};
+/* Pins [address, address + bytes) of the CALLING task and makes it a BO (reply: NativeAdrenoAbiBoAllocReply). The pages stay wired
+ * until BoFree; they keep the caller's own CPU mapping and cache mode, so the caller cleans its caches before GPU use and invalidates
+ * them after GPU writes (the GPU maps them non-cacheable). An imported BO has no CPU-map token. */
+struct NativeAdrenoAbiBoImport {
+    uint64_t address;             /* 4KiB aligned */
+    uint64_t bytes;               /* 4KiB multiple, <= max_bo_bytes */
+};
+struct NativeAdrenoAbiBoMap {
+    uint64_t handle;
+    uint64_t iova;                /* 4KiB aligned, inside the mounted aperture */
+    uint32_t permissions;         /* bit0 read, bit1 write; read required */
+    uint32_t writeback;           /* 0 normal non-coherent, 1 WB/WA */
+    uint32_t shareability;        /* 2 outer, 3 inner */
+    uint32_t reserved;            /* zero */
+};
+struct NativeAdrenoAbiBoMapReply {
+    uint64_t iova;
+};
+struct NativeAdrenoAbiBoFree {
+    uint64_t handle;
+};
+struct NativeAdrenoAbiSubmitBuffer {
+    uint64_t handle;
+    uint64_t iova;
+    uint64_t bytes;               /* 4-byte multiple, dword count = bytes/4 */
+};
+struct NativeAdrenoAbiSubmit {
+    uint32_t buffer_count;        /* 1..NativeAdrenoAbiMaxBuffers */
+    uint32_t reserved;            /* zero */
+    uint64_t queue;               /* open queue; 0 is created by open() */
+    uint64_t wait_fence;          /* zero or an earlier fence of this client */
+    uint64_t wait_timeout_ns;     /* used only when wait_fence is nonzero */
+    NativeAdrenoAbiSubmitBuffer buffers[NativeAdrenoAbiMaxBuffers];
+};
+struct NativeAdrenoAbiMetadata {
+    uint64_t handle;              /* object identity */
+    uint32_t bytes;               /* set: length; get: requested capacity */
+    uint32_t reserved;            /* zero */
+    char text[NativeAdrenoAbiMetadataBytes]; /* raw bytes, not NUL terminated */
+};
+struct NativeAdrenoAbiSubmitReply {
+    uint64_t fence;               /* nonzero CP timestamp value */
+};
+struct NativeAdrenoAbiWaitFence {
+    uint64_t fence;
+    uint64_t timeout_ns;          /* 0 polls once */
+};
+struct NativeAdrenoAbiTimestamp {
+    uint64_t ticks;               /* GPU always-on counter value */
+};
+struct NativeAdrenoAbiBoCpuMap {
+    uint64_t handle;
+};
+struct NativeAdrenoAbiBoCpuMapReply {
+    uint32_t token;               /* clientMemoryForType selector */
+    uint32_t reserved;            /* zero */
+    uint64_t bytes;               /* bytes the mapping covers */
+};
+struct NativeAdrenoAbiBoCpuUnmap {
+    uint64_t handle;
+    uint32_t token;               /* exactly the token returned by map */
+    uint32_t reserved;            /* zero */
+};
+struct NativeAdrenoAbiQueue {
+    uint64_t queue;               /* zero for create, an open id for close */
+};
+struct NativeAdrenoAbiQueueReply {
+    uint64_t queue;               /* nonzero id of the created queue */
+};
+struct NativeAdrenoAbiStatus {
+    uint64_t faults;              /* monotonic; change means context lost */
+    uint64_t suspends;            /* monotonic suspend/reset count */
+};
+/* Fixed facts of the mounted GPU that the Vulkan driver needs and cannot derive: all come from the board code, which takes
+ * them from the pinned sources (a6xx catalog, UBWC config, the programmed UCHE ranges), never from a guess. */
+enum {
+    NativeAdrenoDeviceClientIova = 1,     /* flags: the client chooses BO addresses (BoMap iova) */
+    NativeAdrenoDeviceCachedCoherent = 2  /* flags: unused until IO-coherent BO memory exists */
+};
+struct NativeAdrenoAbiDeviceInfo {
+    uint32_t chip_id;             /* ADRENO_CHIPID, e.g. 0x43050a01 */
+    uint32_t gmem_bytes;
+    uint64_t gmem_base;           /* UCHE GMEM window start (GPU address) */
+    uint64_t uche_trap_base;
+    uint64_t va_start;            /* first GPU address the client may map */
+    uint64_t va_size;
+    uint32_t highest_bank_bit;
+    uint32_t ubwc_swizzle;        /* bit0 level 1, bit1 level 2, bit2 level 3 */
+    uint32_t macrotile_mode;      /* 0 four channel, 1 eight channel */
+    uint32_t ubwc_version;        /* encoder version, 4 for UBWC 4.0 */
+    uint32_t flags;
+    uint32_t reserved;            /* zero */
+};
+#if defined(__cplusplus)
+static_assert(sizeof(NativeAdrenoAbiDeviceInfo) == 64, "ABI device info layout");
+static_assert(sizeof(NativeAdrenoAbiParams) == 24, "ABI params layout");
+static_assert(sizeof(NativeAdrenoAbiBoAlloc) == 16, "ABI alloc layout");
+static_assert(sizeof(NativeAdrenoAbiBoMap) == 32, "ABI map layout");
+static_assert(sizeof(NativeAdrenoAbiBoImport) == 16, "ABI import layout");
+static_assert(sizeof(NativeAdrenoAbiSubmitBuffer) == 24, "ABI buffer layout");
+static_assert(sizeof(NativeAdrenoAbiSubmit) == 416, "ABI submit layout");
+static_assert(sizeof(NativeAdrenoAbiBoCpuMap) == 8, "ABI cpu map layout");
+static_assert(sizeof(NativeAdrenoAbiBoCpuMapReply) == 16, "ABI cpu map reply layout");
+static_assert(sizeof(NativeAdrenoAbiBoCpuUnmap) == 16, "ABI cpu unmap layout");
+static_assert(sizeof(NativeAdrenoAbiQueue) == 8, "ABI queue layout");
+static_assert(sizeof(NativeAdrenoAbiQueueReply) == 8, "ABI queue reply layout");
+static_assert(sizeof(NativeAdrenoAbiMetadata) == 80, "ABI metadata layout");
+static_assert(sizeof(NativeAdrenoAbiWaitFence) == 16, "ABI wait layout");
+static_assert(sizeof(NativeAdrenoAbiTimestamp) == 8, "ABI timestamp layout");
+static_assert(sizeof(NativeAdrenoAbiStatus) == 16, "ABI status layout");
+#endif
+#endif
diff --git a/iokit/Kernel/arm/adreno/NativeAdrenoAccelerator.cpp b/iokit/Kernel/arm/adreno/NativeAdrenoAccelerator.cpp
new file mode 100644
index 0000000..7d9302c
--- /dev/null
+++ b/iokit/Kernel/arm/adreno/NativeAdrenoAccelerator.cpp
@@ -0,0 +1,51 @@
+// SPDX-License-Identifier: MIT
+// The registry-visible accelerator for the original Metal discovery (IOServiceMatching("IOAcceleratorES") ->
+// MetalPluginName -> /System/Library/Extensions/<name>.bundle). It derives from the original IOAcceleratorES base exactly as
+// qualified in drivers/NativeMetal/OriginalAcceleratorABI.h: the original base has no operational overrides, so the only
+// virtuals this class adds are newUserClient and the property reads below (diagnostic counting only). Its static initializer
+// is staged out of __mod_init_func and run by the board probe after the original IOGPUFamily kext has loaded, because the
+// parent metaclass does not exist before that. The class is named after the Apple accelerator class on purpose, so original
+// sandbox profiles that name the service class accept the Adreno plugin's open; the Apple AGX kext is never loaded here.
+#include "OriginalAcceleratorABI.h"
+#include <IOKit/IOUserClient.h>
+
+extern "C" IOReturn native_adreno_new_user_client(IOService *,task_t,void *,UInt32,OSDictionary *,IOUserClient **,unsigned);
+extern "C" boolean_t PE_parse_boot_argn(const char *,void *,int);
+extern "C" void native_adreno_note_property_read(const char *);
+
+class AGXAccelerator : public IOAcceleratorES {
+    OSDeclareDefaultStructors(AGXAccelerator)
+public:
+    IOReturn newUserClient(task_t owningTask,void *securityID,UInt32 type,OSDictionary *properties,
+        IOUserClient **handler) APPLE_KEXT_OVERRIDE;
+    OSObject *copyProperty(const OSSymbol *key) const APPLE_KEXT_OVERRIDE;
+    OSObject *copyProperty(const OSString *key) const APPLE_KEXT_OVERRIDE;
+    OSObject *copyProperty(const char *key) const APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndAbstractStructors(IOAcceleratorES, IOService)
+OSDefineMetaClassAndStructors(AGXAccelerator, IOAcceleratorES)
+
+IOReturn AGXAccelerator::newUserClient(task_t owningTask,void *securityID,UInt32 type,OSDictionary *properties,
+    IOUserClient **handler)
+{
+    unsigned limit=40;   /* sheng-gpu-metal-opens: connections ever granted to the plugin (0 = unlimited) */
+    PE_parse_boot_argn("sheng-gpu-metal-opens",&limit,sizeof(limit));
+    return native_adreno_new_user_client(this,owningTask,securityID,type,properties,handler,limit);
+}
+OSObject *AGXAccelerator::copyProperty(const OSSymbol *key) const
+{
+    native_adreno_note_property_read(key?key->getCStringNoCopy():nullptr);
+    return IORegistryEntry::copyProperty(key);
+}
+OSObject *AGXAccelerator::copyProperty(const OSString *key) const
+{
+    native_adreno_note_property_read(key?key->getCStringNoCopy():nullptr);
+    return IORegistryEntry::copyProperty(key);
+}
+OSObject *AGXAccelerator::copyProperty(const char *key) const
+{
+    native_adreno_note_property_read(key);
+    return IORegistryEntry::copyProperty(key);
+}
+extern "C" IOService *native_adreno_accelerator_allocate(void) {return new AGXAccelerator;}
+extern "C" unsigned native_adreno_accelerator_instance_size(void) {return sizeof(AGXAccelerator);}
diff --git a/iokit/Kernel/arm/adreno/NativeAdrenoBoard.cpp b/iokit/Kernel/arm/adreno/NativeAdrenoBoard.cpp
new file mode 100644
index 0000000..66cdce7
--- /dev/null
+++ b/iokit/Kernel/arm/adreno/NativeAdrenoBoard.cpp
@@ -0,0 +1,104 @@
+/* SPDX-License-Identifier: MIT */
+#include "NativeAdrenoBoard.h"
+#include <string.h>
+
+enum { CellBytes = 4 };
+
+static inline uint32_t read_cell_le(const uint8_t *p)
+{
+    return (uint32_t(p[0])) | (uint32_t(p[1]) << 8) | (uint32_t(p[2]) << 16) | (uint32_t(p[3]) << 24);
+}
+
+static inline uint32_t read_cell_be(const uint8_t *p)
+{
+    return (uint32_t(p[0]) << 24) | (uint32_t(p[1]) << 16) | (uint32_t(p[2]) << 8) | uint32_t(p[3]);
+}
+
+static bool parse_cells_le(const uint8_t *at, uint32_t address_cells, uint32_t size_cells, uint64_t *out_base, uint64_t *out_bytes)
+{
+    uint64_t b = 0, s = 0;
+    if (address_cells == 2) {
+        b = (uint64_t)read_cell_le(at) | ((uint64_t)read_cell_le(at + CellBytes) << 32);
+    } else {
+        b = read_cell_le(at);
+    }
+    const uint8_t *at_sz = at + address_cells * CellBytes;
+    if (size_cells == 2) {
+        s = (uint64_t)read_cell_le(at_sz) | ((uint64_t)read_cell_le(at_sz + CellBytes) << 32);
+    } else {
+        s = read_cell_le(at_sz);
+    }
+    if (!s || b + s < b) return false;
+    *out_base = b;
+    *out_bytes = s;
+    return true;
+}
+
+static bool parse_cells_be(const uint8_t *at, uint32_t address_cells, uint32_t size_cells, uint64_t *out_base, uint64_t *out_bytes)
+{
+    uint64_t b = 0, s = 0;
+    for (uint32_t cell = 0; cell < address_cells; ++cell) {
+        if (b >> 32) return false;
+        b = (b << 32) | read_cell_be(at + cell * CellBytes);
+    }
+    const uint8_t *at_sz = at + address_cells * CellBytes;
+    for (uint32_t cell = 0; cell < size_cells; ++cell) {
+        if (s >> 32) return false;
+        s = (s << 32) | read_cell_be(at_sz + cell * CellBytes);
+    }
+    if (!s || b + s < b) return false;
+    *out_base = b;
+    *out_bytes = s;
+    return true;
+}
+
+IOReturn NativeAdrenoBoard::parseIommus(const uint8_t *cells, size_t length,
+    uint32_t cells_per_entry, uint16_t *stream_ids, size_t capacity, size_t *count)
+{
+    if (!count) return kIOReturnBadArgument;
+    *count = 0;
+    if (!cells || !length || cells_per_entry < 1 || cells_per_entry > 4)
+        return kIOReturnBadArgument;
+    const size_t per_entry = (1 + cells_per_entry) * (size_t)CellBytes;
+    if (length % per_entry) return kIOReturnBadArgument;
+    const size_t total = length / per_entry;
+    if (!stream_ids || total > capacity) return kIOReturnNoResources;
+    for (size_t index = 0; index < total; ++index) {
+        const uint8_t *at = cells + index * per_entry;
+        uint32_t phandle = read_cell_le(at);
+        uint32_t sid = read_cell_le(at + CellBytes);
+        if (!phandle) {
+            phandle = read_cell_be(at);
+            sid = read_cell_be(at + CellBytes);
+        }
+        if (!phandle || sid > 0xffffu) return kIOReturnBadArgument;
+        stream_ids[index] = static_cast<uint16_t>(sid);
+    }
+    *count = total;
+    return kIOReturnSuccess;
+}
+
+IOReturn NativeAdrenoBoard::parseReg(const uint8_t *cells, size_t length,
+    uint32_t address_cells, uint32_t size_cells, NativeAdrenoWindow *windows,
+    size_t capacity, size_t *count)
+{
+    if (!count) return kIOReturnBadArgument;
+    *count = 0;
+    if (!cells || !length || (address_cells < 1 || address_cells > 2) ||
+        (size_cells < 1 || size_cells > 2)) return kIOReturnBadArgument;
+    const size_t per_window = (address_cells + size_cells) * (size_t)CellBytes;
+    if (length % per_window) return kIOReturnBadArgument;
+    const size_t total = length / per_window;
+    if (total > capacity || !windows) return kIOReturnNoResources;
+    for (size_t index = 0; index < total; ++index) {
+        const uint8_t *at = cells + index * per_window;
+        uint64_t base = 0, bytes = 0;
+        if (!parse_cells_le(at, address_cells, size_cells, &base, &bytes) &&
+            !parse_cells_be(at, address_cells, size_cells, &base, &bytes)) {
+            return kIOReturnBadArgument;
+        }
+        windows[index] = {base, bytes};
+    }
+    *count = total;
+    return kIOReturnSuccess;
+}
diff --git a/iokit/Kernel/arm/adreno/NativeAdrenoBoard.h b/iokit/Kernel/arm/adreno/NativeAdrenoBoard.h
new file mode 100644
index 0000000..e22b36f
--- /dev/null
+++ b/iokit/Kernel/arm/adreno/NativeAdrenoBoard.h
@@ -0,0 +1,32 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_BOARD_H
+#define NATIVE_ADRENO_BOARD_H
+#include <IOKit/IOTypes.h>
+#include <stddef.h>
+#include <stdint.h>
+
+/* Device-tree memory-window parsing for an Adreno platform node. Cells are
+ * big-endian 32-bit as stored in the flattened device tree; the caller passes
+ * the raw property bytes and the node's own #address-cells/#size-cells.
+ * Only 1 or 2 cells per value are accepted, zero-length windows and any
+ * address/size overflow are refused, and the output count is the exact number
+ * of complete windows. This parses only; it does not map, claim, power or
+ * validate that the addresses belong to a GPU. */
+struct NativeAdrenoWindow {
+    uint64_t base;
+    uint64_t bytes;
+};
+enum { NativeAdrenoMaxWindows = 8 };
+class NativeAdrenoBoard final {
+    NativeAdrenoBoard()=delete;
+public:
+    /* Parse a device's `iommus` property. Each entry is one phandle cell
+     * followed by #iommu-cells specifier cells; the first specifier cell is the
+     * stream ID on this platform. Output keeps property order and never writes
+     * on failure. Only the SID is extracted, never a guessed context bank. */
+    static IOReturn parseIommus(const uint8_t *cells,size_t length,
+        uint32_t cells_per_entry,uint16_t *stream_ids,size_t capacity,size_t *count);
+    static IOReturn parseReg(const uint8_t *cells,size_t length,uint32_t address_cells,
+        uint32_t size_cells,NativeAdrenoWindow *windows,size_t capacity,size_t *count);
+};
+#endif
diff --git a/iokit/Kernel/arm/adreno/NativeAdrenoClient.cpp b/iokit/Kernel/arm/adreno/NativeAdrenoClient.cpp
new file mode 100644
index 0000000..3bf4449
--- /dev/null
+++ b/iokit/Kernel/arm/adreno/NativeAdrenoClient.cpp
@@ -0,0 +1,191 @@
+/* SPDX-License-Identifier: MIT */
+#include "NativeAdrenoClient.h"
+#include <IOKit/IOReturn.h>
+#include <string.h>
+IOReturn NativeAdrenoClient::open(const NativeAdrenoTransport *transport)
+{
+    if(open_ || transport_.call)return kIOReturnBusy;
+    if(!transport || !transport->call)return kIOReturnBadArgument;
+    transport_=*transport;
+    NativeAdrenoAbiParams reply{};
+    const IOReturn status=transport_.call(transport_.cookie,NativeAdrenoMethodQuery,
+        nullptr,0,&reply,sizeof(reply));
+    if(status) {transport_={};return status;}
+    if(reply.abi_version!=NativeAdrenoAbiVersion || reply.input_bits<32 ||
+        reply.input_bits>48 || reply.output_bits<32 || reply.output_bits>48 ||
+        !reply.max_bo_bytes || (reply.flags&~uint32_t(NativeAdrenoParamsHostImport))) {transport_={};return kIOReturnUnsupported;}
+    params_=reply;open_=true;
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoClient::close()
+{
+    if(!open_)return kIOReturnNotReady;
+    open_=false;transport_={};params_={};
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoClient::query(NativeAdrenoAbiParams *params)
+{
+    if(!params)return kIOReturnBadArgument;*params={};
+    if(!open_)return kIOReturnNotReady;
+    *params=params_;
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoClient::allocBo(uint64_t bytes,uint32_t align_log2,bool contiguous,
+    uint64_t *handle)
+{
+    if(!handle)return kIOReturnBadArgument;*handle=0;
+    if(!open_)return kIOReturnNotReady;
+    if(!bytes || (bytes&4095) || bytes>params_.max_bo_bytes || align_log2<12 ||
+        align_log2>24)return kIOReturnBadArgument;
+    NativeAdrenoAbiBoAlloc request{bytes,align_log2,contiguous?1u:0u};
+    NativeAdrenoAbiBoAllocReply reply{};
+    const IOReturn status=transport_.call(transport_.cookie,NativeAdrenoMethodBoAlloc,
+        &request,sizeof(request),&reply,sizeof(reply));
+    if(!status)*handle=reply.handle;
+    return status;
+}
+IOReturn NativeAdrenoClient::mapBo(uint64_t handle,uint64_t iova,uint32_t permissions,
+    uint32_t writeback,uint32_t shareability,uint64_t *mapped)
+{
+    if(!mapped)return kIOReturnBadArgument;*mapped=0;
+    if(!open_)return kIOReturnNotReady;
+    if(!handle || iova&4095)return kIOReturnBadArgument;
+    NativeAdrenoAbiBoMap request{handle,iova,permissions,writeback,shareability,0};
+    NativeAdrenoAbiBoMapReply reply{};
+    const IOReturn status=transport_.call(transport_.cookie,NativeAdrenoMethodBoMap,
+        &request,sizeof(request),&reply,sizeof(reply));
+    if(!status)*mapped=reply.iova;
+    return status;
+}
+IOReturn NativeAdrenoClient::freeBo(uint64_t handle)
+{
+    if(!open_)return kIOReturnNotReady;
+    if(!handle)return kIOReturnBadArgument;
+    NativeAdrenoAbiBoFree request{handle};
+    return transport_.call(transport_.cookie,NativeAdrenoMethodBoFree,&request,
+        sizeof(request),nullptr,0);
+}
+IOReturn NativeAdrenoClient::submit(const NativeAdrenoAbiSubmitBuffer *buffers,size_t count,
+    uint64_t wait_fence,uint64_t wait_timeout_ns,uint64_t *fence,uint64_t queue)
+{
+    if(!fence)return kIOReturnBadArgument;*fence=0;
+    if(!open_)return kIOReturnNotReady;
+    if(!buffers || !count || count>NativeAdrenoAbiMaxBuffers)return kIOReturnBadArgument;
+    NativeAdrenoAbiSubmit request{};
+    request.buffer_count=(uint32_t)count;
+    request.queue=queue;
+    request.wait_fence=wait_fence;
+    request.wait_timeout_ns=wait_timeout_ns;
+    for(size_t i=0;i<count;++i)request.buffers[i]=buffers[i];
+    NativeAdrenoAbiSubmitReply reply{};
+    const IOReturn status=transport_.call(transport_.cookie,NativeAdrenoMethodSubmit,
+        &request,sizeof(request),&reply,sizeof(reply));
+    if(!status)*fence=reply.fence;
+    return status;
+}
+IOReturn NativeAdrenoClient::waitFence(uint64_t fence,uint64_t timeout_ns)
+{
+    if(!open_)return kIOReturnNotReady;
+    NativeAdrenoAbiWaitFence request{fence,timeout_ns};
+    return transport_.call(transport_.cookie,NativeAdrenoMethodWaitFence,&request,
+        sizeof(request),nullptr,0);
+}
+IOReturn NativeAdrenoClient::deviceInfo(NativeAdrenoAbiDeviceInfo *info)
+{
+    if(!info)return kIOReturnBadArgument;*info={};
+    if(!open_)return kIOReturnNotReady;
+    NativeAdrenoAbiDeviceInfo reply{};
+    const IOReturn status=transport_.call(transport_.cookie,NativeAdrenoMethodGetDeviceInfo,
+        nullptr,0,&reply,sizeof(reply));
+    if(!status)*info=reply;
+    return status;
+}
+IOReturn NativeAdrenoClient::timestamp(uint64_t *ticks)
+{
+    if(!ticks)return kIOReturnBadArgument;*ticks=0;
+    if(!open_)return kIOReturnNotReady;
+    NativeAdrenoAbiTimestamp reply{};
+    const IOReturn status=transport_.call(transport_.cookie,NativeAdrenoMethodGetTimestamp,
+        nullptr,0,&reply,sizeof(reply));
+    if(!status)*ticks=reply.ticks;
+    return status;
+}
+IOReturn NativeAdrenoClient::status(uint64_t *faults,uint64_t *suspends)
+{
+    if(!faults || !suspends)return kIOReturnBadArgument;
+    *faults=0;*suspends=0;
+    if(!open_)return kIOReturnNotReady;
+    NativeAdrenoAbiStatus reply{};
+    const IOReturn status_value=transport_.call(transport_.cookie,NativeAdrenoMethodGetStatus,
+        nullptr,0,&reply,sizeof(reply));
+    if(!status_value) {*faults=reply.faults;*suspends=reply.suspends;}
+    return status_value;
+}
+IOReturn NativeAdrenoClient::cpuMap(uint64_t handle,uint32_t *token,uint64_t *bytes)
+{
+    if(!token || !bytes)return kIOReturnBadArgument;*token=0;*bytes=0;
+    if(!open_)return kIOReturnNotReady;
+    if(!handle)return kIOReturnBadArgument;
+    NativeAdrenoAbiBoCpuMap request{handle};
+    NativeAdrenoAbiBoCpuMapReply reply{};
+    const IOReturn status=transport_.call(transport_.cookie,NativeAdrenoMethodBoCpuMap,
+        &request,sizeof(request),&reply,sizeof(reply));
+    if(!status) {*token=reply.token;*bytes=reply.bytes;}
+    return status;
+}
+IOReturn NativeAdrenoClient::cpuUnmap(uint64_t handle,uint32_t token)
+{
+    if(!open_)return kIOReturnNotReady;
+    if(!handle || !token)return kIOReturnBadArgument;
+    NativeAdrenoAbiBoCpuUnmap request{handle,token,0};
+    return transport_.call(transport_.cookie,NativeAdrenoMethodBoCpuUnmap,&request,
+        sizeof(request),nullptr,0);
+}
+IOReturn NativeAdrenoClient::createQueue(uint64_t *queue)
+{
+    if(!queue)return kIOReturnBadArgument;*queue=0;
+    if(!open_)return kIOReturnNotReady;
+    NativeAdrenoAbiQueue request{0};
+    NativeAdrenoAbiQueueReply reply{};
+    const IOReturn status=transport_.call(transport_.cookie,NativeAdrenoMethodCreateQueue,
+        &request,sizeof(request),&reply,sizeof(reply));
+    if(!status)*queue=reply.queue;
+    return status;
+}
+IOReturn NativeAdrenoClient::closeQueue(uint64_t queue)
+{
+    if(!open_)return kIOReturnNotReady;
+    if(!queue)return kIOReturnBadArgument;
+    NativeAdrenoAbiQueue request{queue};
+    return transport_.call(transport_.cookie,NativeAdrenoMethodCloseQueue,&request,
+        sizeof(request),nullptr,0);
+}
+IOReturn NativeAdrenoClient::setMetadata(uint64_t handle,const void *bytes,uint32_t length)
+{
+    if(!open_)return kIOReturnNotReady;
+    if(!handle || length>NativeAdrenoAbiMetadataBytes || (length && !bytes))
+        return kIOReturnBadArgument;
+    NativeAdrenoAbiMetadata request{};
+    request.handle=handle;request.bytes=length;
+    if(length)memcpy(request.text,bytes,length);
+    return transport_.call(transport_.cookie,NativeAdrenoMethodSetMetadata,&request,
+        sizeof(request),nullptr,0);
+}
+IOReturn NativeAdrenoClient::getMetadata(uint64_t handle,void *out,uint32_t capacity,
+    uint32_t *length)
+{
+    if(!length)return kIOReturnBadArgument;*length=0;
+    if(!open_)return kIOReturnNotReady;
+    if(!handle || capacity>NativeAdrenoAbiMetadataBytes || (capacity && !out))
+        return kIOReturnBadArgument;
+    NativeAdrenoAbiMetadata request{};
+    request.handle=handle;request.bytes=capacity;
+    NativeAdrenoAbiMetadata reply{};
+    const IOReturn status=transport_.call(transport_.cookie,NativeAdrenoMethodGetMetadata,
+        &request,sizeof(request),&reply,sizeof(reply));
+    if(status)return status;
+    if(reply.bytes>capacity)return kIOReturnBadArgument;
+    if(reply.bytes && out)memcpy(out,reply.text,reply.bytes);
+    *length=reply.bytes;
+    return kIOReturnSuccess;
+}
diff --git a/iokit/Kernel/arm/adreno/NativeAdrenoClient.h b/iokit/Kernel/arm/adreno/NativeAdrenoClient.h
new file mode 100644
index 0000000..0645c92
--- /dev/null
+++ b/iokit/Kernel/arm/adreno/NativeAdrenoClient.h
@@ -0,0 +1,52 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_CLIENT_H
+#define NATIVE_ADRENO_CLIENT_H
+#include "NativeAdrenoABI.h"
+#include <IOKit/IOTypes.h>
+#include <stddef.h>
+#include <stdint.h>
+
+/* Userspace side of the wire ABI. The transport is injected so the same client
+ * can drive an IOKit connection later and the kernel dispatch core during host
+ * qualification. Records are built and checked here at their exact fixed size;
+ * malformed counts are refused before any transport call. The client stores
+ * only the last reported parameters and never caches object identity. */
+struct NativeAdrenoTransport {
+    void *cookie;
+    IOReturn (*call)(void *cookie,uint32_t method,const void *input,size_t input_size,
+        void *output,size_t output_size);
+};
+class NativeAdrenoClient final {
+    NativeAdrenoTransport transport_{};
+    NativeAdrenoAbiParams params_{};
+    bool open_=false;
+public:
+    NativeAdrenoClient()=default;
+    ~NativeAdrenoClient()=default;
+    NativeAdrenoClient(const NativeAdrenoClient &)=delete;
+    NativeAdrenoClient &operator=(const NativeAdrenoClient &)=delete;
+    /* Queries the kernel and refuses a version or capability mismatch. */
+    IOReturn open(const NativeAdrenoTransport *);
+    IOReturn close();
+    IOReturn query(NativeAdrenoAbiParams *);
+    IOReturn allocBo(uint64_t bytes,uint32_t align_log2,bool contiguous,uint64_t *handle);
+    IOReturn mapBo(uint64_t handle,uint64_t iova,uint32_t permissions,uint32_t writeback,
+        uint32_t shareability,uint64_t *mapped);
+    IOReturn freeBo(uint64_t handle);
+    /* buffers are the caller's own array; the fixed record is assembled here. */
+    IOReturn submit(const NativeAdrenoAbiSubmitBuffer *buffers,size_t count,
+        uint64_t wait_fence,uint64_t wait_timeout_ns,uint64_t *fence,uint64_t queue=0);
+    IOReturn waitFence(uint64_t fence,uint64_t timeout_ns);
+    IOReturn timestamp(uint64_t *ticks);
+    IOReturn status(uint64_t *faults,uint64_t *suspends);
+    IOReturn deviceInfo(NativeAdrenoAbiDeviceInfo *);
+    IOReturn createQueue(uint64_t *queue);
+    IOReturn cpuMap(uint64_t handle,uint32_t *token,uint64_t *bytes);
+    IOReturn cpuUnmap(uint64_t handle,uint32_t token);
+    IOReturn closeQueue(uint64_t queue);
+    IOReturn setMetadata(uint64_t handle,const void *,uint32_t bytes);
+    IOReturn getMetadata(uint64_t handle,void *out,uint32_t capacity,uint32_t *length);
+    bool isOpen() const {return open_;}
+    const NativeAdrenoAbiParams &info() const {return params_;}
+};
+#endif
diff --git a/iokit/Kernel/arm/adreno/NativeAdrenoCpInit.cpp b/iokit/Kernel/arm/adreno/NativeAdrenoCpInit.cpp
new file mode 100644
index 0000000..dd6e92b
--- /dev/null
+++ b/iokit/Kernel/arm/adreno/NativeAdrenoCpInit.cpp
@@ -0,0 +1,95 @@
+/* SPDX-License-Identifier: MIT */
+#include "NativeAdrenoCpInit.h"
+#include "AdrenoPM4.h"
+#include <IOKit/IOLib.h>
+
+/* Pinned definitions: CP_SQE_INSTR_BASE is the 64-bit register at dword offset
+ * 0x0830 for A6XX..A7XX (a6xx.xml). CP_THREAD_CONTROL is opcode 0x17 with
+ * CONCURRENT_BIN_DISABLE at bit 27, and CP_ME_INIT is opcode 0x48 with seven
+ * payload words on A7xx and eight on A6xx (adreno_pm4.xml). */
+enum : uint32_t {
+    CpSqeInstrBase = 0x0830,
+    CpThreadControlOpcode = 0x17,
+    CpMeInitOpcode = 0x48,
+    CpConcurrentBinDisable = 1u << 27,
+    CpInitWords = 10
+};
+
+IOReturn NativeAdrenoCpInit::poison()
+{
+    poisoned_ = true;
+    return kIOReturnIOError;
+}
+
+uint32_t NativeAdrenoCpInit::meInitMask()
+{
+    return (1u << 0) | (1u << 1) | (1u << 3) | (1u << 6) | (1u << 8);
+}
+
+IOReturn NativeAdrenoCpInit::run(const NativeAdrenoRingIo *io, NativeAdrenoRing *ring,
+    const NativeAdrenoCpInitConfig *config, uint32_t *fence)
+{
+    if (!fence) return kIOReturnBadArgument;
+    *fence = 0;
+    if (done_ || poisoned_) return kIOReturnNotReady;
+    if (!io || !io->write32 || !ring || ring->poisoned()) return kIOReturnBadArgument;
+    if (!config || !config->sqe_iova || (config->sqe_iova & 4095) ||
+        config->sqe_iova >= UINT64_C(1) << 48 || !config->pwrup_reglist_iova ||
+        (config->pwrup_reglist_iova & 3) || config->pwrup_reglist_iova >= UINT64_C(1) << 48)
+        return kIOReturnBadArgument;
+    if (config->sqe_base_programmed) {
+        uint32_t lo = 0, hi = 0;
+        if (!io->read32 || io->read32(io->cookie, CpSqeInstrBase, &lo) || io->read32(io->cookie, CpSqeInstrBase + 1, &hi) ||
+            (((uint64_t)hi << 32) | lo) != config->sqe_iova) return poison();
+    } else if (io->write32(io->cookie, CpSqeInstrBase, (uint32_t)config->sqe_iova) ||
+        io->write32(io->cookie, CpSqeInstrBase + 1, (uint32_t)(config->sqe_iova >> 32)))
+        return poison();
+    uint32_t words[CpInitWords] = {0};
+    if (AdrenoPM4Type7(CpThreadControlOpcode, 1, &words[0]) != AdrenoPM4Success ||
+        AdrenoPM4Type7(CpMeInitOpcode, 7, &words[2]) != AdrenoPM4Success) return poison();
+    words[1] = CpConcurrentBinDisable;
+    words[3] = meInitMask();
+    words[4] = 0x00000003;      /* hardware contexts */
+    words[5] = 0x20000000;      /* error detection */
+    words[6] = 0x00000002;      /* operation mode */
+    words[7] = (uint32_t)config->pwrup_reglist_iova;
+    words[8] = (uint32_t)(config->pwrup_reglist_iova >> 32);
+    words[9] = 1u << 31;          /* read registers from the list */
+    uint32_t value = 0;
+    const IOReturn status = ring->submit(words, CpInitWords, &value);
+    if (status) return poison();
+    done_ = true;
+    *fence = value;
+    return kIOReturnSuccess;
+}
+
+IOReturn NativeAdrenoCpInit::runA6xx(const NativeAdrenoRingIo *io, NativeAdrenoRing *ring,
+    uint64_t sqe_iova, uint32_t *fence)
+{
+    if (!fence) return kIOReturnBadArgument;
+    *fence = 0;
+    if (done_ || poisoned_) return kIOReturnNotReady;
+    if (!io || !ring || ring->poisoned()) return kIOReturnBadArgument;
+    if (!sqe_iova || (sqe_iova & 4095) || sqe_iova >= (UINT64_C(1) << 48))
+        return kIOReturnBadArgument;
+
+    /* On A6xx, a6xx_cp_init submits CP_ME_INIT with 8 words (total 9 PM4 words) */
+    uint32_t words[9] = {0};
+    if (AdrenoPM4Type7(CpMeInitOpcode, 8, &words[0]) != AdrenoPM4Success)
+        return poison();
+    words[1] = 0x0000002f;
+    words[2] = 0x00000003; /* hardware contexts */
+    words[3] = 0x20000000; /* error detection */
+    words[4] = 0;          /* don't enable header dump */
+    words[5] = 0;
+    words[6] = 0;          /* no workarounds */
+    words[7] = 0;          /* padding */
+    words[8] = 0;
+
+    uint32_t value = 0;
+    const IOReturn status = ring->submit(words, 9, &value);
+    if (status) return poison();
+    done_ = true;
+    *fence = value;
+    return kIOReturnSuccess;
+}
diff --git a/iokit/Kernel/arm/adreno/NativeAdrenoCpInit.h b/iokit/Kernel/arm/adreno/NativeAdrenoCpInit.h
new file mode 100644
index 0000000..bfd2884
--- /dev/null
+++ b/iokit/Kernel/arm/adreno/NativeAdrenoCpInit.h
@@ -0,0 +1,41 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_CPINIT_H
+#define NATIVE_ADRENO_CPINIT_H
+#include "NativeAdrenoRing.h"
+
+struct NativeAdrenoCpInitConfig {
+    uint64_t sqe_iova;             /* CP_SQE_INSTR_BASE, 4 KiB aligned, nonzero */
+    uint64_t pwrup_reglist_iova;   /* Power-up register list, 4-byte aligned */
+    /* Nonzero when the caller already wrote CP_SQE_INSTR_BASE before CP_SQE_CNTL, as a6xx hw_init does: the base is
+     * then read back and compared instead of rewritten after the SQE started. */
+    uint32_t sqe_base_programmed;
+};
+
+/*
+ * One-shot Adreno command-processor start sequence:
+ * - A7xx: CP_THREAD_CONTROL (concurrent binning disable) + CP_ME_INIT (7 words with pwrup list)
+ * - A6xx (A618): CP_ME_INIT opcode 0x48 (8 words)
+ */
+class NativeAdrenoCpInit final {
+    bool done_ = false, poisoned_ = false;
+    IOReturn poison();
+public:
+    NativeAdrenoCpInit() = default;
+    ~NativeAdrenoCpInit() = default;
+    NativeAdrenoCpInit(const NativeAdrenoCpInit &) = delete;
+    NativeAdrenoCpInit &operator=(const NativeAdrenoCpInit &) = delete;
+
+    /* A7xx initialization sequence */
+    IOReturn run(const NativeAdrenoRingIo *io, NativeAdrenoRing *ring,
+                 const NativeAdrenoCpInitConfig *config, uint32_t *fence);
+
+    /* A6xx / A618 initialization sequence */
+    IOReturn runA6xx(const NativeAdrenoRingIo *io, NativeAdrenoRing *ring,
+                     uint64_t sqe_iova, uint32_t *fence);
+
+    bool completed() const { return done_; }
+    bool poisoned() const { return poisoned_; }
+    static uint32_t meInitMask();
+};
+
+#endif
diff --git a/iokit/Kernel/arm/adreno/NativeAdrenoCpu.cpp b/iokit/Kernel/arm/adreno/NativeAdrenoCpu.cpp
new file mode 100644
index 0000000..4b5d429
--- /dev/null
+++ b/iokit/Kernel/arm/adreno/NativeAdrenoCpu.cpp
@@ -0,0 +1,152 @@
+/* SPDX-License-Identifier: MIT */
+#include "NativeAdrenoMemory.h"
+#include <kern/cpu_data.h>
+#include <vm/vm_map.h>
+#include <mach/vm_param.h>
+#include <kern/clock.h>
+#include <vm/memory_types.h>
+extern "C" vm_offset_t phystokv(uint64_t pa);
+extern "C" uint64_t gPhysBase,gPhysSize;   /* the physical range phystokv covers (the kernel's own DRAM); anything else panics in phystokv */
+extern "C" void pmap_set_cache_attributes(ppnum_t pn,unsigned int cacheattr);
+extern "C" unsigned int pmap_cache_attributes(ppnum_t pn);
+/* Time and bytes of every CPU cache maintenance pass (the board page shows them per submission), and the pages user BOs made
+ * write-combined: [0] ticks, [1] bytes, [2] longest pass in ticks, [3] passes, [4] write-combined pages now. */
+extern "C" {volatile uint64_t native_adreno_cache_stats[5];}
+/* Time spent checking and re-asserting write-combined page attributes (NativeAdrenoReassertWriteCombined), for the board page. */
+extern "C" {volatile uint64_t native_adreno_reassert_ticks;}
+static void noteMaintenance(uint64_t began,size_t bytes)
+{
+    const uint64_t ticks=mach_absolute_time()-began;
+    __atomic_fetch_add(&native_adreno_cache_stats[0],ticks,__ATOMIC_RELAXED);
+    __atomic_fetch_add(&native_adreno_cache_stats[1],bytes,__ATOMIC_RELAXED);
+    __atomic_fetch_add(&native_adreno_cache_stats[3],1,__ATOMIC_RELAXED);
+    uint64_t longest=__atomic_load_n(&native_adreno_cache_stats[2],__ATOMIC_RELAXED);
+    while(ticks>longest && !__atomic_compare_exchange_n(&native_adreno_cache_stats[2],&longest,ticks,true,__ATOMIC_RELAXED,__ATOMIC_RELAXED)) {}
+}
+
+IOReturn NativeAdrenoQueryCpu4K(NativeAdrenoCpuState *out)
+{
+    if(!out)return kIOReturnBadArgument;
+    *out={};
+    disable_preemption();
+    __asm__ volatile("mrs %0, tcr_el1" : "=r"(out->tcr));
+    __asm__ volatile("mrs %0, ttbr0_el1" : "=r"(out->ttbr0));
+    __asm__ volatile("mrs %0, ttbr1_el1" : "=r"(out->ttbr1));
+    __asm__ volatile("mrs %0, sctlr_el1" : "=r"(out->sctlr));
+    out->kernel_page_bytes=page_size;
+    out->kernel_map_page_bytes=vm_map_page_size(kernel_map);
+    enable_preemption();
+    /* The CPU granule may be 4 KiB or 16 KiB (Sweet's XNU runs 16 KiB); the GPU side is always 4 KiB through its own SMMU tables. */
+    const bool granule4k=out->kernel_page_bytes==4096 && out->kernel_map_page_bytes==4096 &&
+        ((out->tcr>>14)&3)==0 && ((out->tcr>>30)&3)==2;
+    const bool granule16k=out->kernel_page_bytes==16384 && out->kernel_map_page_bytes==16384;
+    bool native=(granule4k || granule16k) &&
+        (out->sctlr&1) && (out->ttbr1&UINT64_C(0x0000fffffffff000));
+    return native?kIOReturnSuccess:kIOReturnUnsupported;
+}
+static IOReturn maintainOwnedPages(void *mapping,size_t bytes,NativeAdrenoCacheOperation op)
+{
+    /* Whole owned pages avoid IVAC corruption of a neighbour's dirty line.
+     * No Apple coherent-I/O shortcut is used for these noncoherent DMA paths.
+     * Pin this CPU while reading its CTR and issuing all cache operations. */
+    if(!mapping || !bytes || (((uintptr_t)mapping|bytes)&4095) ||
+        bytes>UINTPTR_MAX-(uintptr_t)mapping || op>NativeAdrenoInvalidate || op<NativeAdrenoClean)
+        return kIOReturnBadArgument;
+    disable_preemption();
+    uint64_t ctr;__asm__ volatile("mrs %0, ctr_el0":"=r"(ctr));
+    size_t line=(size_t)4<<((ctr>>16)&15);
+    if(line>4096) {enable_preemption();return kIOReturnUnsupported;}
+    uintptr_t address=(uintptr_t)mapping,end=address+bytes;
+    __asm__ volatile("dsb sy":::"memory");
+    for(;address<end;address+=line) {
+        if(op==NativeAdrenoClean)__asm__ volatile("dc cvac, %0"::"r"(address):"memory");
+        else if(op==NativeAdrenoCleanInvalidate)__asm__ volatile("dc civac, %0"::"r"(address):"memory");
+        else __asm__ volatile("dc ivac, %0"::"r"(address):"memory");
+    }
+    __asm__ volatile("dsb sy":::"memory");
+    enable_preemption();return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoMaintainOwnedPages(void *mapping,size_t bytes,NativeAdrenoCacheOperation op)
+{
+    const uint64_t began=mach_absolute_time();
+    const IOReturn status=maintainOwnedPages(mapping,bytes,op);
+    if(!status)noteMaintenance(began,bytes);
+    return status;
+}
+IOReturn NativeAdrenoMaintainPhysicalPages(uint64_t physical,size_t bytes,NativeAdrenoCacheOperation op)
+{
+    if(!physical || !bytes || ((physical|bytes)&4095) || physical>UINT64_MAX-bytes || op>NativeAdrenoInvalidate || op<NativeAdrenoClean)
+        return kIOReturnBadArgument;
+    const uint64_t began=mach_absolute_time();
+    /* One barrier pair per run of up to 64 pages instead of per page (an imported 3048x2032 surface is 5952 pages): preemption stays off
+     * for a bounded run, and the closing DSB on the issuing core completes every operation of that run. */
+    for(size_t offset=0;offset<bytes;) {
+        disable_preemption();
+        uint64_t ctr;__asm__ volatile("mrs %0, ctr_el0":"=r"(ctr));
+        const size_t line=(size_t)4<<((ctr>>16)&15);
+        if(line>4096) {enable_preemption();return kIOReturnUnsupported;}
+        __asm__ volatile("dsb sy":::"memory");
+        for(unsigned run=0;run<64 && offset<bytes;++run,offset+=4096) {
+            /* A page outside the kernel's DRAM is device memory (the firmware framebuffer the display hand-off imports): the CPU maps it
+             * uncached (kIOMapInhibitCache), no cache line of it exists to maintain, and phystokv would panic on it (int-080: illegal PA
+             * 0xb8000000). */
+            const uint64_t page=physical+offset;
+            if(page<gPhysBase || page-gPhysBase>=gPhysSize)continue;
+            const vm_offset_t alias=phystokv(page);
+            if(!alias) {__asm__ volatile("dsb sy":::"memory");enable_preemption();return kIOReturnUnsupported;}
+            for(uintptr_t address=alias,end=alias+4096;address<end;address+=line) {
+                if(op==NativeAdrenoClean)__asm__ volatile("dc cvac, %0"::"r"(address):"memory");
+                else if(op==NativeAdrenoCleanInvalidate)__asm__ volatile("dc civac, %0"::"r"(address):"memory");
+                else __asm__ volatile("dc ivac, %0"::"r"(address):"memory");
+            }
+        }
+        __asm__ volatile("dsb sy":::"memory");
+        enable_preemption();
+    }
+    noteMaintenance(began,bytes);
+    return kIOReturnSuccess;
+}
+/* A user BO's pages become Normal non-cacheable (write-combined) for every CPU mapping the pmap tracks: the kernel's own mapping and each
+ * client view. The views did not get the cache mode their mapping asked for (int-070: Turnip's write-combine view left IB words in a CPU
+ * cache line), but they do take the page's own attribute. That is the Linux msm model for its WC BOs: CPU writes reach DRAM, the GPU's
+ * non-cacheable reads see them and CPU reads see GPU writes without per-submission maintenance. The physical aperture keeps its cacheable
+ * block mapping on this kernel (no __ARM_PTE_PHYSMAP__); nothing writes through it, and the caller cleans and invalidates the pages first.
+ * Before the pages go back to the VM they get the default attribute again. */
+IOReturn NativeAdrenoSetPagesCacheMode(const NativeAdrenoPhysicalSpan *spans,size_t count,bool write_combined)
+{
+    if(!spans || !count)return kIOReturnBadArgument;
+    uint64_t pages=0;
+    for(size_t i=0;i<count;++i) {
+        const NativeAdrenoPhysicalSpan &span=spans[i];
+        if(!span.bytes || ((span.physical|span.bytes)&4095) || span.physical>UINT64_MAX-span.bytes ||
+            span.physical<gPhysBase || span.physical+span.bytes-gPhysBase>gPhysSize)return kIOReturnBadArgument;
+        pages+=span.bytes/4096;
+    }
+    for(size_t i=0;i<count;++i) {
+        const uint64_t first=spans[i].physical&~(uint64_t)(PAGE_SIZE-1),end=spans[i].physical+spans[i].bytes;
+        for(uint64_t pa=first;pa<end;pa+=PAGE_SIZE)
+            pmap_set_cache_attributes((ppnum_t)(pa>>PAGE_SHIFT),write_combined?VM_WIMG_WCOMB:VM_WIMG_USE_DEFAULT);
+    }
+    if(write_combined)__atomic_fetch_add(&native_adreno_cache_stats[4],pages,__ATOMIC_RELAXED);
+    else __atomic_fetch_sub(&native_adreno_cache_stats[4],pages,__ATOMIC_RELAXED);
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoReassertWriteCombined(const NativeAdrenoPhysicalSpan *spans,size_t count,uint32_t *reset)
+{
+    if(!spans || !count || !reset)return kIOReturnBadArgument;
+    const uint64_t began=mach_absolute_time();
+    for(size_t i=0;i<count;++i) {
+        const NativeAdrenoPhysicalSpan &span=spans[i];
+        if(!span.bytes || ((span.physical|span.bytes)&4095) || span.physical>UINT64_MAX-span.bytes ||
+            span.physical<gPhysBase || span.physical+span.bytes-gPhysBase>gPhysSize)return kIOReturnBadArgument;
+        const uint64_t first=span.physical&~(uint64_t)(PAGE_SIZE-1),end=span.physical+span.bytes;
+        for(uint64_t pa=first;pa<end;pa+=PAGE_SIZE) {
+            const ppnum_t pn=(ppnum_t)(pa>>PAGE_SHIFT);
+            /* From the default attribute the pmap also cleans and invalidates the page (pmap_sync_wimg), so lines a cacheable view
+             * dirtied reach DRAM before the GPU reads it. */
+            if((pmap_cache_attributes(pn)&VM_WIMG_MASK)!=VM_WIMG_WCOMB) {pmap_set_cache_attributes(pn,VM_WIMG_WCOMB);++*reset;}
+        }
+    }
+    __atomic_fetch_add(&native_adreno_reassert_ticks,mach_absolute_time()-began,__ATOMIC_RELAXED);
+    return kIOReturnSuccess;
+}
diff --git a/iokit/Kernel/arm/adreno/NativeAdrenoFirmware.cpp b/iokit/Kernel/arm/adreno/NativeAdrenoFirmware.cpp
new file mode 100644
index 0000000..9d24dac
--- /dev/null
+++ b/iokit/Kernel/arm/adreno/NativeAdrenoFirmware.cpp
@@ -0,0 +1,18 @@
+/* SPDX-License-Identifier: MIT */
+#include "NativeAdrenoFirmware.h"
+#include "NativeAdrenoSha256.h"
+#include <string.h>
+IOReturn NativeAdrenoFirmware::validate(const uint8_t *image,uint64_t length,
+    const NativeAdrenoFirmwareRules *rules,NativeAdrenoFirmwareView *view)
+{
+    if(!view)return kIOReturnBadArgument;
+    *view={};
+    if(!rules || !image || !length || length!=rules->bytes ||
+        length>uint64_t(SIZE_MAX))return kIOReturnBadArgument;
+    uint8_t digest[32];
+    NativeAdrenoSha256::hash(image,size_t(length),digest);
+    if(memcmp(digest,rules->sha256,32))return kIOReturnIOError;
+    view->bytes=image;view->length=size_t(length);
+    memcpy(view->sha256,digest,32);
+    return kIOReturnSuccess;
+}
diff --git a/iokit/Kernel/arm/adreno/NativeAdrenoFirmware.h b/iokit/Kernel/arm/adreno/NativeAdrenoFirmware.h
new file mode 100644
index 0000000..6b989b6
--- /dev/null
+++ b/iokit/Kernel/arm/adreno/NativeAdrenoFirmware.h
@@ -0,0 +1,27 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_FIRMWARE_H
+#define NATIVE_ADRENO_FIRMWARE_H
+#include <IOKit/IOTypes.h>
+#include <stddef.h>
+#include <stdint.h>
+struct NativeAdrenoFirmwareRules {
