index 0000000..61b8b65
--- /dev/null
+++ b/iokit/Kernel/arm/adreno/NativeAdrenoGmuService.cpp
@@ -0,0 +1,548 @@
+/* SPDX-License-Identifier: MIT */
+/*
+ * NativeAdreno GMU service for Adreno 618 (SM7150 / Sweet).
+ * Discovers the GMU, PDC, and PDC SEQ register windows, maps them,
+ * and executes the full verified A618 cold-start hardware sequence:
+ * clocks, RPMh ARC rails, GDSC, TCM firmware load, PDC/RSCC table,
+ * SMMU CB3 GMU stream routing, CM3 unreset, SPTPRAC, and HFI.
+ */
+#include <IOKit/IODeviceMemory.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <IOKit/IOService.h>
+#include <string.h>
+#include "NativeAdrenoGmuService.h"
+#include "NativeAdrenoMemory.h"
+
+OSDefineMetaClassAndStructors(NativeAdrenoGmuService, IOService)
+
+extern "C" const uint8_t native_adreno_firmware_image[] __attribute__((weak));
+extern "C" const uint64_t native_adreno_firmware_image_size __attribute__((weak));
+
+extern "C" int sweet_log_ready(void) __attribute__((weak));
+extern "C" void sweet_log_sync(void) __attribute__((weak));
+/* Print a step marker and force it onto the persistent log before the step runs: a reset in the step leaves the marker behind. */
+static void gmu_step(const char *name)
+{
+    IOLog("NativeAdrenoGmu: STEP %s\n", name);
+    if (sweet_log_sync) sweet_log_sync();
+}
+extern "C" int sweet_rpmh_arc_set(const char *res, unsigned corner, unsigned *level) __attribute__((weak));
+
+#define GPU_RSCC_BASE           0x00023000
+#define GPU_LOW_SVS             64u
+#define GPU_CX_GDSCR            0x106c
+#define GPU_GX_GDSCR            0x100c
+#define GPU_BRANCH_ENABLE       (1u << 0)
+#define GPU_BRANCH_OFF          (1u << 31)
+#define GPU_DOMAIN_ON           (1u << 31)
+#define GPU_GDSC_SW_COLLAPSE    (1u << 0)
+
+#define GPU_GCC_GPU_GPLL_VOTE   0x52004
+#define GPU_GPLL0_DIV_GATE      (1u << 16)
+#define GPU_GMU_RCG_CMD         0x1120
+#define GPU_GMU_RCG_CFG         0x1124
+#define GPU_GMU_RCG_200MHZ      ((6u << 8) | 2u)
+#define GPU_CC_AHB              0x1078
+#define GPU_CC_CX_GMU           0x1098
+#define GPU_CC_CXO              0x109c
+#define GPU_CBCR_WAKE_SLEEP     ((0xfu << 8) | (0xfu << 4))
+#define GPU_GCC_MEMNOC_GFX      0x7100c
+#define GPU_GCC_DDRSS_GPU_AXI   0x4452c
+
+#define GPU_SMMU_SMR            0x800
+#define GPU_SMMU_S2CR           0xc00
+#define GPU_SMMU_CBAR           0x1000
+#define GPU_SMMU_CBA2R          0x1800
+#define GPU_SMMU_CB0            0x8000
+#define GPU_SMMU_CB_SCTLR       0x00
+#define GPU_SMMU_CB_TCR2        0x10
+#define GPU_SMMU_CB_TTBR0       0x20
+#define GPU_SMMU_CB_TCR         0x30
+#define GPU_SMMU_CB_MAIR0       0x38
+#define GPU_SMMU_CB_MAIR1       0x3c
+#define GPU_SMMU_CB_TLB_SYNC    0x7f0
+#define GPU_SMMU_CB_TLB_STATUS  0x7f4
+#define GPU_SMMU_CB_TLB_INVALL  0x618
+
+#define GPU_SMMU_GMU_SID        5u
+#define GPU_SMMU_GMU_CB         3u
+#define GPU_PTE_TABLE           0x3ull
+#define GPU_PTE_PAGE            (3ull | (1ull << 10) | (3ull << 8) | (1ull << 6) | (1ull << 11) | (1ull << 54))
+
+static const struct { unsigned char region; uint32_t off; uint32_t value; } gpu_rpmh_init[] = {
+    { 0, GPU_RSCC_BASE + 0x0004 * 4, 1u << 24 },          /* disable SDE clock gating */
+    { 0, GPU_RSCC_BASE + 0x000b * 4, 1 },                 /* PDC_SLAVE_ID_DRV0 */
+    { 0, GPU_RSCC_BASE + 0x000e * 4, 0 },                 /* HIDDEN_TCS_CMD0_DATA */
+    { 0, GPU_RSCC_BASE + 0x000d * 4, 0 },                 /* HIDDEN_TCS_CMD0_ADDR */
+    { 0, GPU_RSCC_BASE + 0x0010 * 4, 0 },
+    { 0, GPU_RSCC_BASE + 0x000f * 4, 0 },
+    { 0, GPU_RSCC_BASE + 0x0012 * 4, 0x80000000u },
+    { 0, GPU_RSCC_BASE + 0x0011 * 4, 0 },
+    { 0, GPU_RSCC_BASE + 0x0100 * 4, 0 },                 /* OVERRIDE_START_ADDR */
+    { 0, GPU_RSCC_BASE + 0x0008 * 4, 0x4520 },            /* PDC_SEQ_START_ADDR */
+    { 0, GPU_RSCC_BASE + 0x0009 * 4, 0x4510 },            /* PDC_MATCH_VALUE_LO */
+    { 0, GPU_RSCC_BASE + 0x000a * 4, 0x4514 },            /* PDC_MATCH_VALUE_HI */
+    { 0, GPU_RSCC_BASE + 0x0180 * 4, 0xa7a506a0u },       /* RSC sequencer uCode */
+    { 0, GPU_RSCC_BASE + 0x0181 * 4, 0xa1e6a6e7u },
+    { 0, GPU_RSCC_BASE + 0x0182 * 4, 0xa2e081e1u },
+    { 0, GPU_RSCC_BASE + 0x0183 * 4, 0xe9a982e2u },
+    { 0, GPU_RSCC_BASE + 0x0184 * 4, 0x0020e8a8u },
+    { 2, 0 * 4, 0xfebea1e1u },                            /* PDC sequencer uCode */
+    { 2, 1 * 4, 0xa5a4a3a2u },
+    { 2, 2 * 4, 0x8382a6e0u },
+    { 2, 3 * 4, 0xbce3e284u },
+    { 2, 4 * 4, 0x002081fcu },
+    { 1, 0x1573 * 4, 7 }, { 1, 0x1574 * 4, 0 }, { 1, 0x1572 * 4, 0 },   /* TCS1 (sleep) */
+    { 1, 0x1575 * 4, 0x10108 }, { 1, 0x1576 * 4, 0x30010 }, { 1, 0x1577 * 4, 1 },
+    { 1, 0x1579 * 4, 0x10108 }, { 1, 0x157a * 4, 0x30000 }, { 1, 0x157b * 4, 0 },
+    { 1, 0x157d * 4, 0x10108 }, { 1, 0x157e * 4, 0x30090 }, { 1, 0x157f * 4, 0 },
+    { 1, 0x15d7 * 4, 7 }, { 1, 0x15d8 * 4, 0 }, { 1, 0x15d6 * 4, 0 },   /* TCS3 (wake), A618 data */
+    { 1, 0x15d9 * 4, 0x10108 }, { 1, 0x15da * 4, 0x30010 }, { 1, 0x15db * 4, 2 },
+    { 1, 0x15dd * 4, 0x10108 }, { 1, 0x15de * 4, 0x30000 }, { 1, 0x15df * 4, 2 },
+    { 1, 0x15e1 * 4, 0x10108 }, { 1, 0x15e2 * 4, 0x30090 }, { 1, 0x15e3 * 4, 3 },
+    { 1, 0x1148 * 4, 0 },                                 /* GPU_SEQ_START_ADDR */
+    { 1, 0x1140 * 4, 0x80000001u },                       /* GPU_ENABLE_PDC */
+};
+#define GPU_RPMH_INIT_COUNT (sizeof(gpu_rpmh_init) / sizeof(gpu_rpmh_init[0]))
+
+static inline uint32_t io_read32(volatile uint8_t *base, uint32_t off) {
+    return *reinterpret_cast<volatile uint32_t *>(base + off);
+}
+static inline void io_write32(volatile uint8_t *base, uint32_t off, uint32_t val) {
+    *reinterpret_cast<volatile uint32_t *>(base + off) = val;
+}
+static inline void io_write64(volatile uint8_t *base, uint32_t off, uint64_t val) {
+    *reinterpret_cast<volatile uint64_t *>(base + off) = val;
+}
+
+static bool advertisesGmu(IOService *provider)
+{
+    OSObject *property = provider ? provider->getProperty("compatible") : nullptr;
+    OSData *data = OSDynamicCast(OSData, property);
+    if (!data || !data->getBytesNoCopy() || !data->getLength()) return false;
+    const char *text = static_cast<const char *>(data->getBytesNoCopy());
+    const size_t length = data->getLength();
+    static const char *needles[] = { "qcom,adreno-gmu", "qcom,gpu-gmu" };
+    for (const char *needle : needles) {
+        const size_t needle_len = strlen(needle);
+        for (size_t at = 0; at + needle_len <= length; ++at) {
+            if (strncmp(text + at, needle, needle_len) == 0) return true;
+        }
+    }
+    return false;
+}
+
+IOService *NativeAdrenoGmuService::probe(IOService *provider, SInt32 *score)
+{
+    if (!advertisesGmu(provider)) return nullptr;
+    if (score) *score = 1000;
+    return this;
+}
+
+bool NativeAdrenoGmuService::start(IOService *provider)
+{
+    if (!IOService::start(provider)) return false;
+    OSData *reg = OSDynamicCast(OSData, provider->getProperty("reg"));
+    OSData *address = OSDynamicCast(OSData, provider->getProperty("#address-cells"));
+    OSData *size = OSDynamicCast(OSData, provider->getProperty("#size-cells"));
+    uint32_t address_cells = 2, size_cells = 2;
+    if (address && address->getLength() >= 4)
+        address_cells = *static_cast<const uint32_t *>(address->getBytesNoCopy());
+    if (size && size->getLength() >= 4)
+        size_cells = *static_cast<const uint32_t *>(size->getBytesNoCopy());
+    if (!reg || NativeAdrenoBoard::parseReg(
+        static_cast<const uint8_t *>(reg->getBytesNoCopy()), reg->getLength(),
+        address_cells, size_cells, windows_, NativeAdrenoMaxWindows, &count_) != kIOReturnSuccess) {
+        IOLog("NativeAdrenoGmu: reg windows are not usable\n");
+        count_ = 0;
+        IOService::stop(provider);
+        return false;
+    }
+    for (size_t index = 0; index < count_; ++index) {
+        IODeviceMemory *memory = provider ? provider->getDeviceMemoryWithIndex(static_cast<unsigned>(index)) : nullptr;
+        if (!memory) memory = getDeviceMemoryWithIndex(static_cast<unsigned>(index));
+        if (!memory) {
+            IOPhysicalAddress fallback_base = 0;
+            IOPhysicalLength fallback_size = 0;
+            if (index == 0) { fallback_base = 0x0506a000; fallback_size = 0x31000; }
+            else if (index == 1) { fallback_base = 0x0b290000; fallback_size = 0x10000; }
+            else if (index == 2) { fallback_base = 0x0b490000; fallback_size = 0x10000; }
+            if (fallback_base) memory = IODeviceMemory::withRange(fallback_base, fallback_size);
+        }
+        if (!memory) {
+            IOLog("NativeAdrenoGmu: window %lu has no device memory\n",
+                static_cast<unsigned long>(index));
+            stop(provider);
+            return false;
+        }
+        maps_[index] = OSSharedPtr<IOMemoryMap>(memory->map(kIOMapAnywhere | kIOMapInhibitCache),
+            OSNoRetain);
+        if (!maps_[index]) {
+            IOLog("NativeAdrenoGmu: window %lu did not map\n",
+                static_cast<unsigned long>(index));
+            stop(provider);
+            return false;
+        }
+    }
+
+    OSData *bases = OSData::withCapacity(static_cast<UInt32>(count_ * sizeof(uint64_t)));
+    if (!bases) { stop(provider); return false; }
+    for (size_t index = 0; index < count_; ++index) {
+        const uint64_t base = windows_[index].base;
+        bases->appendBytes(&base, sizeof(base));
+    }
+    setProperty("gmu-window-bases", bases);
+    bases->release();
+
+    IOLog("NativeAdrenoGmu: %lu windows mapped (GMU=0x%llx, PDC=0x%llx, SEQ=0x%llx)\n",
+        static_cast<unsigned long>(count_),
+        count_ > 0 ? static_cast<unsigned long long>(windows_[0].base) : 0,
+        count_ > 1 ? static_cast<unsigned long long>(windows_[1].base) : 0,
+        count_ > 2 ? static_cast<unsigned long long>(windows_[2].base) : 0);
+    registerService();
+    return true;
+}
+
+void NativeAdrenoGmuService::stop(IOService *provider)
+{
+    for (auto &map : maps_) map.reset();
+    count_ = 0;
+    booted_ = false;
+    IOService::stop(provider);
+}
+
+IOReturn NativeAdrenoGmuService::coldStartA618(volatile uint8_t *gcc, volatile uint8_t *cc, volatile uint8_t *smmu,
+                                              uint64_t gmu_buf_pa, void *gmu_buf_kva)
+{
+    if (!gcc || !cc || !smmu || !gmu_buf_pa || !gmu_buf_kva) {
+        IOLog("NativeAdrenoGmu: coldStartA618 invalid arguments\n");
+        return kIOReturnBadArgument;
+    }
+    if (count_ < 3 || !windowAddress(0) || !windowAddress(1) || !windowAddress(2)) {
+        IOLog("NativeAdrenoGmu: coldStartA618 GMU/PDC/SEQ windows not mapped\n");
+        return kIOReturnNotReady;
+    }
+
+    volatile uint8_t *gmu = windowAddress(0);
+    volatile uint8_t *pdc = windowAddress(1);
+    volatile uint8_t *seq = windowAddress(2);
+
+    IOLog("NativeAdrenoGmu: starting A618 cold start sequence\n");
+
+    gmu_step("rpmh-arc-votes");
+    /* 1. RPMh ARC rail votes: MX and CX at LOW_SVS (64) */
+    if (sweet_rpmh_arc_set) {
+        unsigned mx_level = 0, cx_level = 0;
+        int err_mx = sweet_rpmh_arc_set("mx.lvl", GPU_LOW_SVS, &mx_level);
+        int err_cx = sweet_rpmh_arc_set("cx.lvl", GPU_LOW_SVS, &cx_level);
+        if (err_mx || err_cx) {
+            IOLog("NativeAdrenoGmu: RPMh ARC rail vote failed (mx=%d cx=%d)\n", err_mx, err_cx);
+            return kIOReturnIOError;
+        }
+    }
+
+    gmu_step("cx-gdsc-uncollapse");
+    /* 2. CX GDSC power domain uncollapse */
+    uint32_t cx_val = io_read32(cc, GPU_CX_GDSCR);
+    io_write32(cc, GPU_CX_GDSCR, cx_val & ~GPU_GDSC_SW_COLLAPSE);
+    IODelay(1);
+    bool cx_on = false;
+    for (unsigned i = 0; i < 1000; i++) {
+        if (io_read32(cc, GPU_CX_GDSCR) & GPU_DOMAIN_ON) {
+            cx_on = true;
+            break;
+        }
+        IODelay(1);
+    }
+    if (!cx_on) {
+        IOLog("NativeAdrenoGmu: CX PWR_ON did not assert\n");
+        return kIOReturnTimeout;
+    }
+    IODelay(5);
+
+    gmu_step("gpll0-gate-vote");
+    /* 3. GPLL0 divider gate vote */
+    uint32_t gate = io_read32(gcc, GPU_GCC_GPU_GPLL_VOTE);
+    io_write32(gcc, GPU_GCC_GPU_GPLL_VOTE, gate | GPU_GPLL0_DIV_GATE);
+    IODelay(5);
+
+    gmu_step("gmu-rcg-200mhz");
+    /* 4. GMU RCG 200 MHz */
+    uint32_t rcg_cfg = io_read32(cc, GPU_GMU_RCG_CFG);
+    io_write32(cc, GPU_GMU_RCG_CFG, (rcg_cfg & ~((7u << 8) | 0x1fu)) | GPU_GMU_RCG_200MHZ);
+    io_write32(cc, GPU_GMU_RCG_CMD, 1u);
+    bool rcg_ok = false;
+    for (unsigned i = 0; i < 500; i++) {
+        if (!(io_read32(cc, GPU_GMU_RCG_CMD) & 1u)) {
+            rcg_ok = true;
+            break;
+        }
+        IODelay(1);
+    }
+    if (!rcg_ok) {
+        IOLog("NativeAdrenoGmu: GMU RCG update timed out\n");
+        return kIOReturnTimeout;
+    }
+
+    gmu_step("gpucc-branches");
+    /* 5. GPU CC branches */
+    io_write32(cc, GPU_CC_AHB, GPU_BRANCH_ENABLE);
+    io_write32(cc, GPU_CC_CX_GMU, GPU_BRANCH_ENABLE | GPU_CBCR_WAKE_SLEEP);
+    io_write32(cc, GPU_CC_CXO, GPU_BRANCH_ENABLE);
+    for (unsigned i = 0; i < 500; i++) {
+        uint32_t b0 = io_read32(cc, GPU_CC_AHB);
+        uint32_t b1 = io_read32(cc, GPU_CC_CX_GMU);
+        uint32_t b2 = io_read32(cc, GPU_CC_CXO);
+        if (!(b0 & GPU_BRANCH_OFF) && !(b1 & GPU_BRANCH_OFF) && !(b2 & GPU_BRANCH_OFF)) break;
+        IODelay(1);
+    }
+
+    gmu_step("gcc-bus-branches");
+    /* 6. GCC bus branches */
+    io_write32(gcc, GPU_GCC_MEMNOC_GFX, GPU_BRANCH_ENABLE);
+    io_write32(gcc, GPU_GCC_DDRSS_GPU_AXI, GPU_BRANCH_ENABLE);
+    for (unsigned i = 0; i < 500; i++) {
+        uint32_t b3 = io_read32(gcc, GPU_GCC_MEMNOC_GFX);
+        uint32_t b4 = io_read32(gcc, GPU_GCC_DDRSS_GPU_AXI);
+        if (!(b3 & GPU_BRANCH_OFF) && !(b4 & GPU_BRANCH_OFF)) break;
+        IODelay(1);
+    }
+
+    gmu_step("rscc-pdc-table");
+    /* 8. Program 48-entry RSCC / PDC table */
+    volatile uint8_t *bases[3] = { gmu, pdc, seq };
+    for (unsigned i = 0; i < GPU_RPMH_INIT_COUNT; i++) {
+        io_write32(bases[gpu_rpmh_init[i].region], gpu_rpmh_init[i].off, gpu_rpmh_init[i].value);
+    }
+    gmu_step("rscc-stop-handshake");
+    /* RSCC stop handshake */
+    io_write32(gmu, 0x9307 * 4, 1u);
+    bool stop_done = false;
+    for (unsigned i = 0; i < 1000; i++) {
+        if (io_read32(gmu, GPU_RSCC_BASE + 0x0004 * 4) & (1u << 16)) {
+            stop_done = true;
+            break;
+        }
+        IODelay(1);
+    }
+    io_write32(gmu, 0x9307 * 4, 0u);
+    if (!stop_done) {
+        IOLog("NativeAdrenoGmu: RSCC stop handshake timed out\n");
+        return kIOReturnTimeout;
+    }
+
+    gmu_step("rsc-wake");
+    /* Mainline a6xx_gmu_fw_start(): TCM retention, then a6xx_rpmh_start() wakes the RSC before firmware load */
+    io_write32(gmu, 0x14730, 1u);
+    io_write32(gmu, 0x24c1c, 2u);
+    bool wake_ack = false;
+    for (unsigned i = 0; i < 100; i++) {
+        if (io_read32(gmu, 0x24c20) & 2u) { wake_ack = true; break; }
+        IODelay(100);
+    }
+    if (!wake_ack) {
+        io_write32(gmu, 0x24c1c, 0u);
+        IOLog("NativeAdrenoGmu: RSC wake ACK timed out (0x%08x)\n", io_read32(gmu, 0x24c20));
+        return kIOReturnTimeout;
+    }
+    bool seq_idle = false;
+    for (unsigned i = 0; i < 100; i++) {
+        if (io_read32(gmu, 0x23404) == 0) { seq_idle = true; break; }
+        IODelay(100);
+    }
+    io_write32(gmu, 0x24c1c, 0u);
+    if (!seq_idle) {
+        IOLog("NativeAdrenoGmu: RSC sequencer stuck while waking (0x%08x)\n", io_read32(gmu, 0x23404));
+        return kIOReturnTimeout;
+    }
+
+    gmu_step("gmu-firmware-to-tcm");
+    /* 7. Load firmware into GMU TCM at +0x3000 */
+    if (!reinterpret_cast<uintptr_t>(native_adreno_firmware_image) ||
+        native_adreno_firmware_image_size < 32768) {
+        IOLog("NativeAdrenoGmu: embedded GMU firmware missing or truncated\n");
+        return kIOReturnNoResources;
+    }
+    const uint32_t *fw_words = reinterpret_cast<const uint32_t *>(native_adreno_firmware_image);
+    const size_t fw_dwords = 32768 / 4;
+    for (size_t i = 0; i < fw_dwords; i++) {
+        io_write32(gmu, 0x3000 + static_cast<uint32_t>(i * 4), fw_words[i]);
+    }
+
+    gmu_step("format-gmu-page-tables");
+    /* 9. Format GMU SMMU page tables at gmu_buf_kva */
+    uint8_t *kva = static_cast<uint8_t *>(gmu_buf_kva);
+    memset(kva, 0, 0xe000);
+    // L1 at 0: entry 1 -> L2 at pa + 0x1000
+    reinterpret_cast<uint64_t *>(kva)[1] = (gmu_buf_pa + 0x1000) | GPU_PTE_TABLE;
+    // L2 at +0x1000: entry 256 -> L3 at pa + 0x2000
+    reinterpret_cast<uint64_t *>(kva + 0x1000)[256] = (gmu_buf_pa + 0x2000) | GPU_PTE_TABLE;
+    // L3 at +0x2000: 13 pages (0x60000000 .. 0x6000d000)
+    for (unsigned i = 0; i < 13; i++) {
+        reinterpret_cast<uint64_t *>(kva + 0x2000)[i] = (gmu_buf_pa + 0x3000 + 0x1000 * i) | GPU_PTE_PAGE;
+    }
+    // HFI queues table at +0xc000 (offset from kva)
+    uint32_t *hfi = reinterpret_cast<uint32_t *>(kva + 0xc000);
+    hfi[0] = 0; hfi[1] = 120; hfi[2] = 6; hfi[3] = 12; hfi[4] = 2; hfi[5] = 2;
+    for (unsigned i = 0; i < 2; i++) {
+        uint32_t *q = hfi + 6 + 12 * i;
+        q[0] = 1;
+        q[1] = 0x6000a000u + 0x1000 * i;
+        q[2] = (10u << 8) | (i ? 4 : 0);
+        q[3] = 1024;
+        q[6] = 1; q[7] = 1; q[8] = 1;
+    }
+    /* The SMMU and the GMU read these pages from DRAM: push the CPU's cached copy to the point of coherency first. */
+    if (NativeAdrenoMaintainOwnedPages(kva, 0xe000, NativeAdrenoClean) != kIOReturnSuccess) {
+        IOLog("NativeAdrenoGmu: cache clean of GMU page tables failed\n");
+        return kIOReturnIOError;
+    }
+    __builtin_arm_dsb(0xf);
+
+    gmu_step("program-smmu-cb3");
+    /* Program SMMU CB3 */
+    const uint32_t n = GPU_SMMU_GMU_CB;
+    const uint32_t cb = GPU_SMMU_CB0 + n * 0x1000u;
+    /* Fault containment as in the verified probe: no global fault interrupts (sCR0 GFIE/GCFGFIE) */
+    const uint32_t scr0 = io_read32(smmu, 0x00);
+    io_write32(smmu, 0x00, scr0 & ~0x24u);
+    io_write32(smmu, GPU_SMMU_CBA2R + 4 * n, 1);
+    io_write32(smmu, GPU_SMMU_CBAR + 4 * n, 1u << 16);
+    gmu_step("smmu-cb-regs");
+    io_write32(smmu, cb + GPU_SMMU_CB_TCR2, 1);
+    io_write32(smmu, cb + GPU_SMMU_CB_TCR, 0x802020u);
+    io_write64(smmu, cb + GPU_SMMU_CB_TTBR0, gmu_buf_pa);
+    io_write32(smmu, cb + GPU_SMMU_CB_MAIR0, 0x44);
+    io_write32(smmu, cb + GPU_SMMU_CB_MAIR1, 0);
+
+    gmu_step("smmu-tlb");
+    /* TLB invalidate & sync */
+    io_write32(smmu, cb + GPU_SMMU_CB_TLB_INVALL, 0);
+    io_write32(smmu, cb + GPU_SMMU_CB_TLB_SYNC, 0);
+    for (unsigned i = 0; i < 500; i++) {
+        if (!(io_read32(smmu, cb + GPU_SMMU_CB_TLB_STATUS) & 1u)) break;
+        IODelay(1);
+    }
+    gmu_step("smmu-enable");
+    io_write32(smmu, cb + GPU_SMMU_CB_SCTLR, 0x27);
+    io_write32(smmu, GPU_SMMU_S2CR + 4 * n, n);
+    io_write32(smmu, GPU_SMMU_SMR + 4 * n, (1u << 31) | GPU_SMMU_GMU_SID);
+
+    gmu_step("mask-irqs");
+    /* 10. Mask interrupt sources */
+    io_write32(gmu, 0x24c18, ~0u);
+    io_write32(gmu, 0x1464c, ~0u);
+
+    gmu_step("gmu-boot-config");
+    /* 11. GMU boot configuration */
+    io_write32(gmu, 0x14070, 0);
+    io_write32(gmu, 0x14004, 0x02);
+    io_write32(gmu, 0x14614, 0x60009000);
+    io_write32(gmu, 0x14610, 1);
+    io_write32(gmu, 0x24c44, 0x802800a0);
+    io_write32(gmu, 0x140b4, 0x4052);
+    io_write32(gmu, 0x14608, 0x06018000);
+    io_write32(gmu, 0x14400, 0x60005003);
+    io_write32(gmu, 0x1303c, 1);
+    io_write32(gmu, 0x13000, 1);
+    io_write32(gmu, 0x13004, 1);
+    io_write32(gmu, 0x14300, 0x09c40400);
+    io_write32(gmu, 0x143a0, io_read32(gmu, 0x143a0) | 0x00000f11);
+    io_write32(gmu, 0x14404, 0);
+
+    gmu_step("release-cm3");
+    /* 12. Release CM3 reset & poll FW_INIT_RESULT */
+    IOLog("NativeAdrenoGmu: releasing CM3 processor from reset\n");
+    io_write32(gmu, 0x14000, 0);
+
+    bool cm3_ready = false;
+    uint32_t init_res = 0;
+    for (unsigned i = 0; i < 1000; i++) {
+        init_res = io_read32(gmu, 0x14070);
+        if (init_res == 0xbabeface || (init_res & 0x1ff) == 0x100) {
+            cm3_ready = true;
+            break;
+        }
+        IODelay(100);
+    }
+    if (!cm3_ready) {
+        IOLog("NativeAdrenoGmu: CM3 FW_INIT_RESULT timed out (0x%08x)\n", init_res);
+        return kIOReturnTimeout;
+    }
+    IOLog("NativeAdrenoGmu: CM3 FW initialized successfully (result 0x%08x)\n", init_res);
+
+    gmu_step("gx-rail-vote");
+    /* 13. GX Rail vote, OOB BOOT_SLUMBER, SPTPRAC, and HFI */
+    io_write32(gmu, 0x8fe0, 0);
+    io_write32(gmu, 0x8fe4, 7); // GX Turbo = 7
+    io_write32(gmu, 0x8fe8, 3); // MX Nominal = 3
+
+    gmu_step("oob-boot-slumber");
+    /* Request OOB BOOT_SLUMBER (bit 22), poll ACK (bit 30) */
+    io_write32(gmu, 0x14650, 1u << 22);
+    bool oob_done = false;
+    for (unsigned i = 0; i < 2000; i++) {
+        if (io_read32(gmu, 0x14648) & (1u << 30)) {
+            oob_done = true;
+            break;
+        }
+        IODelay(100);
+    }
+    io_write32(gmu, 0x14644, 1u << 30); // acknowledge
+    if (!oob_done) {
+        IOLog("NativeAdrenoGmu: OOB BOOT_SLUMBER handshake timed out\n");
+        IOLog("NativeAdrenoGmu: DIAG intr_info=0x%08x intr_mask=0x%08x ao_irq=0x%08x fw_busy=0x%08x init=0x%08x sysreset=0x%08x\n",
+              io_read32(gmu, 0x14648), io_read32(gmu, 0x1464c), io_read32(gmu, 0x24c14),
+              io_read32(gmu, 0x14068), io_read32(gmu, 0x14070), io_read32(gmu, 0x14000));
+        IOLog("NativeAdrenoGmu: DIAG rsc ctrl_req=0x%08x ctrl_ack=0x%08x seq_busy=0x%08x status0=0x%08x sptprac=0x%08x hfi=0x%08x\n",
+              io_read32(gmu, 0x24c1c), io_read32(gmu, 0x24c20), io_read32(gmu, 0x23404),
+              io_read32(gmu, 0x23010), io_read32(gmu, 0x14340), io_read32(gmu, 0x14600));
+        IOLog("NativeAdrenoGmu: DIAG gdscr gx=0x%08x cx=0x%08x rpmh_ctrl=0x%08x vote gx=0x%08x mx=0x%08x\n",
+              io_read32(cc, GPU_GX_GDSCR), io_read32(cc, GPU_CX_GDSCR), io_read32(gmu, 0x143a0),
+              io_read32(gmu, 0x8fe4), io_read32(gmu, 0x8fe8));
+        for (unsigned g = 0; g < 12; g += 4) {
+            IOLog("NativeAdrenoGmu: DIAG general[%u..%u]=%08x %08x %08x %08x\n", g, g + 3,
+                  io_read32(gmu, 0x14714 + 4 * g), io_read32(gmu, 0x14714 + 4 * (g + 1)),
+                  io_read32(gmu, 0x14714 + 4 * (g + 2)), io_read32(gmu, 0x14714 + 4 * (g + 3)));
+        }
+        if (sweet_log_sync) sweet_log_sync();
+        return kIOReturnTimeout;
+    }
+
+    gmu_step("sptprac");
+    /* Enable SPTPRAC shader core cluster power */
+    io_write32(gmu, 0x204, 0x778000);
+    bool sptprac_done = false;
+    for (unsigned i = 0; i < 1000; i++) {
+        if ((io_read32(gmu, 0x14340) & 0x38) == 0x28) {
+            sptprac_done = true;
+            break;
+        }
+        IODelay(10);
+    }
+    if (!sptprac_done) {
+        IOLog("NativeAdrenoGmu: SPTPRAC enable timed out\n");
+        return kIOReturnTimeout;
+    }
+
+    gmu_step("start-hfi");
+    /* Start HFI */
+    io_write32(gmu, 0x14618, 1);
+    bool hfi_done = false;
+    for (unsigned i = 0; i < 1000; i++) {
+        if (io_read32(gmu, 0x14600) & 1u) {
+            hfi_done = true;
+            break;
+        }
+        IODelay(100);
+    }
+    if (!hfi_done) {
+        IOLog("NativeAdrenoGmu: HFI start timed out\n");
+        return kIOReturnTimeout;
+    }
+
+    booted_ = true;
+    IOLog("NativeAdrenoGmu: A618 cold start SUCCESS! GX/SPTPRAC powered, HFI ready\n");
+    return kIOReturnSuccess;
+}
diff --git a/iokit/Kernel/arm/adreno/NativeAdrenoGmuService.h b/iokit/Kernel/arm/adreno/NativeAdrenoGmuService.h
new file mode 100644
index 0000000..7cf65d8
--- /dev/null
+++ b/iokit/Kernel/arm/adreno/NativeAdrenoGmuService.h
@@ -0,0 +1,54 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_GMU_SERVICE_H
+#define NATIVE_ADRENO_GMU_SERVICE_H
+#include <IOKit/IOMemoryDescriptor.h>
+#include <IOKit/IOService.h>
+#include "NativeAdrenoBoard.h"
+
+class NativeAdrenoGmuService : public IOService {
+    OSDeclareDefaultStructors(NativeAdrenoGmuService)
+    OSSharedPtr<IOMemoryMap> maps_[NativeAdrenoMaxWindows];
+    NativeAdrenoWindow windows_[NativeAdrenoMaxWindows]{};
+    size_t count_ = 0;
+    bool booted_ = false;
+
+public:
+    IOService *probe(IOService *provider, SInt32 *score) APPLE_KEXT_OVERRIDE;
+    bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+    void stop(IOService *provider) APPLE_KEXT_OVERRIDE;
+
+    uint64_t windowBase(size_t index) const {
+        return index < count_ ? windows_[index].base : 0;
+    }
+    uint64_t windowBytes(size_t index) const {
+        return index < count_ ? windows_[index].bytes : 0;
+    }
+    size_t windowCount() const { return count_; }
+
+    /* Mapped window address for a caller that already trusts this service. */
+    volatile uint8_t *windowAddress(size_t index) const {
+        return index < count_ && maps_[index] ?
+            reinterpret_cast<volatile uint8_t *>(maps_[index]->getVirtualAddress()) : nullptr;
+    }
+
+    bool isBooted() const { return booted_; }
+
+    /*
+     * A618 Cold-Start Hardware Bring-up:
+     * - GPLL0/GPLL2 vote and GMU RCG 200 MHz clock tree configuration
+     * - RPMh ARC rail voting (CX, MX to LOW_SVS 64)
+     * - CX GDSC power domain uncollapse
+     * - GMU firmware (a630_gmu.bin) loaded into TCM at +0x3000
+     * - 48-entry RSCC / PDC initialization table and stop handshake
+     * - SMMU Context Bank 3 setup for GMU Stream 5 with buffers at 0x60000000
+     * - CM3 reset release and FW_INIT_RESULT polling (0xbabeface)
+     * - GX Turbo=7, MX Nominal=3 rail votes
+     * - OOB BOOT_SLUMBER handshake (bit 22/30)
+     * - SPTPRAC shader core cluster power-up (0x778000 -> status 0x28)
+     * - HFI initialization
+     */
+    IOReturn coldStartA618(volatile uint8_t *gcc, volatile uint8_t *cc, volatile uint8_t *smmu,
+                           uint64_t gmu_buf_pa, void *gmu_buf_kva);
+};
+
+#endif
diff --git a/iokit/Kernel/arm/adreno/NativeAdrenoGpu.cpp b/iokit/Kernel/arm/adreno/NativeAdrenoGpu.cpp
new file mode 100644
index 0000000..ba225cf
--- /dev/null
+++ b/iokit/Kernel/arm/adreno/NativeAdrenoGpu.cpp
@@ -0,0 +1,66 @@
+/* SPDX-License-Identifier: MIT */
+#include "NativeAdrenoGpu.h"
+#include <IOKit/IOLib.h>
+IOReturn NativeAdrenoGpu::fail(IOReturn status)
+{
+    failed_=true;ready_=false;
+    if(reserved_ && !quiesced_) {
+        quiesced_=board_.quiesce(board_.cookie)==kIOReturnSuccess;
+    }
+    return status;
+}
+IOReturn NativeAdrenoGpu::start(const NativeAdrenoGpuBoard *board,
+    const NativeAdrenoGpuConfig *config)
+{
+    if(started_)return kIOReturnBusy;
+    if(!board || !config || !board->reserve || !board->bootGmu ||
+        !board->programSmmu || !board->quiesce)return kIOReturnBadArgument;
+    if(!config->mmio.write32 || !config->mmio.read32 || !config->mmio.barrier ||
+        !config->cache.publish || !config->cache.acquire || !config->ring ||
+        !config->fence || !config->sqe_iova || !config->pwrup_reglist_iova ||
+        !config->clock.now_us || !config->start_timeout_us)
+        return kIOReturnBadArgument;
+    started_=true;board_=*board;
+    IOReturn status=board_.reserve(board_.cookie);
+    if(status) {failed_=true;return status;}
+    reserved_=true;steps_=1;
+    if((status=board_.bootGmu(board_.cookie)))return fail(status);
+    steps_=2;
+    if((status=board_.programSmmu(board_.cookie)))return fail(status);
+    steps_=3;
+    if((status=ring_.attach(&config->mmio,&config->cache,config->ring,config->ring_bytes,
+        config->ring_iova,config->fence,config->fence_bytes,config->fence_iova)))return fail(status);
+    steps_=4;
+    NativeAdrenoCpInitConfig cp{config->sqe_iova,config->pwrup_reglist_iova,0};
+    if((status=cp_.run(&config->mmio,&ring_,&cp,&fence_)))return fail(status);
+    /* A started CP is not ready until its init fence is actually observed. */
+    const NativeAdrenoRingFence started=ring_.wait(fence_,&config->clock,
+        config->start_timeout_us,nullptr);
+    if(started!=NativeAdrenoRingFenceComplete)
+        return fail(started==NativeAdrenoRingFenceTimeout?kIOReturnTimeout:kIOReturnIOError);
+    steps_=5;
+    if((status=irq_.attach(&config->mmio)))return fail(status);
+    if((status=irq_.programMask(nullptr)))return fail(status);
+    steps_=6;
+    if(config->time.read32) {
+        if((status=timer_.attach(&config->time,NativeAdrenoTimeGmu)))return fail(status);
+        timerTimeOk_=true;
+    }
+    ready_=true;
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoGpu::stop()
+{
+    if(!ready_)return kIOReturnNotReady;
+    if(ring_.poisoned() || irq_.poisoned() || cp_.poisoned())return kIOReturnBusy;
+    if(ring_.outstanding())return kIOReturnBusy;
+    IOReturn status=board_.quiesce(board_.cookie);
+    quiesced_=status==kIOReturnSuccess;
+    if(status) {failed_=true;ready_=false;return status;}
+    if(irq_.detach())return fail(kIOReturnIOError);
+    if(timerTimeOk_ && timer_.detach())return fail(kIOReturnIOError);
+    timerTimeOk_=false;
+    if(ring_.detach())return fail(kIOReturnIOError);
+    ready_=false;
+    return kIOReturnSuccess;
+}
diff --git a/iokit/Kernel/arm/adreno/NativeAdrenoGpu.h b/iokit/Kernel/arm/adreno/NativeAdrenoGpu.h
new file mode 100644
index 0000000..62abf77
--- /dev/null
+++ b/iokit/Kernel/arm/adreno/NativeAdrenoGpu.h
@@ -0,0 +1,71 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_GPU_H
+#define NATIVE_ADRENO_GPU_H
+#include "NativeAdrenoCpInit.h"
+#include "NativeAdrenoIrq.h"
+#include "NativeAdrenoTimer.h"
+
+/* One GPU lifecycle attempt: board power/GMU/SMMU actions are injected, while
+ * ring programming, CP start and interrupt masking are the real components in
+ * this repository. The board operations own every resource that must exist
+ * before MMIO is touched; this object never powers, clocks or maps anything.
+ * Order is fixed: reserve, boot GMU, program the GPU SMMU context, attach the
+ * ring, start the CP and program the interrupt mask. A failure after a
+ * successful reserve calls quiesce exactly once, never retries and never
+ * reports readiness; components keep their own quarantine state. On success
+ * the ring, timer and IRQ objects are attached and owned here and may be handed
+ * to user clients. This is not a Metal device and does not prove hardware. */
+struct NativeAdrenoGpuBoard {
+    void *cookie;
+    IOReturn (*reserve)(void *);       /* exclusive device, clocks, mappings */
+    IOReturn (*bootGmu)(void *);       /* GMU firmware/HFI startup */
+    IOReturn (*programSmmu)(void *);   /* streams + native4K context enabled */
+    IOReturn (*quiesce)(void *);       /* stop/fault masters after a failure */
+};
+struct NativeAdrenoGpuConfig {
+    NativeAdrenoRingIo mmio;           /* powered GPU register window */
+    NativeAdrenoRingCache cache;       /* PoC publication for ring/fence */
+    NativeAdrenoTimeIo time;           /* optional GPU counter window */
+    NativeAdrenoRingClock clock;       /* required: bounds the CP start wait */
+    uint32_t start_timeout_us;         /* required: CP start fence timeout */
+    void *ring;
+    size_t ring_bytes;
+    uint64_t ring_iova;
+    void *fence;
+    size_t fence_bytes;
+    uint64_t fence_iova;
+    uint64_t sqe_iova;                 /* verified SQE microcode IOVA */
+    uint64_t pwrup_reglist_iova;
+};
+enum { NativeAdrenoGpuSteps = 6 };
+class NativeAdrenoGpu final {
+    NativeAdrenoGpuBoard board_{};
+    NativeAdrenoRing ring_;
+    NativeAdrenoCpInit cp_;
+    NativeAdrenoIrq irq_;
+    NativeAdrenoTimer timer_;
+    uint32_t steps_=0,fence_=0;
+    bool reserved_=false,ready_=false,failed_=false,quiesced_=false,started_=false;
+    IOReturn fail(IOReturn status);
+public:
+    NativeAdrenoGpu()=default;
+    ~NativeAdrenoGpu()=default;
+    NativeAdrenoGpu(const NativeAdrenoGpu &)=delete;
+    NativeAdrenoGpu &operator=(const NativeAdrenoGpu &)=delete;
+    /* One attempt. Returns the failing step's error; readiness is only true
+     * when every step succeeded. Ring ownership transfers to this object. */
+    IOReturn start(const NativeAdrenoGpuBoard *,const NativeAdrenoGpuConfig *);
+    /* Only a ready GPU may be stopped; requires every submission observed. */
+    IOReturn stop();
+    bool ready() const {return ready_;}
+    bool failed() const {return failed_;}
+    bool quiesced() const {return quiesced_;}
+    uint32_t stepsCompleted() const {return steps_;}
+    uint32_t startFence() const {return fence_;}
+    NativeAdrenoRing *ring() {return ready_?&ring_:nullptr;}
+    NativeAdrenoTimer *timer() {return ready_&&timerTimeOk_?&timer_:nullptr;}
+    NativeAdrenoIrq *interrupts() {return ready_?&irq_:nullptr;}
+private:
+    bool timerTimeOk_=false;
+};
+#endif
diff --git a/iokit/Kernel/arm/adreno/NativeAdrenoGpuContext.cpp b/iokit/Kernel/arm/adreno/NativeAdrenoGpuContext.cpp
new file mode 100644
index 0000000..617afd2
--- /dev/null
+++ b/iokit/Kernel/arm/adreno/NativeAdrenoGpuContext.cpp
@@ -0,0 +1,137 @@
+/* SPDX-License-Identifier: MIT */
+#include "NativeAdrenoGpuContext.h"
+#include "ArmSmmu4KMmio.h"
+#include <IOKit/IOLib.h>
+
+extern "C" volatile uint32_t native_adreno_pool_mib;
+extern "C" volatile uint32_t native_adreno_pool_stats[8],native_adreno_pool_status;
+extern "C" volatile uint32_t native_adreno_wc_enabled,native_adreno_pool_wc;
+extern "C" void sweet_log_sync(void) __attribute__((weak));
+/* Write-ahead marker: the line reaches the persistent log before the call it announces, so a panic inside that call leaves it behind. */
+static void ctx_mark(const char *what,unsigned n=0)
+{
+    IOLog("NativeAdrenoCtx: STEP %s %u\n",what,n);
+    if(sweet_log_sync)sweet_log_sync();
+}
+static const uint64_t kIovas[GpuBufferCount]={GpuSqeIova,GpuRingIova,GpuMemptrsIova,GpuPwrupIova,GpuScratchIova};
+static const size_t kBytes[GpuBufferCount]={GpuSqeBytes,GpuRingBytes,GpuPageBytes,GpuPageBytes,GpuPageBytes};
+IOReturn NativeAdrenoGpuContext::bringUp(const ArmSmmu4KIo *io,unsigned bank,unsigned asid,const unsigned slots[2],
+    const uint16_t sids[2],void (*progress)(uint32_t),NativeAdrenoGmuContextReport *report)
+{
+    if(!report)return kIOReturnBadArgument;
+    *report={};
+    if(used_)return kIOReturnBusy;
+    if(!io || !slots || !sids || bank>63 || !asid || asid>0xffff || slots[0]>127 || slots[1]>127)
+        return kIOReturnBadArgument;
+    used_=true;
+    IOReturn status=kIOReturnSuccess;
+    auto step=[&](Step s) {report->step=s;if(progress)progress(s);};
+    ctx_mark("enter");
+    step(Allocate);
+    ctx_mark("read-id2");
+    static const uint8_t oas_bits[16]={32,36,40,42,44,48};
+    if(io->read32(io->cookie,0x28,&report->id2))status=kIOReturnIOError;
+    else {
+        const unsigned code=(report->id2>>4)&15;
+        report->output_bits=code<6?oas_bits[code]:0;
+        if(report->output_bits>40)report->output_bits=40;
+        if(!report->output_bits)status=kIOReturnUnsupported;
+    }
+    /* The BO pool is taken first, while the VM still has long contiguous runs (the board sets the size from sheng-gpu-pool; 0 = scattered BOs only).
+     * A pool that cannot be had at one size is tried at the next smaller; none is not an error. */
+    ctx_mark("pool",native_adreno_pool_mib);
+    if(!status && native_adreno_pool_mib) {
+        for(uint32_t mib=native_adreno_pool_mib;mib>=16;mib>>=1) {
+            const IOReturn pooled=NativeAdrenoMemory::reservePool(report->output_bits,(size_t)mib<<20);
+            native_adreno_pool_stats[0]=pooled==kIOReturnSuccess?mib:0;native_adreno_pool_status=(uint32_t)pooled;
+            if(pooled==kIOReturnSuccess)break;
+        }
+        /* Not fatal: without it each pooled BO changes its pages' attribute itself, as a scattered one does. */
+        if(native_adreno_wc_enabled && NativeAdrenoMemory::poolBytes())native_adreno_pool_wc=(uint32_t)NativeAdrenoMemory::writeCombinePool()|1u<<31;
+    }
+    ctx_mark("alloc-tables",report->output_bits);
+    if(!status)status=tables_.allocate(TablePages*0x1000,report->output_bits,true,TablePages*0x1000);
+    for(unsigned i=0;!status && i<GpuBufferCount;++i) {
+        ctx_mark("alloc-buffer",i);
+        status=buffers_[i].allocate(kBytes[i],report->output_bits,true,kBytes[i]);
+    }
+    if(!status) {
+        step(Prepare);ctx_mark("prepare");
+        status=smmu_.prepare(&tables_,0,0,GpuApertureBytes,NativeAdrenoSmmuContext::MaxLeaves,
+            bank,asid,1000,report->output_bits);
+        if(!status)smmu_.setAliasScratch(alias_scratch_,sizeof alias_scratch_/sizeof *alias_scratch_);
+    }
+    if(!status) {
+        step(Program);ctx_mark("program");
+        status=smmu_.program(io);
+        const ArmSmmu4KProgramResult *p=smmu_.programResult();
+        report->program_phase=p->phase;report->program_writes=p->writes;
+        report->program_readback_valid=p->readback_valid;report->program_enabled=p->enabled;
+        report->id1=p->id1;report->program_status=smmu_.programStatus();
+        report->image=p->readback;
+    }
+    if(!status) {
+        step(Attach);ctx_mark("attach");
+        const unsigned route_count = (slots[0] != slots[1]) ? 2 : 1;
+        ArmSmmu4KStream routes[2] = {{slots[0], sids[0]}};
+        if (route_count > 1) routes[1] = {slots[1], sids[1]};
+        status = smmu_.attach(routes, route_count);
+        const ArmSmmu4KStreamResult *s=smmu_.streamResult();
+        report->route_status=smmu_.attachStatus();
+        report->route_phase=s->phase;report->route_writes=s->writes;report->routes_verified=s->streams_verified;
+    }
+    if(!status) {
+        step(VmAttach);ctx_mark("vm-attach");
+        NativeAdrenoVmRegion lower={&tables_,smmu_.arenaHandle(),smmu_.stateHandle()};
+        /* 65536 spans: 256 MiB of BOs even when every page is its own span. The Metal runtime pools its memory in 64 MiB blocks,
+         * which XNU rarely finds physically contiguous; one scattered block is 16384 spans (int-070 ran out at 16384). */
+        status=vm_.attach(io,smmu_.configHandle(),smmu_.streamsHandle(),&lower,nullptr,131072,262144);
+    }
+    if(!status) {
+        step(Map);ctx_mark("vm-map-begin");
+        /* adreno_fw_create_bo maps the SQE MSM_BO_GPU_READONLY without NOEXEC; every other kernel BO read/write. */
+        for(unsigned i=0;!status && i<GpuBufferCount;++i) {
+            ctx_mark("vm-map",i);
+            status=vm_.map(&buffers_[i],0,kIovas[i],i?3u:5u,0,2,&handles_[i]);
+        }
+        report->spans=uint32_t(vm_.spanCount());
+    }
+    if(!status) {
+        step(Ready);
+        ready_=true;
+    }
+    report->status=status;
+    return status;
+}
+static NativeAdrenoGpuContext *board_gpu_context;
+extern "C" IOReturn NativeAdrenoGpuContextBringup(volatile uint8_t *smmu,size_t bytes,unsigned bank,unsigned asid,
+    unsigned slot0,unsigned sid0,unsigned slot1,unsigned sid1,void (*progress)(uint32_t),
+    NativeAdrenoGmuContextReport *report)
+{
+    static ArmSmmu4KMmio mmio;
+    static ArmSmmu4KIo io;
+    if(!report || board_gpu_context || !smmu || !bytes || sid0>0xffff || sid1>0xffff)return kIOReturnBadArgument;
+    mmio={reinterpret_cast<volatile unsigned char *>(smmu),bytes};
+    if(ArmSmmu4KBindMmio(&mmio,&io)!=ArmSmmu4KSuccess)return kIOReturnBadArgument;
+    board_gpu_context=new NativeAdrenoGpuContext;
+    if(!board_gpu_context)return kIOReturnNoMemory;
+    const unsigned slots[2]={slot0,slot1};
+    const uint16_t sids[2]={uint16_t(sid0),uint16_t(sid1)};
+    return board_gpu_context->bringUp(&io,bank,asid,slots,sids,progress,report);
+}
+extern "C" IOReturn NativeAdrenoGpuContextBuffers(NativeAdrenoGpuBuffer out[5])
+{
+    if(!out)return kIOReturnBadArgument;
+    for(unsigned i=0;i<GpuBufferCount;++i)out[i]={};
+    if(!board_gpu_context || !board_gpu_context->ready())return kIOReturnNotReady;
+    for(unsigned i=0;i<GpuBufferCount;++i) {
+        const NativeAdrenoMemory &m=board_gpu_context->buffer(i);
+        if(m.spanCount()!=1 || m.spans()[0].bytes!=m.bytes())return kIOReturnUnsupported;
+        out[i]={m.spans()[0].physical,m.bytes(),kIovas[i]};
+    }
+    return kIOReturnSuccess;
+}
+extern "C" NativeAdrenoVm *NativeAdrenoGpuContextVm()
+{
+    return board_gpu_context?board_gpu_context->vm():nullptr;
+}
diff --git a/iokit/Kernel/arm/adreno/NativeAdrenoGpuContext.h b/iokit/Kernel/arm/adreno/NativeAdrenoGpuContext.h
new file mode 100644
index 0000000..dbe915a
--- /dev/null
+++ b/iokit/Kernel/arm/adreno/NativeAdrenoGpuContext.h
@@ -0,0 +1,50 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_GPU_CONTEXT_H
+#define NATIVE_ADRENO_GPU_CONTEXT_H
+#include "NativeAdrenoGmuContext.h"
+
+/* The GPU's own SMMU context, built like the GMU's (NativeAdrenoGmuContext): a native4K lower-region (TTBR0) table
+ * pool for a 0..2 GiB GPU space, one context bank, the GPU's two streams routed to it, then the kernel buffers the
+ * command processor needs at fixed GPU addresses below the A740 GMEM window (UCHE_GMEM_RANGE_MIN 16 MiB):
+ *   sqe      the SQE microcode (a740_sqe.fw without its first dword, as adreno_fw_create_bo copies it), R+X
+ *   ring     ring buffer 0, 32 KiB, aligned to its size, R+W
+ *   memptrs  msm_rbmemptrs layout: +0 rptr, +4 fence, +8 bv_rptr, +12 bv_fence, R+W
+ *   pwrup    the a7xx power-up register list (cpu_gpu_lock header + pairs), R+W
+ *   scratch  one page the first submissions may write, R+W
+ * All mappings are Normal non-cacheable (Linux maps kernel BOs write-combined) and outer shareable; the CPU must use
+ * a matching non-cacheable view. Bank, ASID, SMR slots and stream IDs are caller inputs. Nothing is torn down. */
+enum : uint64_t {
+    GpuSqeIova=0x100000, GpuRingIova=0x200000, GpuMemptrsIova=0x300000, GpuPwrupIova=0x301000,
+    GpuScratchIova=0x302000, GpuApertureBytes=0x80000000
+};
+enum : size_t {GpuSqeBytes=0x13000, GpuRingBytes=0x8000, GpuPageBytes=0x1000, GpuBufferCount=5};
+struct NativeAdrenoGpuBuffer {uint64_t physical,bytes,iova;};
+class NativeAdrenoGpuContext final {
+    NativeAdrenoMemory tables_,buffers_[GpuBufferCount];
+    uint64_t handles_[GpuBufferCount]{};
+    NativeAdrenoSmmuContext smmu_;
+    NativeAdrenoVm vm_;
+    /* The alias checks' sort scratch: one entry per range of the smaller compared side, at most half the aperture's leaves. */
+    uint32_t alias_scratch_[NativeAdrenoSmmuContext::MaxLeaves/2];
+    bool ready_=false,used_=false;
+public:
+    enum Step : uint32_t {Allocate=1,Prepare,Program,Attach,VmAttach,Map,Ready};
+    enum : size_t {TablePages=1027};
+    NativeAdrenoGpuContext()=default;
+    NativeAdrenoGpuContext(const NativeAdrenoGpuContext &)=delete;
+    NativeAdrenoGpuContext &operator=(const NativeAdrenoGpuContext &)=delete;
+    /* The report is the GMU context's: route counts cover both streams. */
+    IOReturn bringUp(const ArmSmmu4KIo *io,unsigned bank,unsigned asid,const unsigned slots[2],
+        const uint16_t sids[2],void (*progress)(uint32_t step),NativeAdrenoGmuContextReport *report);
+    bool ready() const {return ready_;}
+    const NativeAdrenoMemory &buffer(unsigned index) const {return buffers_[index];}
+    NativeAdrenoVm *vm() {return ready_?&vm_:nullptr;}
+};
+extern "C" IOReturn NativeAdrenoGpuContextBringup(volatile uint8_t *smmu,size_t bytes,unsigned bank,unsigned asid,
+    unsigned slot0,unsigned sid0,unsigned slot1,unsigned sid1,void (*progress)(uint32_t),
+    NativeAdrenoGmuContextReport *report);
+/* sqe, ring, memptrs, pwrup, scratch: physical base, size and GPU address, only after Ready. */
+extern "C" IOReturn NativeAdrenoGpuContextBuffers(NativeAdrenoGpuBuffer out[5]);
+/* The live VM of the ready GPU context (null before Ready), for the user-client core. */
+extern "C" NativeAdrenoVm *NativeAdrenoGpuContextVm();
+#endif
diff --git a/iokit/Kernel/arm/adreno/NativeAdrenoIrq.cpp b/iokit/Kernel/arm/adreno/NativeAdrenoIrq.cpp
new file mode 100644
index 0000000..96af912
--- /dev/null
+++ b/iokit/Kernel/arm/adreno/NativeAdrenoIrq.cpp
@@ -0,0 +1,124 @@
+/* SPDX-License-Identifier: MIT */
+#include "NativeAdrenoIrq.h"
+#include <IOKit/IOLib.h>
+
+/* Register offsets and bit positions are the pinned Linux definitions in
+ * registers/adreno/a6xx.xml: RBBM_INT_0_STATUS 0x0201, RBBM_INT_CLEAR_CMD
+ * 0x0037, RBBM_INT_0_MASK 0x0038, CP_INTERRUPT_STATUS 0x0823 and
+ * CP_PROTECT_STATUS 0x0824, plus the A7XX_INT_MASK enable set from
+ * a6xx_gpu.c. No bit is inferred beyond those sources. */
+enum : uint32_t {
+    IrqRbbmStatus = 0x0201,
+    IrqRbbmClear = 0x0037,
+    IrqRbbmMask = 0x0038,
+    IrqCpStatus = 0x0823,
+    IrqCpProtect = 0x0824,
+    IrqBitIdle = 1u << 0,
+    IrqBitAhb = 1u << 1,
+    IrqBitAtbAsync = 1u << 6,
+    IrqBitGpc = 1u << 7,
+    IrqBitCpSw = 1u << 8,
+    IrqBitCpHw = 1u << 9,
+    IrqBitCpCcuDepth = 1u << 10,
+    IrqBitCpCcuColor = 1u << 11,
+    IrqBitCpCcuResolve = 1u << 12,
+    IrqBitCpIb2 = 1u << 13,
+    IrqBitCpIb1 = 1u << 14,
+    IrqBitCpPm4 = 1u << 15,
+    IrqBitCpPm4Lpac = 1u << 16,
+    IrqBitCpRbDone = 1u << 17,
+    IrqBitCpWtDone = 1u << 18,
+    IrqBitCpFence = 1u << 20,
+    IrqBitCpFenceLpac = 1u << 21,
+    IrqBitAtbBus = 1u << 22,
+    IrqBitHang = 1u << 23,
+    IrqBitUcheOob = 1u << 24,
+    IrqBitUcheTrap = 1u << 25,
+    IrqBitTsbWrite = 1u << 28,
+    IrqBitFuse = 1u << 29,
+    IrqBitIsdbCpu = 1u << 30,
+    IrqBitIsdbDebug = 1u << 31
+};
+/* Every A7XX status bit that this decoder knows and may clear. */
+static constexpr uint32_t kKnown = IrqBitIdle | IrqBitAhb | IrqBitAtbAsync | IrqBitGpc |
+    IrqBitCpSw | IrqBitCpHw | IrqBitCpCcuDepth | IrqBitCpCcuColor | IrqBitCpCcuResolve |
+    IrqBitCpIb1 | IrqBitCpIb2 | IrqBitCpPm4 | IrqBitCpPm4Lpac | IrqBitCpRbDone |
+    IrqBitCpWtDone | IrqBitCpFence | IrqBitCpFenceLpac | IrqBitAtbBus | IrqBitHang |
+    IrqBitUcheOob | IrqBitUcheTrap | IrqBitTsbWrite | IrqBitFuse | IrqBitIsdbCpu |
+    IrqBitIsdbDebug;
+/* A7XX_INT_MASK from the pinned a6xx_gpu.c. */
+static constexpr uint32_t kEnable = IrqBitAhb | IrqBitAtbAsync | IrqBitGpc | IrqBitCpSw |
+    IrqBitCpHw | IrqBitCpPm4 | IrqBitCpRbDone | IrqBitCpFence | IrqBitAtbBus |
+    IrqBitHang | IrqBitUcheOob | IrqBitUcheTrap | IrqBitTsbWrite | IrqBitFuse;
+/* CP_INTERRUPT_STATUS error bits, including the A7XX LPAC/BV replicas. */
+static constexpr uint32_t kCpErrors = 0x3fff7u;
+IOReturn NativeAdrenoIrq::poison()
+{
+    poisoned_=true;return kIOReturnIOError;
+}
+uint32_t NativeAdrenoIrq::mask()
+{
+    return kEnable;
+}
+uint32_t NativeAdrenoIrq::cpErrorMask()
+{
+    return kCpErrors;
+}
+IOReturn NativeAdrenoIrq::attach(const NativeAdrenoRingIo *io)
+{
+    if(attached_ || poisoned_)return kIOReturnBusy;
+    if(!io || !io->read32 || !io->write32 || !io->barrier)return kIOReturnBadArgument;
+    io_=*io;attached_=true;enabled_=0;
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoIrq::detach()
+{
+    if(poisoned_ || !attached_)return kIOReturnNotReady;
+    attached_=false;io_={};enabled_=0;return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoIrq::programMask(uint32_t *programmed)
+{
+    if(!attached_ || poisoned_)return kIOReturnNotReady;
+    if(programmed)*programmed=0;
+    uint32_t readback=0;
+    if(io_.write32(io_.cookie,IrqRbbmMask,kEnable))return poison();
+    if(io_.read32(io_.cookie,IrqRbbmMask,&readback))return poison();
+    if(readback!=kEnable)return poison();
+    enabled_=readback;
+    if(programmed)*programmed=readback;
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoIrq::handle(NativeAdrenoIrqResult *result)
+{
+    if(!result)return kIOReturnBadArgument;
+    *result={};
+    if(!attached_ || poisoned_)return kIOReturnNotReady;
+    uint32_t status=0;
+    if(io_.read32(io_.cookie,IrqRbbmStatus,&status))return poison();
+    /* Linux acknowledges the whole read status before decoding it. */
+    if(io_.write32(io_.cookie,IrqRbbmClear,status))return poison();
+    if(io_.barrier(io_.cookie))return poison();
+    uint32_t flags=0,cp_status=0,protect=0;
+    if(status&IrqBitCpFence)flags|=NativeAdrenoIrqFence;
+    if(status&IrqBitCpSw)flags|=NativeAdrenoIrqPreempt;
+    if(status&(IrqBitIdle))flags|=NativeAdrenoIrqIdle;
+    if(status&(IrqBitHang))flags|=NativeAdrenoIrqHang;
+    if(status&(IrqBitUcheOob|IrqBitUcheTrap))flags|=NativeAdrenoIrqUche;
+    if(status&(IrqBitAhb|IrqBitGpc|IrqBitAtbAsync|IrqBitAtbBus))flags|=NativeAdrenoIrqBusError;
+    if(status&(IrqBitTsbWrite|IrqBitFuse))flags|=NativeAdrenoIrqSecurity;
+    if(status&IrqBitCpHw) {
+        if(io_.read32(io_.cookie,IrqCpStatus,&cp_status))return poison();
+        if(cp_status&kCpErrors) {
+            if(io_.read32(io_.cookie,IrqCpProtect,&protect))return poison();
+            flags|=NativeAdrenoIrqCpError;
+        }
+    }
+    const uint32_t unknown=status&~kKnown;
+    if(unknown)flags|=NativeAdrenoIrqUnknown;
+    if(flags&(NativeAdrenoIrqHang|NativeAdrenoIrqCpError|NativeAdrenoIrqUche|
+        NativeAdrenoIrqBusError|NativeAdrenoIrqSecurity|NativeAdrenoIrqUnknown))
+        flags|=NativeAdrenoIrqFatal;
+    result->flags=flags;result->status=status;result->unknown=unknown;
+    result->cp_status=cp_status;result->protect_status=protect;
+    return kIOReturnSuccess;
+}
diff --git a/iokit/Kernel/arm/adreno/NativeAdrenoIrq.h b/iokit/Kernel/arm/adreno/NativeAdrenoIrq.h
new file mode 100644
index 0000000..3640610
--- /dev/null
+++ b/iokit/Kernel/arm/adreno/NativeAdrenoIrq.h
@@ -0,0 +1,52 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_IRQ_H
+#define NATIVE_ADRENO_IRQ_H
+#include "NativeAdrenoRing.h"
+#include <stdint.h>
+
+enum NativeAdrenoIrqFlag {
+    NativeAdrenoIrqFence = 1u << 0,     /* CP_CACHE_FLUSH_TS: retire candidates */
+    NativeAdrenoIrqHang = 1u << 1,      /* RBBM_HANG_DETECT */
+    NativeAdrenoIrqCpError = 1u << 2,   /* CP_HW_ERROR with a nonzero CP status */
+    NativeAdrenoIrqUche = 1u << 3,      /* UCHE out-of-bounds or trap */
+    NativeAdrenoIrqBusError = 1u << 4,  /* AHB/GPC/ATB overflow or async FIFO */
+    NativeAdrenoIrqPreempt = 1u << 5,   /* CP_SW */
+    NativeAdrenoIrqIdle = 1u << 6,      /* RBBM_GPU_IDLE */
+    NativeAdrenoIrqSecurity = 1u << 7,  /* SW fuse violation / TSB write error */
+    NativeAdrenoIrqUnknown = 1u << 8,   /* status outside the decoded mask */
+    NativeAdrenoIrqFatal = 1u << 9      /* any class that cannot be ignored */
+};
+struct NativeAdrenoIrqResult {
+    uint32_t flags, status, unknown, cp_status, protect_status;
+};
+/* A7XX RBBM/CP interrupt decode and acknowledgement, not an XNU interrupt
+ * source. IO read/write take dword register indices. The hardware interrupt
+ * must already be masked at the controller by the caller, and the caller must
+ * serialize handle() against every other MMIO user. Mask programming happens
+ * only in programMask(); handle() never changes the enabled set. A clear we
+ * cannot complete leaves the source armed, so it poisons the decoder and
+ * requires an independent reset rather than retrying with a changed mask. */
+class NativeAdrenoIrq final {
+    NativeAdrenoRingIo io_{};
+    uint32_t enabled_=0;
+    bool attached_=false,poisoned_=false;
+    IOReturn poison();
+public:
+    NativeAdrenoIrq()=default;
+    ~NativeAdrenoIrq()=default;
+    NativeAdrenoIrq(const NativeAdrenoIrq &)=delete;
+    NativeAdrenoIrq &operator=(const NativeAdrenoIrq &)=delete;
+    IOReturn attach(const NativeAdrenoRingIo *);
+    IOReturn detach();
+    /* The exact A7XX enable set: AHB, ATB async, GPC, CP_SW, CP_HW, PM4,
+     * RB_DONE_TS, CACHE_FLUSH_TS, ATB bus, hang, UCHE OOB/trap, TSB, fuse. */
+    IOReturn programMask(uint32_t *programmed);
+    /* Reads, acknowledges, then decodes. Acknowledgement precedes decoding so
+     * an error reported here cannot be hidden by a later clear failure. */
+    IOReturn handle(NativeAdrenoIrqResult *);
+    static uint32_t mask();
+    static uint32_t cpErrorMask();
+    bool poisoned() const {return poisoned_;}
+    uint32_t enabled() const {return enabled_;}
+};
+#endif
diff --git a/iokit/Kernel/arm/adreno/NativeAdrenoKernelTime.cpp b/iokit/Kernel/arm/adreno/NativeAdrenoKernelTime.cpp
new file mode 100644
index 0000000..4a8d695
--- /dev/null
+++ b/iokit/Kernel/arm/adreno/NativeAdrenoKernelTime.cpp
@@ -0,0 +1,18 @@
+/* SPDX-License-Identifier: MIT */
+#include "NativeAdrenoKernelTime.h"
+#include <IOKit/IOLib.h>
+#include <kern/clock.h>
+int NativeAdrenoKernelTime::now_us(void *cookie,uint64_t *value)
+{
+    if(cookie || !value)return 1;
+    uint64_t nanoseconds=0;
+    absolutetime_to_nanoseconds(mach_absolute_time(),&nanoseconds);
+    *value=nanoseconds/1000;
+    return 0;
+}
+int NativeAdrenoKernelTime::wait_us(void *cookie,unsigned microseconds)
+{
+    if(cookie)return 1;
+    IODelay(microseconds);
+    return 0;
+}
diff --git a/iokit/Kernel/arm/adreno/NativeAdrenoKernelTime.h b/iokit/Kernel/arm/adreno/NativeAdrenoKernelTime.h
new file mode 100644
index 0000000..af024fa
--- /dev/null
