  * reaches lines another task's mapping left (an imported IOSurface). Apple's sys_dcache_flush is only a DSB, so user space cannot. */
 IOReturn NativeAdrenoMaintainPhysicalPages(uint64_t physical,size_t bytes,NativeAdrenoCacheOperation);
+/* Diagnostic (0109): counts the non-zero 32-bit words at every `stride` bytes (a multiple of 4) of [physical, physical+bytes) read through the physical
+ * aperture; *sampled is the number of words read. Pages outside the kernel's DRAM are skipped. */
+uint32_t NativeAdrenoSampleNonzeroWords(uint64_t physical,size_t bytes,size_t stride,uint32_t *sampled);
