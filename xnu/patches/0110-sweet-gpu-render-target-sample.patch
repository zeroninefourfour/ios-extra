     noteMaintenance(began,bytes);
     return kIOReturnSuccess;
 }
+uint32_t NativeAdrenoSampleNonzeroWords(uint64_t physical,size_t bytes,size_t stride,uint32_t *sampled)
+{
+    uint32_t nonzero=0,count=0;
+    if(stride && !(stride&3))for(size_t offset=0;offset+4<=bytes;offset+=stride) {
+        const uint64_t address=physical+offset;
+        if(address<gPhysBase || address-gPhysBase>=gPhysSize)continue;   /* phystokv panics outside the kernel's DRAM */
+        const vm_offset_t alias=phystokv(address);
+        if(!alias)continue;
+        ++count;nonzero+=*reinterpret_cast<const volatile uint32_t *>(alias)!=0;
+    }
+    if(sampled)*sampled=count;
+    return nonzero;
+}
 /* A user BO's pages become Normal non-cacheable (write-combined) for every CPU mapping the pmap tracks: the kernel's own mapping and each
  * client view. The views did not get the cache mode their mapping asked for (int-070: Turnip's write-combine view left IB words in a CPU
  * cache line), but they do take the page's own attribute. That is the Linux msm model for its WC BOs: CPU writes reach DRAM, the GPU's
