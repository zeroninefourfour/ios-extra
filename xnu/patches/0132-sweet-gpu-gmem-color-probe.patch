+extern "C" IOReturn NativeAdrenoGpuScratchMaintain(int acquire)
+{
+    if(!board_gpu_context || !board_gpu_context->ready())return kIOReturnNotReady;
+    NativeAdrenoMemory &m=const_cast<NativeAdrenoMemory &>(board_gpu_context->buffer(4));
+    return acquire?m.acquireDeviceWrites(0,GpuPageBytes):m.publishForDevice(0,GpuPageBytes,true);
+}
