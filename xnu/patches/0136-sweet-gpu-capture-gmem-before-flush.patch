+unsigned NativeAdrenoVm::captureGmem(uint64_t iova,size_t bytes,uint64_t destIova)
+{
+    if(!attached_ || poisoned_ || !destIova || !bytes || (bytes&3) || (iova&3))return 0;
+    for(size_t i=0;i<NativeAdrenoVmMaxObjects;++i) {
+        const Mapping &m=mappings_[i];
+        if(!m.memory || !m.memory->mapping() || iova<m.iova || iova-m.iova>=m.memory->bytes())continue;
+        const size_t offset=(size_t)(iova-m.iova);
+        if(offset+bytes>m.memory->bytes())return 0;
+        volatile uint32_t *w=static_cast<volatile uint32_t *>(m.memory->mapping())+offset/4;
+        const size_t n=bytes/4;
+        bool blit=false;
+        for(size_t k=0;k+1<n;++k)if(w[k]==0x702c0001u && w[k+1]==3u)blit=true;
+        if(!blit)return 0;
+        const size_t spare=m.memory->bytes()-(offset+bytes);
+        unsigned chunks=(unsigned)(spare/24u);
+        if(chunks>128u)chunks=128u;
+        if(!chunks)return 0;
+        volatile uint32_t *out=w+n;
+        for(unsigned c=0;c<chunks;++c) {
+            const uint64_t src=UINT64_C(0x100000)+(uint64_t)c*0x1000u;
+            const uint64_t dst=destIova+UINT64_C(0x100000)+(uint64_t)c*0x1000u;
+            uint32_t header=0;
+            if(AdrenoPM4Type7(0x75,5,&header)!=AdrenoPM4Success)return c;
+            out[0]=header;out[1]=1024;out[2]=(uint32_t)src;out[3]=(uint32_t)(src>>32);out[4]=(uint32_t)dst;out[5]=(uint32_t)(dst>>32);
+            out+=6;
+        }
+        return chunks;
+    }
+    return 0;
+}
+void NativeAdrenoVm::countCaptured(uint64_t iova,size_t bytes,uint32_t *sevens,uint32_t *zeros,uint32_t *other,uint32_t *sample)
+{
+    if(sevens)*sevens=0;if(zeros)*zeros=0;if(other)*other=0;if(sample)*sample=0;
+    if(!attached_ || poisoned_ || !sevens || !zeros || !other || !sample || !bytes || (iova&3))return;
+    for(size_t i=0;i<NativeAdrenoVmMaxObjects;++i) {
+        const Mapping &m=mappings_[i];
+        if(!m.memory || iova<m.iova || iova-m.iova>=m.memory->bytes())continue;
+        size_t offset=(size_t)(iova-m.iova);
+        size_t end=offset+bytes;
+        if(end>m.memory->bytes())end=m.memory->bytes();
+        (void)m.memory->acquireDeviceWrites(offset,end-offset);
+        for(size_t o=offset;o+4<=end;o+=4) {
+            const NativeAdrenoPhysicalSpan *span=nullptr;
+            for(size_t j=0;j<m.memory->spanCount();++j) {
+                const NativeAdrenoPhysicalSpan &s=m.memory->spans()[j];
+                if(o>=s.offset && o-s.offset+4<=s.bytes){span=&s;break;}
+            }
+            uint32_t v=0;
+            if(!span || !NativeAdrenoReadPhysicalWord(span->physical+(o-span->offset),&v))continue;
