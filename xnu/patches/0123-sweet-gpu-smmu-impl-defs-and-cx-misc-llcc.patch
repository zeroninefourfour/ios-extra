+    gpu_read32(&gpu_window, A618_GBIF_SCACHE_CNTL1, &new_sc1);
+    IOLog("NativeAdreno: GBIF_SCACHE_CNTL0: 0x%x -> 0x%x, CNTL1: 0x%x -> 0x%x\n",
+        (unsigned)old_sc0, (unsigned)new_sc0, (unsigned)old_sc1, (unsigned)new_sc1);
+
