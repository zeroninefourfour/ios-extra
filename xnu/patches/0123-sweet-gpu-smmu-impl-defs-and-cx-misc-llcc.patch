+        uint32_t old_cx1 = cx_regs[2];
+        cx_regs[1] = 0x3;
+        cx_regs[2] = 0x0;
+        __asm__ volatile("dsb sy" ::: "memory");
+        uint32_t new_cx0 = cx_regs[1];
+        uint32_t new_cx1 = cx_regs[2];
+        IOLog("NativeAdreno: CX_MISC SYSTEM_CACHE_CNTL_0: 0x%x -> 0x%x (readback 0x%x), CNTL_1: 0x%x -> 0x%x (readback 0x%x)\n",
+            (unsigned)old_cx0, 0x3, (unsigned)new_cx0, (unsigned)old_cx1, 0, (unsigned)new_cx1);
